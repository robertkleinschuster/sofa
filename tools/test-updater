#!/bin/bash
# test-updater -- end-to-end test of the updater without a public release.
#
# A local HTTP server plays "GitHub": release.json with a fictitious next version
# (dist/Sofa.app with a bumped version number as a signed DMG). An invisible dev instance
# (SOFA_UPDATE_API points to the server) is driven through the settings like a user would:
#   Einstellungen -> Nach Updates suchen -> "Update installieren X → X+0.0.1" -> release notes
#   -> Jetzt installieren -> download, checksum, DMG, bundle check, handover (<App>.staged).
# The swap itself is otherwise done by the helper (tested by every sofa-deploy).
# On a failure the screenshots of the steps stay in the printed folder.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
. "$SRC/tools/lib/dev-instance.sh"
DEV="$SRC/build/SofaDev.app"
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-updtest.XXXXXX")"
PORT=47986 INST=updtest   # release server port (47995 is test-downloads' app)
export SOFA_DATA_DIR="$T/data"   # fresh instance state per run
# the instance keeps its log and dev FIFO in its data directory (SFDevPrivateDir): gone with $T
mkdir -p "$SOFA_DATA_DIR"; FIFO="$SOFA_DATA_DIR/dev.fifo" LOG="$SOFA_DATA_DIR/sofa.log"
export SOFA_ONLY_APPS=example    # no Mediathek requests: the update path is all this tests
CUR=$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$SRC/res/Info.plist")
NEW=$(echo "$CUR" | awk -F. '{print $1"."$2"."$3+1}')   # fictitious next version
fail=0; ok() { echo "  ok    $*"; }; bad() { echo "  FAIL  $*"; fail=1; }
[ -d "$SRC/dist/Sofa.app" ] || { echo "run tools/make-release first"; exit 1; }
make -C "$SRC" >/dev/null || exit 1

echo "==> fictitious release $NEW in $T"
mkdir -p "$T/stage" "$T/www"
ditto "$SRC/dist/Sofa.app" "$T/stage/Sofa.app"
/usr/libexec/PlistBuddy -c "Set CFBundleShortVersionString $NEW" "$T/stage/Sofa.app/Contents/Info.plist"
hdiutil create -quiet -volname "Sofa $NEW" -srcfolder "$T/stage" -size $(( $(du -sm "$T/stage" | cut -f1) * 11 / 10 + 40 ))m -format UDZO "$T/www/Sofa-$NEW.dmg"
# TAMPER=1: signature from a foreign key -> the updater must reject the release
if [ "${TAMPER:-0}" = 1 ]; then
  /opt/local/bin/openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 -out "$T/foreign.pem" 2>/dev/null
  SIGKEY="$T/foreign.pem"
else SIGKEY="$HOME/.config/sofa/release-signing-key.pem"; fi
/opt/local/bin/openssl dgst -sha256 -sign "$SIGKEY" -out "$T/www/Sofa-$NEW.dmg.sig" "$T/www/Sofa-$NEW.dmg"; rm -f "$T/foreign.pem"
cat > "$T/www/release.json" <<EOF
{"tag_name": "v$NEW", "body": "- **Testeintrag:** neue Funktion A\n- Fehler B behoben\n\n<!-- sofa-notes-end -->\n**Installation:** nicht anzeigen",
 "assets": [{"name": "Sofa-$NEW.dmg", "browser_download_url": "http://127.0.0.1:$PORT/Sofa-$NEW.dmg"},
            {"name": "Sofa-$NEW.dmg.sig", "browser_download_url": "http://127.0.0.1:$PORT/Sofa-$NEW.dmg.sig"}]}
EOF
/opt/local/bin/python3.14 -m http.server --bind 127.0.0.1 --directory "$T/www" $PORT >/dev/null 2>&1 &
SRV=$!
rm -rf "$DEV.update" "$DEV.update.tmp" "$DEV.staged"
{ defaults delete de.sofa.dev.$INST; rm -f "$HOME/Library/Preferences/de.sofa.dev.$INST.plist"; } >/dev/null 2>&1   # this instance's settings only
: > "$LOG"
SOFA_UPDATE_API="http://127.0.0.1:$PORT/release.json" "$DEV/Contents/MacOS/Sofa" --dev --instance $INST --port 47996 >/dev/null 2>&1 &
APP=$!
keep=0
# settings deleted after the app is gone (its last write would bring them back)
trap 'kill $APP $SRV 2>/dev/null; wait $APP 2>/dev/null; { defaults delete de.sofa.dev.$INST; rm -f "$HOME/Library/Preferences/de.sofa.dev.$INST.plist"; } >/dev/null 2>&1
      rm -rf "$DEV.update" "$DEV.update.tmp" "$DEV.staged"; [ $keep = 1 ] || rm -rf "$T"' EXIT
for i in $(seq 1 60); do grep -q 'fifo ready' "$LOG" 2>/dev/null && break; sleep 0.5; done
cmd() { echo "$*" 1<>"$FIFO"; }
mark() { log_mark "$LOG"; }
waitlog() { for i in $(seq 1 ${3:-40}); do log_since "$1" "$LOG" | grep -q "$2" && return 0; sleep 0.25; done; return 1; }
shot() { local m; m=$(mark); cmd shot "$T/$1.png"; waitlog $m "dev: shot written" 40; }   # waits until written

cmd open settings; sleep 0.5; shot 1-settings
for k in 1 2 3 4 5; do cmd key down; done; sleep 0.5
m=$(mark); cmd key select   # "Nach Updates suchen" (6th row)
waitlog $m 'update-check: ' 60; shot 2-found
grep -q "Update verfügbar: $CUR → $NEW" "$LOG" 2>/dev/null; :   # (the message is a toast, not in the log)
cmd key select; sleep 1.5; shot 3-release-notes                         # "Update installieren"
cmd key select                                                          # "Jetzt installieren"
for i in $(seq 1 120); do [ -d "$DEV.staged" ] && break; grep -q 'signature of .* invalid' "$LOG" 2>/dev/null && break; sleep 1; done
shot 4-installed

echo "==> result"
grep -q "Update installieren" <(strings "$SRC/build/SofaDev.app/Contents/MacOS/Sofa") && :
[ -s "$T/2-found.png" ] && ok "search + version comparison (screenshot 2)" || bad "no screenshot after the search"
if [ "${TAMPER:-0}" = 1 ]; then
  [ ! -d "$DEV.staged" ] && ok "foreign-signed update rejected" || bad "foreign-signed update was installed!"
  grep -q 'signature of .* invalid' "$LOG" && ok "log: signature invalid" || bad "no signature message in the log"
elif [ -d "$DEV.staged" ]; then
  V=$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$DEV.staged/Contents/Info.plist")
  [ "$V" = "$NEW" ] && ok "download, checksum, DMG, check, handover: <App>.staged is $V" || bad "staged has version $V"
  [ -d "$DEV.staged/Contents/Runtime/bin" ] && ok "runtime fully taken over" || bad "runtime missing"
else
  bad "no <App>.staged after 120 s"; grep 'update' "$LOG" | tail -5
fi
grep -E 'update: ' "$LOG" | sed 's/^/        /'
[ $fail = 0 ] && echo "==> all ok" || { keep=1; echo "Screenshots: $T"; echo "==> FAILED"; }
exit $fail

#!/bin/bash
# test-home -- the mixed Home rows (SFHomeFeatures), in an invisible dev instance with only the
# Example app registered (SOFA_ONLY_APPS: no network request at all).
#
# Incident 2026-11-05: "Jetzt live" offered ZDF (Germany only) and ORF 1 (DRM) on a device in
# Austria - selecting them only showed "Wiedergabe nicht möglich". Home must offer only what plays
# here. The Example app features three channels: a normal one, a DRM one, one limited to region XX.
#   1. DRM never appears; the region item appears while the region is unknown; badges are kept;
#      news newest first
#   2. a geo finding "outside XX" removes the region item at once (Home reloads), "inside" brings it back
#   3. after a restart the stored rows come back before any refresh (offline), with badges and the
#      channel's programme, and the stored region finding still filters
#   4. a followed show whose stored picture is a deleted local file (artwork of a cleaned-up download
#      folder, incident 2026-11-06: channel avatars missing) shows its newest episode's picture and
#      is marked for a new one
#   5. a follow due while its source pauses background requests (incident 2026-11-06: during a
#      YouTube bot-check pause every follow was "checked" in turn without a request, then waited
#      its full interval) waits for the end of the pause, then is checked; the list stored without
#      view counts gets them stored on that check (2026-11-06: counts parsed from the list text were
#      never stored - only news counts as a change - so Home highlights were empty after a restart)
#   6. Home is asked while the screen is awake only (incident 2026-11-06: 50-95 requests/h to the
#      Mediathek APIs around the clock): asleep nothing, waking up asks once
# Exit code 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$SRC/build/SofaDev.app/Contents/MacOS/Sofa"
INST=hometest PORT=47993
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-hometest.XXXXXX")"
export SOFA_DATA_DIR="$T/data"   # fresh state per run: no region findings or rows from earlier runs
# the instance keeps its log and dev FIFO in its data directory (SFDevPrivateDir): gone with $T
mkdir -p "$SOFA_DATA_DIR"; FIFO="$SOFA_DATA_DIR/dev.fifo" LOG="$SOFA_DATA_DIR/sofa.log"
fail=0; ok() { echo "  ok    $*"; }; bad() { echo "  FAIL  $*"; fail=1; }

make -C "$SRC" >/dev/null || exit 1
APP=
start() {   # start [env ...]
  : > "$LOG"
  env SOFA_ONLY_APPS=example "$@" "$BIN" --dev --instance $INST --port $PORT >/dev/null 2>&1 & APP=$!
  for i in $(seq 1 100); do grep -q 'fifo ready' "$LOG" 2>/dev/null && return; sleep 0.1; done
  echo "dev instance did not start"; exit 1
}
quit() { echo quit 1<>"$FIFO" 2>/dev/null; for i in $(seq 1 50); do kill -0 $APP 2>/dev/null || break; sleep 0.1; done; APP=; }
cmd() { echo "$*" 1<>"$FIFO"; }
waitlog() {   # waitlog PATTERN: until the pattern appears in the log (5 s)
  for i in $(seq 1 50); do grep -q "$1" "$LOG" && return 0; sleep 0.1; done; return 1
}
rows() {   # rows TOPIC: the ids/badges of the row as Home shows it now
  local n; n=$(grep -c "dev: homerows $1 =" "$LOG")
  cmd homerows
  for i in $(seq 1 50); do [ "$(grep -c "dev: homerows $1 =" "$LOG")" -gt "$n" ] && break; sleep 0.1; done
  grep "dev: homerows $1 =" "$LOG" | tail -1 | sed 's/.*= //'
}
has() { case " $1 " in *" $2 "*) return 0 ;; esac; return 1; }
cleanup() {
  [ -n "$APP" ] && quit
  defaults delete de.sofa.dev.$INST >/dev/null 2>&1   # this instance's settings: fresh per run
  rm -rf "$T"
}
trap cleanup EXIT

echo "==> 1. what plays here, region unknown"
start
sleep 1   # the launch refresh: the Example app answers at once (rows only logged when they change)
L=$(rows live); H=$(rows highlights)
has "$L" "example:live1/LIVE/Testsendung" && ok "normal channel shown, with its LIVE badge and what runs now" || bad "normal channel missing: $L"
case "$L" in *example:live2*) bad "DRM channel shown: $L" ;; *) ok "DRM channel left out" ;; esac
has "$L" "example:live3/LIVE/Testsendung" && ok "region channel shown while the region is unknown" || bad "region channel missing: $L"
has "$H" "example:1/-/-" && has "$H" "example:2/-/-" && ok "highlights shown" || bad "highlights: $H"
N=$(rows news)
case "$N" in "example:4/-/- example:3/-/-"*) ok "news newest first" ;; *) bad "news order: $N" ;; esac

echo "==> 2. geo findings"
cmd "region XX 0"; waitlog "geo: device outside XX" || bad "outside not logged"
L=$(rows live)
case "$L" in *example:live3*) bad "region channel still shown outside XX: $L" ;; *) ok "outside XX: region channel left out" ;; esac
has "$L" "example:live1/LIVE/Testsendung" && ok "normal channel stays" || bad "normal channel gone: $L"
cmd "region XX 1"; waitlog "geo: device inside XX" || bad "inside not logged"
L=$(rows live)
has "$L" "example:live3/LIVE/Testsendung" && ok "inside XX: region channel back" || bad "region channel not back: $L"

echo "==> 3. restart: stored rows, offline"
cmd "region XX 0"; waitlog "geo: device outside XX"
sleep 0.5; quit
start SOFA_OFFLINE=1
L=$(rows live); H=$(rows highlights)
has "$L" "example:live1/LIVE/Testsendung" && ok "stored live row back at once, badge and programme kept" || bad "stored live row: $L"
case "$L" in *example:live2*|*example:live3*) bad "stored row offers what can't play: $L" ;; *) ok "stored row still filtered (drm, region outside)" ;; esac
has "$H" "example:1/-/-" && ok "stored highlights back" || bad "stored highlights: $H"
grep -q "home features: live" "$LOG" && bad "refreshed although offline" || ok "no refresh offline"

echo "==> 4. follow picture gone"
quit
/opt/local/bin/sqlite3 "$SOFA_DATA_DIR/sofa.db" "INSERT INTO follows (id, source, title, image, added) VALUES ('exampleshow:demo', 'example', 'Beispielsendung', '$T/gone/poster.jpg', 0);
  INSERT INTO follow_items (follow, id, pos, item) VALUES ('exampleshow:demo', 'example:1', 0, '{\"id\":\"example:1\",\"kind\":0,\"title\":\"Eins\",\"image\":\"https://example.invalid/1.jpg\"}')"
start SOFA_OFFLINE=1
cmd follows; waitlog "dev: follows end"
F=$(grep "dev: follows exampleshow:demo" "$LOG" | tail -1)
case "$F" in *"image=https://example.invalid/1.jpg "*) ok "tile shows the newest episode's picture" ;; *) bad "tile picture: $F" ;; esac
case "$F" in *"needs=1") ok "marked for a new picture" ;; *) bad "not marked: $F" ;; esac

echo "==> 5. follow due during its source's pause"
quit
/opt/local/bin/sqlite3 "$SOFA_DATA_DIR/sofa.db" "UPDATE follows SET checked=NULL WHERE id='exampleshow:demo'"
start SOFA_EXAMPLE_PAUSE=3 SOFA_FOLLOW_GAP=0.5
waitlog "follows: Beispielsendung waits" && ok "waits for the pause" || bad "did not wait: $(grep -E 'follows:|example: feed' "$LOG" | tail -2)"
grep -q "example: feed" "$LOG" && bad "feed asked during the pause" || ok "nothing asked during the pause"
[ -z "$(/opt/local/bin/sqlite3 "$SOFA_DATA_DIR/sofa.db" "SELECT checked FROM follows WHERE id='exampleshow:demo'")" ] && ok "turn not used up" || bad "marked checked during the pause"
for i in $(seq 1 60); do grep -q "example: feed exampleshow:demo" "$LOG" && break; sleep 0.1; done
grep -q "example: feed exampleshow:demo" "$LOG" && ok "checked after the pause" || bad "not checked after the pause"
# the same list stored without counts (as before the source had them): only the counts are new
quit
DB="$SOFA_DATA_DIR/sofa.db"
/opt/local/bin/sqlite3 "$DB" "UPDATE follow_items SET item=json_remove(item,'$.views') WHERE follow='exampleshow:demo'; UPDATE follows SET checked=NULL WHERE id='exampleshow:demo'"
start SOFA_FOLLOW_GAP=0.5
for i in $(seq 1 60); do grep -q "example: feed exampleshow:demo" "$LOG" && break; sleep 0.1; done; sleep 0.5
/opt/local/bin/sqlite3 "$DB" "SELECT item FROM follow_items WHERE follow='exampleshow:demo'" | grep -q '"views"' && ok "view counts stored once known" || bad "view counts not stored"
grep -q "follows: Beispielsendung has news" "$LOG" && bad "counts alone announced as news" || ok "counts alone are no news"

echo "==> 6. Home refresh only while the screen is awake"
quit
start SOFA_OFFLINE= SOFA_HOME_REFRESH=1
asks() { grep -c "example: home features asked" "$LOG"; }
sleep 2.5; a=$(asks); [ "$a" -ge 2 ] && ok "awake: refreshed periodically ($a)" || bad "awake: $a asks"
cmd "screens sleep"; waitlog "screen asleep"; sleep 0.3; a=$(asks); sleep 2.5
[ "$(asks)" = "$a" ] && ok "asleep: nothing asked" || bad "asleep: $(( $(asks) - a )) asks"
cmd "screens wake"; sleep 0.5
[ "$(asks)" -gt "$a" ] && ok "waking up asks at once" || bad "no ask after waking up"

[ $fail = 0 ] && echo "==> test-home ok" || echo "==> test-home FAILED"
exit $fail

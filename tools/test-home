#!/bin/bash
# test-home -- the mixed Home rows (SFHomeFeatures), in an invisible dev instance with only the
# Example app registered (SOFA_ONLY_APPS: no network request at all).
#
# Incident 2026-11-05: "Jetzt live" offered ZDF (Germany only) and ORF 1 (DRM) on a device in
# Austria - selecting them only showed "Wiedergabe nicht möglich". Home must offer only what plays
# here. The Example app features three channels: a normal one, a DRM one, one limited to region XX.
#   1. DRM never appears; the region item appears while the region is unknown; badges are kept;
#      news newest first
#   2. a geo finding "outside XX" removes the region item at once (Home reloads), "inside" brings it back
#   3. after a restart the stored rows come back before any refresh (offline), with badges and the
#      channel's programme, and the stored region finding still filters
#   4. a followed show whose stored picture is a deleted local file (artwork of a cleaned-up download
#      folder, incident 2026-11-06: channel avatars missing) shows its newest episode's picture and
#      is marked for a new one
#   5. a follow due while its source pauses background requests (incident 2026-11-06: during a
#      YouTube bot-check pause every follow was "checked" in turn without a request, then waited
#      its full interval) waits for the end of the pause, then is checked; the list stored without
#      view counts gets them stored on that check (2026-11-06: counts parsed from the list text were
#      never stored - only news counts as a change - so Home highlights were empty after a restart)
#   6. Home is asked while the screen is awake only (incident 2026-11-06: 50-95 requests/h to the
#      Mediathek APIs around the clock): asleep nothing, waking up asks once
#   7. a row with more to load (SFShelf moreLoader: YouTube channel videos, playlists, streams)
#      appends its next portion once the focus is six tiles from its end - focus stays on its tile,
#      nothing is asked before that or after the last portion
#   8. the quick menu (SFQuickMenu, user 2026-11-08): MENU on Home and MENU held anywhere open it
#      (once), on a page it starts with "Zum Startbildschirm", which goes home
# Exit code 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
. "$SRC/tools/lib/dev-instance.sh"
BIN="$SRC/build/SofaDev.app/Contents/MacOS/Sofa"
INST=hometest
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-hometest.XXXXXX")"
trap 'rm -rf "${T:?}"' EXIT   # until the full cleanup below takes over (a failed build exits before it)
export SOFA_DATA_DIR="$T/data"   # fresh state per run: no region findings or rows from earlier runs
# the instance keeps its log and dev FIFO in its data directory (SFDevPrivateDir): gone with $T
mkdir -p "$SOFA_DATA_DIR"; FIFO="$SOFA_DATA_DIR/dev.fifo" LOG="$SOFA_DATA_DIR/sofa.log"
fail=0; ok() { echo "  ok    $*"; }; bad() { echo "  FAIL  $*"; fail=1; }
check() { [ "$2" = "$3" ] && ok "$1" || bad "$1: got '$2', want '$3'"; }   # check NAME GOT WANT

make -C "$SRC" >/dev/null || exit 1
APP=
start() {   # start [env ...]
  : > "$LOG"
  env SOFA_ONLY_APPS=example "$@" "$BIN" --dev --instance $INST >/dev/null 2>&1 & APP=$!
  dev_wait_ready $APP "$LOG"
}
quit() { echo quit 1<>"$FIFO" 2>/dev/null; dev_wait_exit $APP; APP=; }
cmd() { echo "$*" 1<>"$FIFO"; }
waitlog() {   # waitlog PATTERN: until the pattern appears in the log (5 s)
  for i in $(seq 1 50); do grep -q "$1" "$LOG" && return 0; sleep 0.1; done; return 1
}
rows() {   # rows TOPIC: the ids/badges of the row as Home shows it now
  local n; n=$(grep -c "dev: homerows $1 =" "$LOG")
  cmd homerows
  for i in $(seq 1 50); do [ "$(grep -c "dev: homerows $1 =" "$LOG")" -gt "$n" ] && break; sleep 0.1; done
  grep "dev: homerows $1 =" "$LOG" | tail -1 | sed 's/.*= //'
}
has() { case " $1 " in *" $2 "*) return 0 ;; esac; return 1; }
cleanup() {
  [ -n "$APP" ] && quit
  { defaults delete de.sofa.dev.$INST; rm -f "$HOME/Library/Preferences/de.sofa.dev.$INST.plist"; } >/dev/null 2>&1   # this instance's settings: fresh per run
  rm -rf "$T"
}
trap cleanup EXIT

echo "==> 1. what plays here, region unknown"
start
sleep 1   # the launch refresh: the Example app answers at once (rows only logged when they change)
L=$(rows live); H=$(rows highlights)
has "$L" "example:live1/LIVE/Testsendung" && ok "normal channel shown, with its LIVE badge and what runs now" || bad "normal channel missing: $L"
case "$L" in *example:live2*) bad "DRM channel shown: $L" ;; *) ok "DRM channel left out" ;; esac
has "$L" "example:live3/LIVE/Testsendung" && ok "region channel shown while the region is unknown" || bad "region channel missing: $L"
has "$H" "example:1/-/-" && has "$H" "example:2/-/-" && ok "highlights shown" || bad "highlights: $H"
N=$(rows news)
case "$N" in "example:4/-/- example:3/-/-"*) ok "news newest first" ;; *) bad "news order: $N" ;; esac

echo "==> 2. geo findings"
m=$(log_mark "$LOG")
cmd "region XX 0"; waitlog "geo: device outside XX" || bad "outside not logged"
L=$(rows live)
case "$L" in *example:live3*) bad "region channel still shown outside XX: $L" ;; *) ok "outside XX: region channel left out" ;; esac
has "$L" "example:live1/LIVE/Testsendung" && ok "normal channel stays" || bad "normal channel gone: $L"
# the reload rebuilds only the changed row: the others keep their layers and tiles (a page torn
# down at every update blinked - the player's info panel, user 2026-11-07)
rb=; for i in $(seq 1 20); do rb=$(log_since $m "$LOG" | grep -m1 'rows: rebuilt'); [ -n "$rb" ] && break; sleep 0.25; done
kept=$(echo "$rb" | sed -n 's/.* \([0-9]*\) kept, \([0-9]*\) new.*/\1 \2/p')
[ -n "$kept" ] && [ "${kept% *}" -ge 1 ] && [ "${kept#* }" -ge 1 ] && ok "only the changed row rebuilt (${kept% *} kept, ${kept#* } new)" || bad "rebuild kept nothing: ${rb:-no rebuild line}"
cmd "region XX 1"; waitlog "geo: device inside XX" || bad "inside not logged"
L=$(rows live)
has "$L" "example:live3/LIVE/Testsendung" && ok "inside XX: region channel back" || bad "region channel not back: $L"

echo "==> 3. restart: stored rows, offline"
cmd "region XX 0"; waitlog "geo: device outside XX"
sleep 0.5; quit
start SOFA_OFFLINE=1
L=$(rows live); H=$(rows highlights)
has "$L" "example:live1/LIVE/Testsendung" && ok "stored live row back at once, badge and programme kept" || bad "stored live row: $L"
case "$L" in *example:live2*|*example:live3*) bad "stored row offers what can't play: $L" ;; *) ok "stored row still filtered (drm, region outside)" ;; esac
has "$H" "example:1/-/-" && ok "stored highlights back" || bad "stored highlights: $H"
grep -q "home features: live" "$LOG" && bad "refreshed although offline" || ok "no refresh offline"

echo "==> 4. follow picture gone"
quit
/opt/local/bin/sqlite3 "$SOFA_DATA_DIR/sofa.db" "INSERT INTO follows (id, source, title, image, added) VALUES ('exampleshow:demo', 'example', 'Beispielsendung', '$T/gone/poster.jpg', 0);
  INSERT INTO items (id, json) VALUES ('example:1', '{\"id\":\"example:1\",\"kind\":0,\"title\":\"Eins\",\"image\":\"https://example.invalid/1.jpg\"}');
  INSERT INTO follow_items (follow, id, pos) VALUES ('exampleshow:demo', 'example:1', 0)"
start SOFA_OFFLINE=1
cmd follows; waitlog "dev: follows end"
F=$(grep "dev: follows exampleshow:demo" "$LOG" | tail -1)
case "$F" in *"image=https://example.invalid/1.jpg "*) ok "tile shows the newest episode's picture" ;; *) bad "tile picture: $F" ;; esac
case "$F" in *"needs=1") ok "marked for a new picture" ;; *) bad "not marked: $F" ;; esac

echo "==> 5. follow due during its source's pause"
quit
/opt/local/bin/sqlite3 "$SOFA_DATA_DIR/sofa.db" "UPDATE follows SET checked=NULL WHERE id='exampleshow:demo'"
start SOFA_EXAMPLE_PAUSE=3 SOFA_FOLLOW_GAP=0.5
waitlog "follows: Beispielsendung waits" && ok "waits for the pause" || bad "did not wait: $(grep -E 'follows:|example: feed' "$LOG" | tail -2)"
grep -q "example: feed" "$LOG" && bad "feed asked during the pause" || ok "nothing asked during the pause"
[ -z "$(/opt/local/bin/sqlite3 "$SOFA_DATA_DIR/sofa.db" "SELECT checked FROM follows WHERE id='exampleshow:demo'")" ] && ok "turn not used up" || bad "marked checked during the pause"
for i in $(seq 1 60); do grep -q "example: feed exampleshow:demo" "$LOG" && break; sleep 0.1; done
grep -q "example: feed exampleshow:demo" "$LOG" && ok "checked after the pause" || bad "not checked after the pause"
# the same list stored without counts (as before the source had them): only the counts are new
quit
DB="$SOFA_DATA_DIR/sofa.db"
/opt/local/bin/sqlite3 "$DB" "UPDATE items SET json=json_remove(json,'$.views') WHERE id IN (SELECT id FROM follow_items WHERE follow='exampleshow:demo'); UPDATE follows SET checked=NULL WHERE id='exampleshow:demo'"
start SOFA_FOLLOW_GAP=0.5
for i in $(seq 1 60); do grep -q "example: feed exampleshow:demo" "$LOG" && break; sleep 0.1; done; sleep 0.5
/opt/local/bin/sqlite3 "$DB" "SELECT i.json FROM follow_items f JOIN items i ON i.id = f.id WHERE f.follow='exampleshow:demo'" | grep -q '"views"' && ok "view counts stored once known" || bad "view counts not stored"
grep -q "follows: Beispielsendung has news" "$LOG" && bad "counts alone announced as news" || ok "counts alone are no news"
# the stored items know more than the list (a field the list does not give) and one has an
# outdated title: the title is written, the extra field stays, neither is news
quit
/opt/local/bin/sqlite3 "$DB" "UPDATE items SET json=json_set(json,'$.geo','AT') WHERE id IN (SELECT id FROM follow_items WHERE follow='exampleshow:demo');
  UPDATE items SET json=json_set(json,'$.title','Alter Titel') WHERE id IN (SELECT id FROM follow_items WHERE follow='exampleshow:demo' AND pos=0);
  UPDATE follows SET checked=NULL WHERE id='exampleshow:demo'"
start SOFA_FOLLOW_GAP=0.5
for i in $(seq 1 60); do grep -q "follows: Beispielsendung updated" "$LOG" && break; sleep 0.1; done
grep -q "follows: Beispielsendung updated" "$LOG" && ok "renamed episode written" || bad "rename not written: $(grep 'follows:' "$LOG" | tail -2)"
grep -q "follows: Beispielsendung has news" "$LOG" && bad "a rename or a stored description announced as news" || ok "no news"
# the store commits off the main thread after the log line: poll (bounded) instead of a fixed sleep
renamed() { /opt/local/bin/sqlite3 "$DB" "SELECT json_extract(i.json,'$.geo') || '|' || (json_extract(i.json,'$.title') != 'Alter Titel') FROM follow_items f JOIN items i ON i.id = f.id WHERE f.follow='exampleshow:demo' AND f.pos=0"; }
for i in $(seq 1 50); do [ "$(renamed)" = "AT|1" ] && break; sleep 0.1; done
check "description kept, title from the list" "$(renamed)" "AT|1"
# stored before tiles had avatars (2026-11-09): the list's channel picture is visible - written
# (a refresh wrote only what one sees, and the avatar was not part of it)
quit
/opt/local/bin/sqlite3 "$DB" "UPDATE items SET json=json_remove(json,'$.channelImage') WHERE id IN (SELECT id FROM follow_items WHERE follow='exampleshow:demo'); UPDATE follows SET checked=NULL WHERE id='exampleshow:demo'"
start SOFA_FOLLOW_GAP=0.5
for i in $(seq 1 60); do grep -q "follows: Beispielsendung updated" "$LOG" && break; sleep 0.1; done
grep -q "follows: Beispielsendung updated (channelImage)" "$LOG" && ok "a channel picture the stored list lacks is written" || bad "not written: $(grep 'follows:' "$LOG" | tail -2)"

echo "==> 6. Home refresh only while the screen is awake"
quit
start SOFA_OFFLINE= SOFA_HOME_REFRESH=1
asks() { grep -c "example: home features asked" "$LOG"; }
sleep 2.5; a=$(asks); [ "$a" -ge 2 ] && ok "awake: refreshed periodically ($a)" || bad "awake: $a asks"
cmd "screens sleep"; waitlog "screen asleep"; sleep 0.3; a=$(asks); sleep 2.5
[ "$(asks)" = "$a" ] && ok "asleep: nothing asked" || bad "asleep: $(( $(asks) - a )) asks"
cmd "screens wake"; sleep 0.5
[ "$(asks)" -gt "$a" ] && ok "waking up asks at once" || bad "no ask after waking up"

echo "==> 7. a row loads more as the focus nears its end"
quit
start SOFA_OFFLINE=1 SOFA_EXAMPLE_MORE=2
focus() { local n; n=$(grep -c "dev: focus " "$LOG"); cmd focus; for i in $(seq 1 50); do [ "$(grep -c "dev: focus " "$LOG")" -gt "$n" ] && break; sleep 0.1; done; grep "dev: focus " "$LOG" | tail -1 | sed 's/.*dev: focus //'; }
keys() { local k=$1 n=$2; for i in $(seq 1 "$n"); do cmd "key $k"; sleep 0.15; done; }
more() { grep -c "rows: Mehr Beispiele +" "$LOG"; }
cmd "open app:example"; sleep 1
for i in 1 2 3 4 5 6; do [ "$(focus)" = example:more0 ] && break; keys down 1; done   # down to the row (search tile, shows above)
check "on the row" "$(focus)" "example:more0"
keys right 1; sleep 0.5; check "not yet near the end: nothing loaded" "$(more)" 0
keys right 1; waitlog "rows: Mehr Beispiele +8$" && ok "six tiles before the end: the next 8 appended" || bad "no portion: $(grep 'rows:' "$LOG" | tail -2 | tr '\n' '|')"
check "focus stays on its tile" "$(focus)" "example:more2"
reb=$(awk '/rows: Mehr Beispiele \+8$/ {f=1; next} f && /rows: rebuilt/ {print; exit}' "$LOG")   # the append's own page rebuild
# rows on screen keep their layers (rows scrolled out above had none and may be built anew)
kept=$(echo "$reb" | sed -n 's/.* - \([0-9]*\) kept.*/\1/p')
[ "${kept:-0}" -ge 1 ] && ok "not rebuilt from scratch ($kept rows kept)" || bad "rebuild after the append: '$reb'"
keys right 8; waitlog "rows: Mehr Beispiele +8 (complete)" && ok "the last portion, marked complete" || bad "no second portion"
check "focus moved on through the appended tiles" "$(focus)" "example:more10"
keys right 14; sleep 0.5
check "complete: nothing asked any more" "$(more)" 2
check "the row's end is its last tile" "$(focus)" "example:more23"

echo "==> 8. the quick menu: MENU on Home, MENU held anywhere; sound and Bluetooth (fake radio)"
quit
start SOFA_OFFLINE=1 SOFA_FAKE_BLUETOOTH=1
menus() { grep -c "menu: quick menu - " "$LOG"; }
cmd "key menu"; waitlog "menu: quick menu - " && check "MENU on Home: the menu, no 'Zum Startbildschirm' there" "$(grep 'menu: quick menu - ' "$LOG" | tail -1 | sed 's/.*quick menu - //')" "Ausschalten, Ton, Energie, Einstellungen" || bad "MENU on Home opened no menu"
cmd "key menu"; sleep 0.5   # closes it
cmd "key menu"; waitlog "menu: quick menu - " >/dev/null; sleep 0.4; cmd "key select"   # the first entry
waitlog "power: (dev) display off simulated" && ok "the first entry, Ausschalten: the display off (what switching off means today)" || bad "no display off from the quick menu"
cmd "open app:example"; sleep 1; n=$(menus)
cmd "key menuhold"; for i in $(seq 1 30); do [ "$(menus)" -gt "$n" ] && break; sleep 0.1; done
check "MENU held on a page: the menu, starting with the way home" "$(grep 'menu: quick menu - ' "$LOG" | tail -1 | sed 's/.*quick menu - //')" "Ausschalten, Zum Startbildschirm, Ton, Energie, Einstellungen"
cmd "key menuhold"; sleep 0.5; check "MENU held again: no second menu" "$(menus)" "$((n + 1))"
sleep 0.4; cmd "key down"; cmd "key select"; sleep 0.8; m=$(menus)   # "Zum Startbildschirm" (below "Ausschalten")
cmd "key menu"; for i in $(seq 1 30); do [ "$(menus)" -gt "$m" ] && break; sleep 0.1; done
check "'Zum Startbildschirm' went home (MENU there opens the Home menu)" "$(grep 'menu: quick menu - ' "$LOG" | tail -1 | sed 's/.*quick menu - //')" "Ausschalten, Ton, Energie, Einstellungen"
# Ton: the Mac's outputs, then the paired Bluetooth speaker (off: "Verbinden"), then pairing
sounds() { grep -c "menu: sound - " "$LOG"; }
s0=$(sounds); sleep 0.4; cmd "key down"; cmd "key select"; for i in $(seq 1 30); do [ "$(sounds)" -gt "$s0" ] && break; sleep 0.1; done   # (the Home menu is open: Ton, below "Ausschalten")
snd=$(grep 'menu: sound - ' "$LOG" | tail -1 | sed 's/.*sound - //')
case "$snd" in *", Testlautsprecher, Kopfhörer koppeln") ok "Ton: outputs, the paired speaker, pairing ($snd)";; *) bad "Ton menu: '$snd'";; esac
rows=$(echo "$snd" | awk -F', ' '{print NF}')
# (OK right after a screen closed is dropped on purpose - SFNavigator settle, 0.3 s: wait it out)
sleep 0.4; for i in $(seq 2 "$rows"); do cmd "key down"; done; cmd "key select"   # "Kopfhörer koppeln" (the last row)
waitlog "bluetooth: search over" && ok "the search ran" || bad "no search: $(grep 'bluetooth:' "$LOG" | tail -2 | tr '\n' '|')"
grep -q "bluetooth: found Testkopfhörer (new)" "$LOG" && ok "it found the headphones (name resolved later)" || bad "headphones not found"
sleep 0.4; cmd "key down"; cmd "key select"   # below the search's row: the headphones
waitlog "bluetooth: pair Testkopfhörer -> ok" && ok "choosing them pairs and connects" || bad "no pairing: $(grep 'bluetooth:' "$LOG" | tail -2 | tr '\n' '|')"
s0=$(sounds); cmd "key menu"; sleep 0.5; cmd "key down"; cmd "key select"; for i in $(seq 1 30); do [ "$(sounds)" -gt "$s0" ] && break; sleep 0.1; done
snd=$(grep 'menu: sound - ' "$LOG" | tail -1 | sed 's/.*sound - //')
case "$snd" in *", Testkopfhörer trennen, Testlautsprecher, Kopfhörer koppeln") ok "now paired and connected: 'trennen'";; *) bad "Ton menu after pairing: '$snd'";; esac

[ $fail = 0 ] && echo "==> test-home ok" || echo "==> test-home FAILED"
exit $fail

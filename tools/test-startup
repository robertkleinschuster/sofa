#!/bin/bash
# test-startup -- how Sofa starts, with invisible dev instances on a temporary data directory.
#   1. one instance per data directory (incident 2026-11-07: after a reboot macOS reopened Sofa next
#      to the one the autostart agent started; both used the database and the YouTube engine's
#      profile): a second start on the same data directory quits before touching anything, says
#      so in the log; once the first instance has ended, the next start runs.
#   2. the hitch monitor (home micro-stutter, user 2026-11-07): a main-thread stall is logged with
#      its length and the Sofa function it was spent in, sampled from the stalled thread's stack.
# Exit code 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
. "$SRC/tools/lib/dev-instance.sh"
BIN="$SRC/build/SofaDev.app/Contents/MacOS/Sofa"
INST=starttest PORT=47970   # + 47971 for the second start
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-starttest.XXXXXX")"
export SOFA_DATA_DIR="$T/data" SOFA_ONLY_APPS=example
mkdir -p "$SOFA_DATA_DIR"; FIFO="$SOFA_DATA_DIR/dev.fifo" LOG="$SOFA_DATA_DIR/sofa.log"
fail=0; ok() { echo "  ok    $*"; }; bad() { echo "  FAIL  $*"; fail=1; }

make -C "$SRC" >/dev/null || exit 1
APP=
cleanup() {
  [ -n "$APP" ] && kill $APP 2>/dev/null
  { defaults delete de.sofa.dev.$INST; rm -f "$HOME/Library/Preferences/de.sofa.dev.$INST.plist"; } >/dev/null 2>&1
  rm -rf "$T"
}
trap cleanup EXIT
start() { : > "$LOG"; "$BIN" --dev --instance $INST --port $PORT >/dev/null 2>&1 & APP=$!; dev_wait_ready $APP "$LOG"; }
quit() { echo quit 1<>"$FIFO" 2>/dev/null; for i in $(seq 1 50); do kill -0 $APP 2>/dev/null || break; sleep 0.1; done; APP=; }

echo "==> 1. one instance per data directory"
start
# the second start: same data directory, another remote port; a short lock wait (an update's
# handover gets 10 s)
SOFA_INSTANCE_LOCK_WAIT=0.5 "$BIN" --dev --instance $INST --port $((PORT + 1)) >/dev/null 2>&1 & SECOND=$!
for i in $(seq 1 50); do kill -0 $SECOND 2>/dev/null || break; sleep 0.1; done
if kill -0 $SECOND 2>/dev/null; then bad "a second instance on the same data directory keeps running"; kill $SECOND 2>/dev/null
else wait $SECOND; rc=$?; [ $rc = 0 ] && ok "the second start quits (exit 0: launchd does not relaunch it)" || bad "the second start exited $rc"; fi
grep -q 'another Sofa runs on this data directory' "$LOG" && ok "it says so in the log" || bad "no log line for the refused start"
kill -0 $APP 2>/dev/null && ok "the first instance keeps running" || bad "the first instance ended"
quit
start   # the lock went with the first instance
[ -n "$APP" ] && kill -0 $APP 2>/dev/null && ok "after the first has ended, the next start runs" || bad "the next start did not run"

echo "==> 2. hitch monitor"
# the stall's own line (startup stalls log too); at most one hitch line per second: a startup stall
# just logged swallows the next one - try again
line=; for try in 1 2 3; do
  n=$(wc -l < "$LOG"); echo 'stall 300' 1<>"$FIFO"
  for i in $(seq 1 15); do line=$(tail -n +$((n + 1)) "$LOG" | grep -m1 'hitch: main thread blocked.*devStall'); [ -n "$line" ] && break 2; sleep 0.1; done
done
ms=$(echo "$line" | sed -n 's/.*blocked \([0-9]*\) ms.*/\1/p')
[ -n "$ms" ] && [ "$ms" -ge 250 ] && [ "$ms" -le 600 ] && ok "a 300-ms stall is logged ($ms ms)" || bad "stall not logged as such: ${line:-no line}"
# the stall is spent in devStall: it leads the list and holds most samples (NSDate's commpage
# code keeps no standard frame - the walk must get past it)
hits=$(echo "$line" | sed -n 's/.* in -\[SFAppDelegate(Dev) devStall:\] \([0-9]*\)x.* of \([0-9]*\) samples.*/\1 \2/p')
[ -n "$hits" ] && [ $(( ${hits% *} * 10 )) -ge $(( ${hits#* } * 8 )) ] && ok "it names the function it was spent in (${hits% *} of ${hits#* } samples)" || bad "no stack attribution: $line"
kill -0 $APP 2>/dev/null && ok "sampling the main thread leaves Sofa running" || bad "Sofa ended while sampled"
quit

[ $fail = 0 ] && echo "==> test-startup ok" || echo "==> test-startup FAILED"
exit $fail

#!/bin/bash
# test-resolver [unittest arguments] -- offline tests of the selection logic in res/ytresolver.py
# (original vs. dubbed audio track, DASH choice, dlaudio, subtitles) against fixtures in tests/.
# No network, no yt-dlp, touches nothing outside the repo. Exit code != 0 on failure.
#   tools/test-resolver                      all tests
#   tools/test-resolver Subtitles -v         a single class, verbose
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
PY="${PYTHON:-/opt/local/bin/python3.14}"
cd "$SRC/tests" && exec "$PY" -I -B test_ytresolver.py "$@"

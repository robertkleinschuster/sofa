#!/bin/bash
# test-api -- the web API's contract (api/openapi.yaml, docs/api.md) against a running dev instance:
# every operation called as a client calls it - and the wrong ways that have a documented answer - and
# every request and answer checked against the contract (statuses, content types, headers, bodies; the
# answers' objects closed: the server says nothing the contract doesn't name), the error codes of the
# contract against the server's (src/Library/SFWebErrors.m), every operation exercised. Then a restart on
# the same data: the pairing and the picture URLs stay (the signing key is a 0600 file), paused streams
# outlive unused ones and end after their own time. The first answer of each operation and status is
# written, scrubbed (stable across runs and machines), to api/examples/.
# The checker is strict TypeScript without dependencies (tools/lib/api: a YAML-subset reader, a JSON
# Schema 2020-12 validator that refuses keywords it doesn't implement, the OpenAPI matcher) - checked
# by tsc first (the YouTube engine's dev install: tools/fetch-sofa-yt --dev), then its self-test.
# Only the Example app, local media, a throwaway certificate on loopback. No network. Exit 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
NODE="${SOFA_NODE:-/opt/local/bin/node}"
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-apitest.XXXXXX")"
INST=apitest
cleanup() {
  { defaults delete de.sofa.dev.$INST; rm -f "$HOME/Library/Preferences/de.sofa.dev.$INST.plist"; } >/dev/null 2>&1
  [ -n "${SRV:-}" ] && { kill "$SRV" 2>/dev/null; wait "$SRV" 2>/dev/null; }
  rm -rf "$T"
}
trap cleanup EXIT
make -C "$SRC" >/dev/null || exit 1

# the checker's type check (strict; the engine's dev install brings tsc and node's types)
LOCK=$(shasum -a 256 "$SRC/res/sofa-yt/package-lock.json" | cut -d' ' -f1)
DEV="$SRC/build/vendor/sofa-yt-dev"
if [ ! -f "$DEV/STAMP" ] || [ "$(cat "$DEV/STAMP")" != "$LOCK" ]; then "$SRC/tools/fetch-sofa-yt" --dev >/dev/null || exit 1; fi
"$NODE" "$DEV/node_modules/typescript/bin/tsc" -p "$SRC/tools/lib/api/tsconfig.json" >"$T/tsc.log" 2>&1 \
  && echo "  ok    the checker's strict type check" || { echo "  FAIL  the checker's type check"; sed 's/^/        /' "$T/tsc.log"; exit 1; }

# fixtures: a certificate for the example name, the media (an H.264 + AAC DASH pair, a VP9 + Opus WebM
# pair, a 60-s MP4 file for downloads and the TV), a picture; a Range-capable local source
NAME=sofa.tailnet.example
/opt/local/bin/openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout "$T/k.pem" -out "$T/c.pem" \
  -days 2 -subj "/CN=$NAME" -addext "subjectAltName=DNS:$NAME" 2>/dev/null || { echo "openssl failed"; exit 1; }
mkdir -p "$T/media" "$T/data"
cp "$SRC/tests/fixtures/web/video.mp4" "$SRC/tests/fixtures/web/audio.mp4" "$T/media/"
FF=/opt/local/bin/ffmpeg
$FF -v error -y -f lavfi -i testsrc2=size=320x180:rate=25 -t 20 -c:v libvpx-vp9 -b:v 150k -g 25 -deadline realtime -cpu-used 8 "$T/media/v.webm" \
  && $FF -v error -y -f lavfi -i sine=f=440:d=20 -c:a libopus -b:a 32k "$T/media/a.webm" \
  && $FF -v error -y -f lavfi -i testsrc2=size=96x54:rate=25 -f lavfi -i sine=d=60 -t 60 -c:v libx264 -pix_fmt yuv420p -c:a aac -b:a 32k \
       -movflags +faststart "$T/media/file.mp4" \
  && $FF -v error -y -f lavfi -i testsrc2=size=320x180 -frames:v 1 "$T/media/picture.png" || { echo "ffmpeg failed"; exit 1; }
cat > "$T/srv.py" <<'PY'
import http.server, sys, os
ROOT = sys.argv[1]
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        try: self.serve()
        except (BrokenPipeError, ConnectionResetError): pass
    def serve(self):
        F = os.path.join(ROOT, self.path.lstrip("/"))
        if not os.path.isfile(F): self.send_response(404); self.end_headers(); return
        size = os.path.getsize(F); start, end = 0, size
        r = self.headers.get("Range", "")
        if r.startswith("bytes=") and "," not in r:
            a, _, z = r[6:].partition("-"); start = int(a or 0); end = min(size, int(z) + 1) if z else size
            if start >= size: self.send_response(416); self.send_header("Content-Range", "bytes */%d" % size); self.end_headers(); return
            self.send_response(206); self.send_header("Content-Range", "bytes %d-%d/%d" % (start, end - 1, size))
        else: self.send_response(200)
        self.send_header("Content-Length", str(end - start)); self.send_header("Content-Type", "video/mp4"); self.end_headers()
        with open(F, "rb") as f: f.seek(start); self.wfile.write(f.read(end - start))
s = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H)
with open(sys.argv[2] + ".tmp", "w") as f: f.write(str(s.server_address[1]))
os.rename(sys.argv[2] + ".tmp", sys.argv[2])
s.serve_forever()
PY
/opt/local/bin/python3.14 -I "$T/srv.py" "$T/media" "$T/media.port" & SRV=$!
for i in $(seq 1 150); do [ -s "$T/media.port" ] && break; sleep 0.1; done
MP=$(cat "$T/media.port")
PORT=$(/opt/local/bin/python3.14 -I -c 'import socket; s=socket.socket(socket.AF_INET6); s.bind(("::",0)); print(s.getsockname()[1])')

env SOFA_SRC="$SRC" SOFA_DATA="$T/data" SOFA_TMP="$T" SOFA_NAME=$NAME SOFA_PORT=$PORT SOFA_INSTANCE=$INST SOFA_CERT="$T/c.pem" SOFA_KEY="$T/k.pem" \
    MEDIA_DASH_V="http://127.0.0.1:$MP/video.mp4" MEDIA_DASH_A="http://127.0.0.1:$MP/audio.mp4" \
    MEDIA_VP9_V="http://127.0.0.1:$MP/v.webm" MEDIA_VP9_A="http://127.0.0.1:$MP/a.webm" \
    MEDIA_FILE="http://127.0.0.1:$MP/file.mp4" MEDIA_IMAGE="$T/media/picture.png" SOFA_AUDIO_OUT=null \
    "$NODE" "$SRC/tools/lib/api/test-api.ts"
fail=$?
[ $fail = 0 ] && echo "==> test-api ok" || { echo "==> test-api FAILED"; tail -25 "$T/data/sofa.log" | sed 's/^/    /'; }
exit $fail

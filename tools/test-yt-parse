#!/bin/bash
# test-yt-parse -- the YouTube parser against recorded InnerTube answers, offline.
# tests/fixtures/youtube/<name>.json.gz are real answers (from the dev instances' caches, cookies
# stripped); <name>.txt is what the parser made of them when they were recorded: one line per
# item, keys sorted, dates as age in hours. A parser change that changes the output fails here -
# intended changes are recorded again with --record (and the diff reviewed).
#   tools/test-yt-parse [--record]
# Exit code 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$SRC/build/SofaDev.app/Contents/MacOS/Sofa"
FIX="$SRC/tests/fixtures/youtube"
INST=ytparse PORT=47994
FIFO="$HOME/Library/Caches/Sofa/dev-$INST.fifo" LOG="$HOME/Library/Logs/Sofa-dev-$INST.log"
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-ytparse.XXXXXX")"
export SOFA_DATA_DIR="$T/data" SOFA_OFFLINE=1 SOFA_ONLY_APPS=youtube
record=0; [ "${1:-}" = "--record" ] && record=1
fail=0; ok() { echo "  ok    $*"; }; bad() { echo "  FAIL  $*"; fail=1; }

# fixture -> what is parsed from it
kind() { case "$1" in channel-header) echo header ;; uploads) echo feed ;; *) echo list ;; esac; }

make -C "$SRC" >/dev/null || exit 1
APP=
trap '[ -n "$APP" ] && kill $APP 2>/dev/null; defaults delete de.sofa.dev.$INST >/dev/null 2>&1; rm -rf "$T"' EXIT
: > "$LOG"
"$BIN" --dev --instance $INST --port $PORT >/dev/null 2>&1 & APP=$!
for i in $(seq 1 100); do grep -q 'fifo ready' "$LOG" 2>/dev/null && break; sleep 0.1; done
grep -q 'fifo ready' "$LOG" || { echo "dev instance did not start"; exit 1; }

for gz in "$FIX"/*.json.gz; do
  n=$(basename "$gz" .json.gz)
  gunzip -c "$gz" > "$T/$n.json"
  echo "ytparse $(kind $n) $T/$n.json $T/$n.txt" > "$FIFO"
  for i in $(seq 1 100); do grep -q "dev: ytparse written $T/$n.txt" "$LOG" && break; sleep 0.1; done
  [ -s "$T/$n.txt" ] || { bad "$n: no output"; continue; }
  if [ $record = 1 ]; then cp "$T/$n.txt" "$FIX/$n.txt"; ok "$n recorded ($(grep -c '^item' "$T/$n.txt") items)"
  elif diff -u "$FIX/$n.txt" "$T/$n.txt" > "$T/$n.diff"; then ok "$n ($(grep -c '^item' "$T/$n.txt") items)"
  else bad "$n differs:"; head -20 "$T/$n.diff" | sed 's/^/        /'; fi
done
echo quit > "$FIFO"; for i in $(seq 1 50); do kill -0 $APP 2>/dev/null || break; sleep 0.1; done; APP=

[ $fail = 0 ] && echo "==> test-yt-parse ok" || echo "==> test-yt-parse FAILED"
exit $fail

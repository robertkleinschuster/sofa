#!/bin/bash
# Neues Sofa ausrollen, ohne den Nutzer zu stören. Der laufende SofaRemote-Helper übernimmt
# innerhalb von ~3 s: Sofa sichert Zustand (Bereich + laufendes Video + Position), Tausch,
# Neustart, Wiedergabe läuft an derselben Stelle weiter. Rollback: <App>.prev.
#
# Ziel = das Sofa.app, aus dem der laufende Helper stammt (sonst MacPorts-, sonst /Applications-Kopie).
#  - App-Ordner beschreibbar (/Applications): Bundle als <App>.staged daneben, der Helper tauscht.
#  - nicht beschreibbar (MacPorts-Port: /Applications/MacPorts gehört root): Bundle nach
#    ~/Library/Application Support/Sofa/update/Sofa.app, der Helper beendet Sofa und meldet
#    „ready“, dieses Skript tauscht per sudo. sudo nicht-interaktiv: SUDO_PW setzen.
# Auf einer Port-Installation ist das ein Entwicklungsstand; `port -n upgrade --force sofa`
# stellt den Port-Stand wieder her.
set -eu
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
LOG="$HOME/Library/Logs/SofaRemote.log"

APP="$(ps -axo command | sed -n 's|^\(/.*/Sofa\.app\)/Contents/MacOS/SofaRemote.*|\1|p' | head -1)"
if [ -z "$APP" ]; then
  if [ -d /Applications/MacPorts/Sofa.app ]; then APP=/Applications/MacPorts/Sofa.app; else APP=/Applications/Sofa.app; fi
  echo "WARNUNG: kein SofaRemote läuft – Ziel $APP, Übernahme erst beim nächsten Helper-Start"
fi

as_root() {
  if [ -n "${SUDO_PW:-}" ]; then echo "$SUDO_PW" | sudo -S -k -p '' "$@"; else sudo "$@"; fi
}

make -C "$SRC" >/dev/null
echo "Ziel: $APP"

if [ -w "$(dirname "$APP")" ]; then
  rm -rf "$APP.staged.tmp"
  cp -R "$SRC/build/Sofa.app" "$APP.staged.tmp"
  rm -rf "$APP.staged"                     # nie in ein altes .staged verschachteln
  mv "$APP.staged.tmp" "$APP.staged"       # atomar sichtbar
  echo "bereitgestellt; warte auf Übernahme durch SofaRemote ..."
  for i in $(seq 1 60); do [ -e "$APP.staged" ] || break; sleep 0.5; done
  [ -e "$APP.staged" ] && { echo "WARNUNG: nicht übernommen (läuft SofaRemote mit Update-Logik?)"; exit 1; }
else
  U="$HOME/Library/Application Support/Sofa/update"
  mkdir -p "$U"
  rm -rf "$U/Sofa.app" "$U/Sofa.app.tmp" "$U/ready"
  cp -R "$SRC/build/Sofa.app" "$U/Sofa.app.tmp"
  mv "$U/Sofa.app.tmp" "$U/Sofa.app"
  echo "bereitgestellt (extern); warte, bis SofaRemote Sofa beendet hat ..."
  for i in $(seq 1 60); do [ -e "$U/ready" ] && break; sleep 0.5; done
  [ -e "$U/ready" ] || { rm -rf "$U/Sofa.app"; echo "WARNUNG: SofaRemote hat nicht reagiert (alter Helper ohne externen Tausch?)"; exit 1; }
  # Tausch als root; das neue Bundle bekommt dieselben Besitzrechte wie das alte
  OWNER="$(stat -f '%Su:%Sg' "$APP")"
  as_root rm -rf "$APP.prev"
  as_root mv "$APP" "$APP.prev"
  as_root mv "$U/Sofa.app" "$APP"
  as_root chown -R "$OWNER" "$APP"
  for i in $(seq 1 40); do [ -e "$U/ready" ] || break; sleep 0.5; done
fi
sleep 1
tail -4 "$LOG"

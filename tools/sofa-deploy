#!/bin/bash
# Roll out a new Sofa without disturbing the user. The running SofaRemote helper takes over
# within ~3 s: Sofa saves its state (area + running video + position), swap,
# restart, playback continues at the same spot. Rollback: <App>.prev.
#
# Target = the Sofa.app the running helper comes from (else the MacPorts copy, else the /Applications copy).
#  - app folder writable (/Applications): bundle as <App>.staged next to it, the helper swaps.
#  - not writable (MacPorts port: /Applications/MacPorts belongs to root): bundle into
#    ~/Library/Application Support/Sofa/update/Sofa.app, the helper quits Sofa and signals
#    "ready", this script swaps via sudo. sudo non-interactively: set SUDO_PW.
# On a port installation this is a development state; `port -n upgrade --force sofa`
# restores the port state.
#
# Usage: tools/sofa-deploy                 the current build, with the installed app's runtime
#        tools/sofa-deploy --bundle <App>  a complete bundle (tools/make-release), e.g.
#                                          when the installed runtime lacks a part the build needs
set -eu
BUNDLE=
case "${1:-}" in
  --bundle) BUNDLE="$(cd "${2:?usage: sofa-deploy --bundle <App>}" && pwd)" ;;
  "") ;;
  *) echo "usage: sofa-deploy [--bundle <App>]"; exit 2 ;;
esac
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
LOG="$HOME/Library/Logs/SofaRemote.log"

APP="$(ps -axo command | sed -n 's|^\(/.*/Sofa\.app\)/Contents/MacOS/SofaRemote.*|\1|p' | head -1)"
if [ -z "$APP" ]; then
  if [ -d /Applications/MacPorts/Sofa.app ]; then APP=/Applications/MacPorts/Sofa.app; else APP=/Applications/Sofa.app; fi
  echo "WARNING: no SofaRemote running - target $APP, takeover only at the next helper start"
fi

as_root() {
  if [ -n "${SUDO_PW:-}" ]; then echo "$SUDO_PW" | sudo -S -k -p '' "$@"; else sudo "$@"; fi
}

echo "target: $APP"

if [ -n "$BUNDLE" ]; then
  # a complete bundle as it is (its own runtime and libraries)
  NEW="$BUNDLE"
  for t in lib/firefox/firefox bin/Xvfb; do
    [ -x "$NEW/Contents/Runtime/$t" ] || { echo "ERROR: $NEW has no Runtime/$t - not a release bundle (make-release)"; exit 1; }
  done
  echo "complete bundle: $NEW"
elif [ -d "$APP/Contents/Runtime" ]; then
  # release bundle installed: take over its runtime + libraries and relink only the new programs
  # against them (seconds instead of rebuilding the release)
  make -C "$SRC" >/dev/null
  NEW="$SRC/build/Sofa-release.app"
  rm -rf "$NEW"; cp -R "$SRC/build/Sofa.app" "$NEW"
  cp -R "$APP/Contents/Runtime" "$APP/Contents/Frameworks" "$NEW/Contents/"
  # YouTube runs in the engine's browser (docs/youtube-engine.md): a runtime without it would turn
  # YouTube off in the installed app - that needs a new release bundle first (--bundle)
  for t in lib/firefox/firefox bin/Xvfb; do   # make-release's layout (SFRuntimePath)
    [ -x "$NEW/Contents/Runtime/$t" ] || { echo "ERROR: the installed runtime has no ${t##*/} - deploy refused (YouTube would stop working; deploy a make-release bundle with --bundle)"; exit 1; }
  done
  rm -rf "$NEW/Contents/Runtime/Python.framework"   # no longer shipped (yt-dlp removed 2026-11-06, make-release)
  # its errors go to stdout with the summary: show them when it fails (set -e ended silently before)
  /opt/local/bin/python3.14 -I "$SRC/tools/relink.py" "$NEW/Contents/MacOS" "$NEW/Contents/Frameworks" > "$NEW.relink.log" 2>&1 \
    || { echo "ERROR: relink failed:"; grep -v '^[0-9]* Mach-O' "$NEW.relink.log" | head -5; rm -f "$NEW.relink.log"; exit 1; }
  rm -f "$NEW.relink.log"
  echo "release bundle: runtime taken over, programs relinked"
else
  make -C "$SRC" >/dev/null
  NEW="$SRC/build/Sofa.app"
fi

if [ -w "$(dirname "$APP")" ]; then
  rm -rf "$APP.staged.tmp"
  cp -R "$NEW" "$APP.staged.tmp"
  rm -rf "$APP.staged"                     # never nest into an old .staged
  mv "$APP.staged.tmp" "$APP.staged"       # becomes visible atomically
  echo "staged; waiting for SofaRemote to take over ..."
  for i in $(seq 1 60); do [ -e "$APP.staged" ] || break; sleep 0.5; done
  [ -e "$APP.staged" ] && { echo "WARNING: not taken over (is SofaRemote running with the update logic?)"; exit 1; }
else
  U="$HOME/Library/Application Support/Sofa/update"
  mkdir -p "$U"
  rm -rf "$U/Sofa.app" "$U/Sofa.app.tmp" "$U/ready"
  cp -R "$NEW" "$U/Sofa.app.tmp"
  mv "$U/Sofa.app.tmp" "$U/Sofa.app"
  echo "staged (external); waiting until SofaRemote has quit Sofa ..."
  for i in $(seq 1 60); do [ -e "$U/ready" ] && break; sleep 0.5; done
  [ -e "$U/ready" ] || { rm -rf "$U/Sofa.app"; echo "WARNING: SofaRemote did not respond (old helper without external swap?)"; exit 1; }
  # swap as root; the new bundle gets the same ownership as the old one
  OWNER="$(stat -f '%Su:%Sg' "$APP")"
  as_root rm -rf "$APP.prev"
  as_root mv "$APP" "$APP.prev"
  as_root mv "$U/Sofa.app" "$APP"
  as_root chown -R "$OWNER" "$APP"
  for i in $(seq 1 40); do [ -e "$U/ready" ] || break; sleep 0.5; done
fi
sleep 1
tail -4 "$LOG"

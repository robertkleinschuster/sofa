#!/bin/bash
# test-sofa-yt -- tests of the YouTube SABR sidecar (res/sofa-yt).
#   tools/test-sofa-yt              type check (tsc, mandatory), then the offline unit tests
#                                   (fixtures in tests/sofa-yt, no network)
#   SOFA_YT_LIVE=1 tools/test-sofa-yt
#                                   + live smoke test: one /open (at most one player request, none
#                                     when the state dir still holds a valid response), 10 s of
#                                     playback in mpv from 60 s, one seek. Uses YouTube - opt-in only.
# The sidecar runs from build/sofa-yt-run (res/sofa-yt + the node_modules of tools/fetch-sofa-yt, i.e.
# exactly the runtime dependencies that ship). Type checking uses a separate dev install of the same
# lockfile (devDependencies included: typescript, @types/*) in build/vendor/sofa-yt-dev, reachable for
# tsc and editors through the git-ignored symlink res/sofa-yt/node_modules.
set -eu
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
NODE="${SOFA_NODE:-/opt/local/bin/node}"
VENDOR="$SRC/build/vendor/sofa-yt"
DEV="$SRC/build/vendor/sofa-yt-dev"
RUN="$SRC/build/sofa-yt-run"
LOCK=$(shasum -a 256 "$SRC/res/sofa-yt/package-lock.json" | cut -d' ' -f1)
if [ ! -f "$VENDOR/STAMP" ] || [ "$(cat "$VENDOR/STAMP")" != "$LOCK" ]; then
  "$SRC/tools/fetch-sofa-yt"
fi

# ---- type check -------------------------------------------------------------------------------
# dev install (devDependencies too: typescript, esbuild-wasm, @types/*), see tools/fetch-sofa-yt --dev
if [ ! -f "$DEV/STAMP" ] || [ "$(cat "$DEV/STAMP")" != "$LOCK" ]; then "$SRC/tools/fetch-sofa-yt" --dev; fi
LINK="$SRC/res/sofa-yt/node_modules"
if [ "$(readlink "$LINK" 2>/dev/null)" != "../../build/vendor/sofa-yt-dev/node_modules" ]; then
  [ -e "$LINK" ] && [ ! -L "$LINK" ] && { echo "test-sofa-yt: $LINK is not a symlink - remove it"; exit 1; }
  rm -f "$LINK"; ln -s ../../build/vendor/sofa-yt-dev/node_modules "$LINK"
fi
# the type check runs beside the tests (independent; both must pass), its verdict is printed first
TSC_OUT="$(mktemp "${TMPDIR:-/tmp}/sofa-tsc.XXXXXX")"
( "$NODE" "$DEV/node_modules/typescript/bin/tsc" -p "$SRC/res/sofa-yt" --pretty false > "$TSC_OUT" 2>&1 \
  && "$NODE" "$DEV/node_modules/typescript/bin/tsc" -p "$SRC/res/sofa-yt/web" --pretty false >> "$TSC_OUT" 2>&1 ) & TSC=$!

# ---- tests ------------------------------------------------------------------------------------
rm -rf "$RUN"; mkdir -p "$RUN"
# the sources as they ship (no dev node_modules, no tsconfig), plus the shipped dependencies
(cd "$SRC/res/sofa-yt" && cp package.json *.ts "$RUN/" && mkdir -p "$RUN/lib" && cp lib/*.ts "$RUN/lib/")
ln -s "$VENDOR/node_modules" "$RUN/node_modules"
# the browser engine bundle (docs/youtube-engine.md), loaded by unit-engine in headless Firefox
"$SRC/tools/build-yt-engine" >/dev/null || exit 1
export SOFA_YT_DIR="$RUN" SOFA_NODE="$NODE" SOFA_YT_ENGINE="$SRC/build/sofa-yt-web/engine.js"
cd "$SRC/tests/sofa-yt"
FILES=(unit-*.test.ts)
[ "${SOFA_YT_LIVE:-0}" = 1 ] && FILES+=(live-smoke.test.ts)
set +e
"$NODE" --test --test-reporter=spec "${FILES[@]}" > "$TSC_OUT.tests" 2>&1; tests=$?
wait $TSC; tsc=$?
echo "==> tsc -p res/sofa-yt + res/sofa-yt/web ($("$NODE" "$DEV/node_modules/typescript/bin/tsc" --version)): $([ $tsc = 0 ] && echo ok || echo FAILED)"
cat "$TSC_OUT"
cat "$TSC_OUT.tests"
rm -f "$TSC_OUT" "$TSC_OUT.tests"
[ $tsc = 0 ] || { echo "test-sofa-yt: type check failed"; exit 1; }
exit $tests

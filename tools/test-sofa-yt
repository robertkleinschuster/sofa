#!/bin/bash
# test-sofa-yt -- tests of Sofa's YouTube engine (res/sofa-yt, docs/youtube-engine.md).
#   tools/test-sofa-yt              type check (tsc, mandatory), then the offline unit tests
#                                   (fixtures in tests/sofa-yt, no network): the engine core driven
#                                   directly and through tests/sofa-yt/mediaserver.ts (Sofa's media
#                                   routes, same data path), mpv on those URLs, the bundle in Firefox
#   SOFA_YT_LIVE=1 tools/test-sofa-yt
#                                   + the live tests (youtube.com in Firefox: YouTube's own player as a
#                                     baseline, the engine through its extension). Uses YouTube - opt-in only.
#   SOFA_YT_FILES="unit-store.test.ts live-extension.test.ts" tools/test-sofa-yt
#                                   only these test files (type check as always)
# Sources and tests run from res/sofa-yt with the dev install of the lockfile (build/vendor/sofa-yt-dev,
# reachable for node, tsc and editors through the git-ignored symlink res/sofa-yt/node_modules).
set -eu
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
NODE="${SOFA_NODE:-/opt/local/bin/node}"
DEV="$SRC/build/vendor/sofa-yt-dev"
LOCK=$(shasum -a 256 "$SRC/res/sofa-yt/package-lock.json" | cut -d' ' -f1)

# ---- type check -------------------------------------------------------------------------------
# dev install (devDependencies too: typescript, @types/node), see tools/fetch-sofa-yt --dev
if [ ! -f "$DEV/STAMP" ] || [ "$(cat "$DEV/STAMP")" != "$LOCK" ]; then "$SRC/tools/fetch-sofa-yt" --dev; fi
LINK="$SRC/res/sofa-yt/node_modules"
if [ "$(readlink "$LINK" 2>/dev/null)" != "../../build/vendor/sofa-yt-dev/node_modules" ]; then
  [ -e "$LINK" ] && [ ! -L "$LINK" ] && { echo "test-sofa-yt: $LINK is not a symlink - remove it"; exit 1; }
  rm -f "$LINK"; ln -s ../../build/vendor/sofa-yt-dev/node_modules "$LINK"
fi
# the type check runs beside the tests (independent; both must pass), its verdict is printed first.
# Incremental (build/tsc, git-ignored): unchanged sources are not checked again - 17 of the suite's
# CPU seconds under test-all's load; a change is still checked in full where it reaches
TSC_OUT="$(mktemp "${TMPDIR:-/tmp}/sofa-tsc.XXXXXX")"
mkdir -p "$SRC/build/tsc"
tsc() { "$NODE" "$DEV/node_modules/typescript/bin/tsc" -p "$SRC/res/sofa-yt$1" --pretty false --incremental --tsBuildInfoFile "$SRC/build/tsc/sofa-yt$2.tsbuildinfo"; }
( tsc "" "" > "$TSC_OUT" 2>&1 && tsc /web -web >> "$TSC_OUT" 2>&1 ) & TSC=$!

# ---- tests ------------------------------------------------------------------------------------
# the browser engine bundle (docs/youtube-engine.md): unit-engine loads it in Firefox, the live tests install the extension
"$SRC/tools/build-yt-engine" >/dev/null || exit 1
export SOFA_YT_DIR="$SRC/res/sofa-yt" SOFA_NODE="$NODE" SOFA_YT_ENGINE="$SRC/build/sofa-yt-web/engine.js" SOFA_YT_EXTENSION="$SRC/build/sofa-yt-web/extension"
cd "$SRC/tests/sofa-yt"
FILES=(unit-*.test.ts)
[ "${SOFA_YT_LIVE:-0}" = 1 ] && FILES+=(live-*.test.ts)
# SOFA_YT_FILES="live-extension.test.ts": only these (one live test without the others' requests)
[ -n "${SOFA_YT_FILES:-}" ] && read -r -a FILES <<< "$SOFA_YT_FILES"
set +e
"$NODE" --test --test-reporter=spec "${FILES[@]}" > "$TSC_OUT.tests" 2>&1; tests=$?
wait $TSC; tsc=$?
echo "==> tsc -p res/sofa-yt + res/sofa-yt/web ($("$NODE" "$DEV/node_modules/typescript/bin/tsc" --version)): $([ $tsc = 0 ] && echo ok || echo FAILED)"
cat "$TSC_OUT"
cat "$TSC_OUT.tests"
rm -f "$TSC_OUT" "$TSC_OUT.tests"
[ $tsc = 0 ] || { echo "test-sofa-yt: type check failed"; exit 1; }
exit $tests

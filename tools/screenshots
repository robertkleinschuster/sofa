#!/bin/bash
# screenshots -- regenerate the README screenshots of all main pages (for every release).
#
# Starts an invisible dev instance (own settings, does not change the real app),
# opens the pages via the dev FIFO, renders them (1920x1080) and stores downscaled JPEGs
# in docs/screenshots/. The content (channels, shows) is this Mac's.
#   tools/screenshots [build/SofaDev.app]
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
APP="${1:-$SRC/build/SofaDev.app}"
OUT="$SRC/docs/screenshots"
INST=shots
FIFO="$HOME/Library/Caches/Sofa/dev-$INST.fifo"
LOG="$HOME/Library/Logs/Sofa-dev-$INST.log"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/sofa-shots.XXXXXX")"
mkdir -p "$OUT"

make -C "$SRC" >/dev/null || exit 1
: > "$LOG"
defaults delete de.sofa.dev.$INST >/dev/null 2>&1   # fresh settings of this instance (show welcome/questions)
"$APP/Contents/MacOS/Sofa" --dev --instance "$INST" --port 47990 >/dev/null 2>&1 &
PID=$!
trap 'kill $PID 2>/dev/null; rm -rf "$TMP"' EXIT
for i in $(seq 1 60); do grep -q 'fifo ready' "$LOG" 2>/dev/null && break; sleep 0.5; done
grep -q 'fifo ready' "$LOG" || { echo "dev instance does not start"; exit 1; }

cmd()  { echo "$*" > "$FIFO"; }
keys() { for k in "$@"; do cmd key "$k"; sleep 0.7; done; }
# shot <name> <wait>: wait (images load), render, store as JPEG (1600 px wide)
shot() {
  sleep "$2"
  rm -f "$TMP/$1.png"; cmd shot "$TMP/$1.png"
  for i in $(seq 1 20); do [ -s "$TMP/$1.png" ] && break; sleep 0.5; done
  if [ -s "$TMP/$1.png" ]; then
    sips -s format jpeg -s formatOptions 80 --resampleWidth 1600 "$TMP/$1.png" --out "$OUT/$1.jpg" >/dev/null 2>&1
    echo "  $1.jpg"
  else
    echo "  MISSING: $1"
  fi
}

echo "==> screenshots into $OUT"
sleep 10                                   # home: library + images load
shot home 4
keys right right right right right right right
cmd open settings;          shot settings 2
cmd home
cmd open app:youtube;       shot youtube 10
keys selecthold;            shot youtube-options 2
keys menu up select;        shot search 4
cmd home; cmd open "ytchannel:UCsXVk37bltHxD1rDPwtNM8Q|Kurzgesagt – In a Nutshell"; shot youtube-channel 10
cmd home; cmd open app:zdf; shot zdf 10
cmd home; cmd open app:ard; shot ard 10
cmd home; cmd open app:orf; shot orf 10
cmd home; cmd open app:ccc; shot media-ccc 10
cmd home; cmd open downloads; shot downloads 4
cmd home; cmd open history;   shot history 4
cmd home; cmd open pair;      shot pair 6
cmd home; cmd open welcome;   shot welcome 2
keys select;                  shot first-start 2
cmd quit
echo "==> done ($(ls "$OUT"/*.jpg | wc -l | tr -d ' ') images)"

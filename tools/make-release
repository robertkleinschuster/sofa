#!/bin/bash
# make-release -- build a self-contained Sofa.app + DMG (for GitHub releases).
#
# MacPorts is only the workbench here: Sofa is built against the MacPorts libraries,
# then every runtime part goes into the bundle and is relinked @loader_path-relative.
# The user only needs the DMG -- no MacPorts, no Xcode tools.
#
#   Contents/MacOS/{Sofa,SofaRemote}
#   Contents/Frameworks/*.dylib           all libraries (libmpv, ffmpeg, curl/OpenSSL, libc++, MLS, ...)
#   Contents/Runtime/bin/{ffmpeg,rsvg-convert,Xvfb,xkbcomp}
#   Contents/Runtime/lib/{firefox/,libGL.1.dylib,dri/}   the engine's browser + Mesa
#   Contents/Runtime/share/{X11/xkb,fonts/misc}         Xvfb's keymaps and fonts
#   Contents/Resources/youtube-engine     the YouTube engine's Firefox extension (docs/youtube-engine.md)
#   Contents/Runtime/etc/{cert.pem,fonts/}
#
# Prerequisite (build machine): ports for the sofa dependencies installed.
# Usage: tools/make-release            -> dist/Sofa-<version>.dmg (+ .sig, .sha256,
#                                          sofa-yt-modules-<lock>.tar.gz: the engine's build
#                                          dependencies, a distfile of the MacPorts port)
#        tools/make-release --local    -> dist/Sofa.app for THIS Mac only (tools/sofa-deploy
#                                          --bundle): parts of it may still use MacPorts (a
#                                          firefox-x11 without the relative libGL path), so no
#                                          DMG, no signature - it cannot be published by mistake
set -eu
unset DYLD_INSERT_LIBRARIES
LOCAL=0
case "${1:-}" in --local) LOCAL=1 ;; "") ;; *) echo "usage: make-release [--local]"; exit 2 ;; esac
SRC="$(cd "$(dirname "$0")/.." && pwd)"
MP=/opt/local
PY="$MP/bin/python3.14"
VER=$(/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' "$SRC/res/Info.plist")
DIST="$SRC/dist"
APP="$DIST/Sofa.app"
RT="$APP/Contents/Runtime"

echo "==> building Sofa $VER"
make -C "$SRC" >/dev/null
# regression suites first: never ship a build that fails one (SKIP_TESTS=1 only for emergencies)
[ "${SKIP_TESTS:-0}" = 1 ] || "$SRC/tools/test-all" || { echo "ERROR: regression tests failed"; exit 1; }
rm -rf "$DIST"; mkdir -p "$DIST"
cp -R "$SRC/build/Sofa.app" "$APP"
mkdir -p "$RT/bin" "$RT/etc/fonts" "$APP/Contents/Frameworks"

echo "==> tools"
for t in ffmpeg rsvg-convert; do cp -L "$MP/bin/$t" "$RT/bin/$t"; done

echo "==> YouTube engine: extension + its browser (Firefox, Xvfb, Mesa; SFYTBrowser finds them in Runtime)"
[ -f "$APP/Contents/Resources/youtube-engine/manifest.json" ] || { echo "ERROR: engine extension missing in the build"; exit 1; }
# WebGL: Firefox opens Mesa's libGL by a path relative to itself (firefox-x11 patch) - a build that
# still names the MacPorts path would lose WebGL in the bundle (a signal YouTube can see)
if /usr/bin/grep -q "$MP/lib/libGL" "$MP/lib/firefox/libxul.dylib" "$MP/lib/firefox/glxtest"; then
  if [ $LOCAL = 1 ]; then echo "    note: firefox-x11 opens libGL from $MP - WebGL on this Mac only (--local)"
  else echo "ERROR: firefox-x11 still opens libGL from $MP (needs its relative-path patch)"; exit 1; fi
fi
mkdir -p "$RT/lib/dri" "$RT/share/X11" "$RT/share/fonts"
cp -RL "$MP/lib/firefox" "$RT/lib/firefox"
rm -rf "$RT/lib/firefox/"{nsinstall,certutil,xpcshell,gmp-fake,gmp-fakeopenh264,dependentlibs.list.gtest}   # build/test tools
for t in Xvfb xkbcomp; do cp -L "$MP/bin/$t" "$RT/bin/$t"; done
cp -L "$MP/lib/libGL.1.dylib" "$RT/lib/"                       # opened by Firefox (dlopen)
cp -L "$MP"/lib/dri/*_dri.dylib "$RT/lib/dri/"                  # LIBGL_DRIVERS_PATH (Xvfb GLX, Firefox WebGL)
cp -RL "$MP/share/X11/xkb" "$RT/share/X11/xkb"                  # Xvfb -xkbdir
cp -RL "$MP/share/fonts/misc" "$RT/share/fonts/misc"            # Xvfb -fp ("fixed", "cursor")

echo "==> CA certificates, fontconfig, empty module/config paths (against MacPorts modules, see SFRuntime)"
mkdir -p "$RT/lib/gio/modules"
: > "$RT/etc/gdk-pixbuf-loaders.cache"
printf '# Sofa: do not load any system/MacPorts OpenSSL configuration\n' > "$RT/etc/openssl.cnf"
cp "$MP/share/curl/curl-ca-bundle.crt" "$RT/etc/cert.pem"
cat > "$RT/etc/fonts/fonts.conf" <<'XML'
<?xml version="1.0"?>
<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">
<!-- Sofa release: macOS system fonts only, cache in the user cache -->
<fontconfig>
  <dir>/System/Library/Fonts</dir>
  <dir>/Library/Fonts</dir>
  <dir prefix="xdg">fonts</dir>
  <dir>~/Library/Fonts</dir>
  <cachedir>~/Library/Caches/Sofa/fontconfig</cachedir>
  <alias><family>sans-serif</family><prefer><family>Helvetica Neue</family></prefer></alias>
  <alias><family>serif</family><prefer><family>Times</family></prefer></alias>
  <alias><family>monospace</family><prefer><family>Menlo</family></prefer></alias>
</fontconfig>
XML

echo "==> collecting and relinking libraries"
"$PY" -I "$SRC/tools/relink.py" "$APP/Contents" "$APP/Contents/Frameworks"   # exit 1 on errors

echo "==> stripping symbols (tools + libraries; Sofa itself keeps them for crash reports)"
strip -x "$RT"/bin/* "$APP"/Contents/Frameworks/*.dylib 2>/dev/null || true

echo "==> checking: only system and bundle dependencies left, no rpaths"
"$PY" -I "$SRC/tools/relink.py" --check "$APP"
# runtime scripts: no /opt/local paths
LEFT=$(/usr/bin/grep -rlI --include='*.js' --include='*.json' "$MP/" "$APP/Contents/Resources/youtube-engine" || true)
[ -z "$LEFT" ] || { echo "ERROR: $MP paths in runtime scripts:"; echo "$LEFT"; exit 1; }

if [ $LOCAL = 1 ]; then
  du -sh "$APP"
  echo "==> $APP: for this Mac only (tools/sofa-deploy --bundle $APP) - not a release"
  exit 0
fi

echo "==> DMG"
STAGE="$DIST/dmg"; mkdir -p "$STAGE"
mv "$APP" "$STAGE/"
trap 'mv "$STAGE/Sofa.app" "$APP" 2>/dev/null; rm -rf "$STAGE"' EXIT   # even if hdiutil fails
ln -s /Applications "$STAGE/Programme"
# set the size explicitly: hdiutil's estimate was too tight at ~330 MB (error -5341)
MB=$(( $(du -sm "$STAGE/Sofa.app" | cut -f1) * 11 / 10 + 40 ))
hdiutil create -quiet -volname "Sofa $VER" -srcfolder "$STAGE" -size ${MB}m -format UDBZ -ov "$DIST/Sofa-$VER.dmg" \
  || { echo "ERROR: hdiutil create failed"; exit 1; }
mv "$STAGE/Sofa.app" "$APP"; rm -rf "$STAGE"; trap - EXIT
# Signature (Sofa's updater only installs signed DMGs, SFSignature) + checksum for humans.
# The private key never leaves this Mac (~/.config/sofa, 0600, not in the repo).
KEY="${SOFA_SIGNING_KEY:-$HOME/.config/sofa/release-signing-key.pem}"
[ -f "$KEY" ] || { echo "ERROR: signing key $KEY missing"; exit 1; }
"$MP/bin/openssl" dgst -sha256 -sign "$KEY" -out "$DIST/Sofa-$VER.dmg.sig" "$DIST/Sofa-$VER.dmg"
"$MP/bin/openssl" dgst -sha256 -verify "$SRC/res/sofa-release-public.pem" -signature "$DIST/Sofa-$VER.dmg.sig" "$DIST/Sofa-$VER.dmg" >/dev/null \
  || { echo "ERROR: signature does not match the public key in the bundle"; exit 1; }
(cd "$DIST" && shasum -a 256 "Sofa-$VER.dmg" > "Sofa-$VER.dmg.sha256")
# the engine's build dependencies as a distfile for the MacPorts port (no network while building)
"$SRC/tools/fetch-sofa-yt" --pack "$DIST" >/dev/null
du -sh "$APP" "$DIST/Sofa-$VER.dmg"
cat "$DIST/Sofa-$VER.dmg.sha256"

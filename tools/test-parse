#!/bin/bash
# test-parse -- every app's pure parser against recorded real answers, offline.
# tests/fixtures/<app>/<kind>-<name>.json.gz are real answers (from the dev instances' caches,
# cookies stripped); <kind> says what the app parses them as (SFApp parseFixture:kind:);
# <kind>-<name>.txt is what the parser made of them when they were recorded: one line per item
# (SFCanonicalItem). A parser change that changes the output fails here - intended changes are
# recorded again with --record (and the diff reviewed).
# Plus: the YouTube search page built from its recorded answer (rows, playlists apart from videos).
#   tools/test-parse [--record] [app]
# Exit code 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
. "$SRC/tools/lib/dev-instance.sh"
BIN="$SRC/build/SofaDev.app/Contents/MacOS/Sofa"
INST=parse
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-parse.XXXXXX")"
trap 'rm -rf "${T:?}"' EXIT   # until the full cleanup below takes over (a failed build exits before it)
export SOFA_DATA_DIR="$T/data" SOFA_OFFLINE=1
# the instance keeps its log and dev FIFO in its data directory (SFDevPrivateDir): gone with $T
mkdir -p "$SOFA_DATA_DIR"; FIFO="$SOFA_DATA_DIR/dev.fifo" LOG="$SOFA_DATA_DIR/sofa.log"
record=0; [ "${1:-}" = "--record" ] && { record=1; shift; }
only="${1:-}"
fail=0; ok() { echo "  ok    $*"; }; bad() { echo "  FAIL  $*"; fail=1; }

make -C "$SRC" >/dev/null || exit 1
APP=
trap '[ -n "$APP" ] && kill $APP 2>/dev/null; { defaults delete de.sofa.dev.$INST; rm -f "$HOME/Library/Preferences/de.sofa.dev.$INST.plist"; } >/dev/null 2>&1; rm -rf "$T"' EXIT
: > "$LOG"
"$BIN" --dev --instance $INST >/dev/null 2>&1 & APP=$!
dev_wait_ready $APP "$LOG"

for gz in "$SRC"/tests/fixtures/*/*.json.gz; do
  app=$(basename "$(dirname "$gz")") n=$(basename "$gz" .json.gz)
  [ -n "$only" ] && [ "$app" != "$only" ] && continue
  out="$T/$app-$n.txt" want="${gz%.json.gz}.txt"
  gunzip -c "$gz" > "$T/$app-$n.json"
  echo "parse $app ${n%%-*} $T/$app-$n.json $out" 1<>"$FIFO"
  for i in $(seq 1 100); do grep -qE "dev: parse (written $out|failed: $app )" "$LOG" && break; kill -0 $APP 2>/dev/null || break; sleep 0.1; done
  kill -0 $APP 2>/dev/null || { bad "$app/$n: the parser crashed the dev instance"; APP=; break; }
  [ -f "$out" ] || { bad "$app/$n: no output"; continue; }
  if [ $record = 1 ]; then cp "$out" "$want"; ok "$app/$n recorded ($(grep -c '^item' "$out") items)"
  elif diff -u "$want" "$out" > "$T/$app-$n.diff"; then ok "$app/$n ($(grep -c '^item' "$out") items)"
  else bad "$app/$n differs:"; head -20 "$T/$app-$n.diff" | sed 's/^/        /'; fi
done
# the YouTube search page built from the recorded answer (served from the response cache, offline):
# playlists apart from the videos, plus the tile that asks YouTube's playlist filter (user 2026-11-08)
if [ -n "$APP" ] && { [ -z "$only" ] || [ "$only" = youtube ]; }; then
  q="igte tu graz theorie"
  gunzip -c "$SRC/tests/fixtures/youtube/search-query.json.gz" > "$T/search.json"
  /opt/local/bin/sqlite3 "$SOFA_DATA_DIR/Caches/cache.db" "INSERT OR REPLACE INTO jcache (k, t, v) VALUES ('yt search {\"query\":\"$q\"}', strftime('%s','now'), CAST(readfile('$T/search.json') AS BLOB))"
  echo "ytsearch $q" 1<>"$FIFO"
  for i in $(seq 1 100); do grep -q "dev: ytsearch end" "$LOG" && break; sleep 0.1; done
  row() { grep "dev: ytsearch row $1 |" "$LOG" | tail -1 | sed 's/.*| //'; }
  pl=$(row Playlists) vids=$(row Videos)
  [ "$(grep -c 'dev: ytsearch row' "$LOG")" = 3 ] && [ -n "$(row Kanäle)" ] && ok "search: rows Kanäle, Playlists, Videos" || bad "search rows: $(grep 'dev: ytsearch' "$LOG" | cut -c1-120 | tr '\n' '|')"
  [ "$pl" = "ytplaylist:PLix-pC3FYrYVe8mYl_X-wqm7uvkRs3MiJ ytsearch:playlists:$q" ] && ok "search: the answer's playlist, then 'Mehr Playlists'" || bad "search playlists row: '$pl'"
  case " $vids " in *ytplaylist:*) bad "search: a playlist among the videos" ;; *) [ "$(echo $vids | wc -w | tr -d ' ')" = 14 ] && ok "search: 14 videos, no playlist among them" || bad "search videos row: $vids" ;; esac
fi
echo quit 1<>"$FIFO"; dev_wait_exit $APP; APP=

[ $fail = 0 ] && echo "==> test-parse ok" || echo "==> test-parse FAILED"
exit $fail

#!/bin/bash
# test-units -- unit tests of pure core functions (no app instance): tests/units/*.m are linked
# against the core sources they test and must exit 0.
set -u
SRC="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$(mktemp -d "${TMPDIR:-/tmp}/sofa-units.XXXXXX")"; trap 'rm -rf "$OUT"' EXIT
fail=0
for t in "$SRC"/tests/units/*.m; do
  n=$(basename "$t" .m)
  if ! /usr/bin/clang -fobjc-arc -I"$SRC/src/Core" -I"$SRC/src/Framework" "$t" "$SRC/src/Core/SFCore.m" \
       -framework AppKit -framework QuartzCore -framework AVFoundation -undefined dynamic_lookup -o "$OUT/$n" 2>"$OUT/$n.log"; then
    echo "FAIL $n (build)"; cat "$OUT/$n.log"; fail=1; continue; fi
  if "$OUT/$n" > "$OUT/$n.out" 2>&1; then echo "ok   $n"; else echo "FAIL $n"; cat "$OUT/$n.out"; fail=1; fi
done
[ $fail = 0 ] && echo "==> all ok" || echo "==> FAILED"
exit $fail

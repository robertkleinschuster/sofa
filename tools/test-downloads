#!/bin/bash
# test-downloads -- robustness regression tests for the download layer, in an invisible dev instance
# (a fresh data directory per run: database + download folder, removed at exit). No YouTube requests.
#
# Incident 2026-11-04: an update restart (_exit) left ffmpeg running as an orphan; it kept writing the
# same .part file as the restarted download -> corrupt 1.2 GB file. Checks:
#   1. an orphaned ffmpeg writing into the download folder is killed at start, its part file swept
#   2. the verifier accepts a healthy file and rejects a corrupted one
#   3. quitting during a download (update handover, plain quit) leaves no ffmpeg behind, uses no
#      attempt, and the download resumes on the next start
#   4. a failed repair keeps the old file and is retried later (YouTube's bot check blocks for hours)
#   5. during a YouTube bot-check pause a queued YouTube download waits without any request
#   6. storage guard: below the reserve no download starts and a running one stops - both stay
#      queued without using an attempt, the user is asked to make room, and the queue continues
#      by itself once there is room (user 2026-11-05: never fill the disk, never delete by itself)
#   7. "Platz schaffen": bulk deletion removes only what is still online and not "Behalten";
#      a video that is no longer online and a kept one stay
#   tools/test-downloads   both parts side by side, each with its own instance and media server
#                          (part a: 1-4, part b: 5-7, 4b); DLTEST_PART=a|b runs one part here
# Exit code 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
. "$SRC/tools/lib/dev-instance.sh"
BIN="$SRC/build/SofaDev.app/Contents/MacOS/Sofa"
PART=${DLTEST_PART:-}
if [ -z "$PART" ]; then   # both parts at once; output part by part
  make -C "$SRC" >/dev/null || exit 1
  O="$(mktemp -d "${TMPDIR:-/tmp}/sofa-dlparts.XXXXXX")"
  DLTEST_PART=a "$0" > "$O/a" 2>&1 & A=$!
  DLTEST_PART=b "$0" > "$O/b" 2>&1 & B=$!
  wait $A; ra=$?; wait $B; rb=$?
  grep -hv '^==> all ok$\|^==> FAILED$' "$O/a" "$O/b"
  rm -rf "$O"
  [ $ra = 0 ] && [ $rb = 0 ] && { echo "==> all ok"; exit 0; } || { echo "==> FAILED"; exit 1; }
fi
want() { [ "$PART" = "$1" ]; }
INST=dltest-$PART
if want a; then MEDIA_PORT=47982; else MEDIA_PORT=47983; fi
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-dltest.XXXXXX")"
trap 'rm -rf "${T:?}"' EXIT   # until the full cleanup below takes over (a failed build exits before it)
export SOFA_DATA_DIR="$T/data"   # the dev instance's whole state (SFSetDevInstance)
# the instance keeps its log and dev FIFO in its data directory (SFDevPrivateDir): gone with $T
mkdir -p "$SOFA_DATA_DIR"; FIFO="$SOFA_DATA_DIR/dev.fifo" LOG="$SOFA_DATA_DIR/sofa.log"
export SOFA_SOURCE_GAP=3         # per-source spacing of download starts: 3 s instead of 30
ROOT="$SOFA_DATA_DIR/Downloads"
DEVDB="$SOFA_DATA_DIR/sofa.db"
FF=/opt/local/bin/ffmpeg; [ -x "$FF" ] || FF=/Applications/Sofa.app/Contents/Runtime/bin/ffmpeg
# Offline: the Example app serves its items from a local, throttled HTTP server (SOFA_EXAMPLE_MEDIA);
# YouTube is registered for section 5 only (and stays paused there).
export SOFA_ONLY_APPS=example,youtube
REF=example:1      # downloadable (local server, slow enough to quit during the download)
BADREF=example:0   # an id the Example app does not know: its download always fails
YTREF=yt:jNQXAC9IVRw   # never actually requested (section 5 keeps YouTube paused)
fail=0; ok() { echo "  ok    $*"; }; bad() { echo "  FAIL  $*"; fail=1; }
check() { [ "$2" = "$3" ] && ok "$1" || bad "$1: got '$2', want '$3'"; }   # check NAME GOT WANT

make -C "$SRC" >/dev/null || exit 1
APP=
start() {
  : > "$LOG"
  "$BIN" --dev --instance $INST >/dev/null 2>&1 & APP=$!
  dev_wait_ready $APP "$LOG"
}
quit() { echo quit 1<>"$FIFO" 2>/dev/null; dev_wait_exit $APP; APP=; }
cmd() { echo "$*" 1<>"$FIFO"; }
# shot FILE: screenshot, waits until it is written; kept in DLTEST_SHOTS
shot() { cmd "shot $1"; for i in $(seq 1 40); do grep -qF "dev: shot written $1" "$LOG" && break; sleep 0.25; done
         [ -s "$1" ] || { bad "no screenshot $(basename "$1")"; return 1; }
         [ -n "${DLTEST_SHOTS:-}" ] && cp "$1" "$DLTEST_SHOTS/" 2>/dev/null; return 0; }
ffpids() { pgrep -f "ffmpeg.*$ROOT" ; }   # ffmpeg processes writing into the dev download folder
SRV=
cleanup() {
  [ -n "$APP" ] && { kill $APP 2>/dev/null; wait $APP 2>/dev/null; }
  { defaults delete de.sofa.dev.$INST; rm -f "$HOME/Library/Preferences/de.sofa.dev.$INST.plist"; } >/dev/null 2>&1   # this instance's settings (after the app is gone)
  [ -n "$SRV" ] && { kill $SRV 2>/dev/null; wait $SRV 2>/dev/null; }
  for p in $(ffpids); do kill $p 2>/dev/null; done
  for p in $(pgrep -f "$ROOT/orphan-test.part"); do kill -9 $p 2>/dev/null; done   # this part's only
  rm -rf "$T"
}
trap cleanup EXIT
mkdir -p "$ROOT"

# test media: a healthy 60 s file (also the verifier's good case)
"$FF" -hide_banner -loglevel error -y -f lavfi -i testsrc=size=640x360:rate=10 -f lavfi -i sine -t 60 \
      -c:v libx264 -preset ultrafast -c:a aac -movflags +faststart "$T/good.mp4"
# the Example app's media for the download sections: served at ~256 KB/s (a download takes a while)
cat > "$T/slow.py" <<'PY'
import http.server, sys, time, os
F = sys.argv[1]
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        self.send_response(200); self.send_header("Content-Length", str(os.path.getsize(F)))
        self.send_header("Content-Type", "video/mp4"); self.end_headers()
        with open(F, "rb") as f:
            while True:
                b = f.read(65536)
                if not b: break
                try: self.wfile.write(b); self.wfile.flush()
                except Exception: return
                time.sleep(0.25)
http.server.ThreadingHTTPServer(("127.0.0.1", int(sys.argv[2])), H).serve_forever()
PY
/opt/local/bin/python3.14 -I "$T/slow.py" "$T/good.mp4" $MEDIA_PORT & SRV=$!
export SOFA_EXAMPLE_MEDIA=http://127.0.0.1:$MEDIA_PORT/good.mp4

if want a; then
echo "==> 1. orphaned ffmpeg from an earlier run"
( "$FF" -nostdin -v error -re -f lavfi -i testsrc=size=320x240:rate=10 -t 300 -c:v mpeg4 -y "$ROOT/orphan-test.part999.mp4" & )
# a second orphan that ignores SIGTERM like ffmpeg stuck in a dead network read (copy of perl named ffmpeg)
PERL=$(ls /usr/bin/perl5.* 2>/dev/null | head -1); cp "$PERL" "$T/ffmpeg"
( "$T/ffmpeg" -e '$SIG{TERM}="IGNORE"; sleep 300' "$ROOT/orphan-test.part998.mp4" & )
sleep 1
S=$(pgrep -f "part998")
O=$(pgrep -f "orphan-test.part999")
[ -n "$O" ] && [ "$(ps -o ppid= -p $O | tr -d ' ')" = 1 ] && ok "orphan running (pid $O, parent launchd)" || bad "could not create the orphan"
start
dev_wait_exit $O 10   # swept at start
kill -0 $O 2>/dev/null && bad "orphan still alive" || ok "orphan killed at start"
grep -q "killing orphaned ffmpeg $O" "$LOG" && ok "logged" || bad "not logged"
# reaping runs off the main thread: Sofa is ready before the SIGTERM grace (1 s) is over
for i in $(seq 1 40); do [ -z "$S" ] || ! kill -0 $S 2>/dev/null && break; sleep 0.25; done
[ -n "$S" ] && ! kill -0 $S 2>/dev/null && grep -q "ffmpeg $S ignored SIGTERM - SIGKILL" "$LOG" && ok "SIGTERM-ignoring orphan escalated to SIGKILL" \
  || bad "SIGTERM-ignoring orphan survived (pid ${S:-none})"
# the sweep walks the download tree in the background (off the main thread): wait for its line
for i in $(seq 1 40); do grep -q 'removed [0-9]* stale partial file' "$LOG" && break; sleep 0.25; done
[ -e "$ROOT/orphan-test.part999.mp4" ] && bad "stale part file left" || ok "stale part file swept"

echo "==> 2. verifier"
cp "$T/good.mp4" "$T/bad.mp4"
S=$(stat -f %z "$T/bad.mp4")
for f in 0.2 0.5; do   # overwrite chunks of payload with garbage (container stays readable)
  dd if=/dev/urandom of="$T/bad.mp4" bs=1 count=200000 seek=$(python3 -c "print(int($S*$f))") conv=notrunc 2>/dev/null
done
# metadata cut inside a UTF-8 sequence (ffmpeg does that with long YouTube descriptions): healthy
# files were reported "unreadable" and downloaded again (2026-11-04)
"$FF" -hide_banner -loglevel error -y -i "$T/good.mp4" -c copy -metadata comment="$(printf 'ab\xc3')" "$T/latin.mp4"
# VP9 + Opus in MP4 muxed from WebM tracks like the SABR downloads: the null muxer warns about
# timestamps after -ss (ms timebase), which used to count as decode errors
"$FF" -hide_banner -loglevel error -y -f lavfi -i testsrc=size=426x240:rate=15 -t 19 -c:v libvpx-vp9 -deadline realtime -cpu-used 8 -row-mt 1 -b:v 300k "$T/v.webm"
"$FF" -hide_banner -loglevel error -y -f lavfi -i sine -t 19 -c:a libopus "$T/a.webm"
"$FF" -hide_banner -loglevel error -y -i "$T/v.webm" -i "$T/a.webm" -map 0:v:0 -map 1:a:0 -shortest -c copy -movflags +faststart "$T/vp9.mp4"
cmd "dlverify $T/good.mp4"; cmd "dlverify $T/bad.mp4"; cmd "dlverify $T/latin.mp4"; cmd "dlverify $T/vp9.mp4"
for i in $(seq 1 80); do [ "$(grep -c 'dlverify .* -> ' "$LOG")" -ge 4 ] && break; sleep 0.25; done
grep -q "dlverify vp9.mp4 -> ok" "$LOG" && ok "healthy VP9/Opus MP4 accepted" || bad "vp9.mp4 rejected: $(grep 'dlverify vp9' "$LOG")"
grep -q "dlverify latin.mp4 -> ok" "$LOG" && ok "invalid UTF-8 in metadata is no reason to reject" || bad "latin.mp4 rejected: $(grep 'dlverify latin' "$LOG")"
grep -q "dlverify good.mp4 -> ok" "$LOG" && ok "healthy file accepted" || bad "healthy file rejected: $(grep 'dlverify good' "$LOG")"
grep -q "dlverify bad.mp4 -> .*\(decode errors\|duration\|unreadable\|bitrate\)" "$LOG" && ok "corrupted file rejected ($(grep -o 'dlverify bad.mp4 -> .*' "$LOG" | cut -c20-))" \
  || bad "corrupted file accepted"

# many verifications back to back: NSTask -waitUntilExit used to hang forever on a GCD thread
for i in $(seq 1 15); do cmd "dlverify $T/good.mp4"; done
for i in $(seq 1 120); do [ "$(grep -c 'dlverify good.mp4 -> ok' "$LOG")" -ge 16 ] && break; sleep 0.5; done
[ "$(grep -c 'dlverify good.mp4 -> ok' "$LOG")" -ge 16 ] && ok "15 verifications in a row finished (no hang)" \
  || bad "verifier hung ($(grep -c 'dlverify good.mp4 -> ok' "$LOG")/16 finished)"

cmd proctest
for i in $(seq 1 20); do grep -q 'proctest status' "$LOG" && break; sleep 0.5; done
grep -q 'proctest status -2 after [12]\.' "$LOG" && ok "hung child process is killed at its timeout" \
  || bad "process timeout did not work: $(grep 'proctest' "$LOG")"

echo "==> 3. quit during a download (update handover, then a plain quit)"
running() {
  for i in $(seq 1 60); do grep -q "downloads: loading" "$LOG" && break; sleep 0.5; done
  for i in $(seq 1 40); do [ -n "$(ffpids)" ] && break; sleep 0.25; done
  [ -n "$(ffpids)" ]
}
cmd "dlget $REF"
running && ok "download ffmpeg running" || bad "download did not start: $(grep 'downloads' "$LOG" | tail -2)"
# the update handover waits half a second before exiting - ffmpeg's end is handled meanwhile
cmd updatequit; dev_wait_exit $APP; APP=
[ -z "$(ffpids)" ] && ok "no ffmpeg left after the update handover" || bad "ffmpeg survived the handover: $(ffpids)"
grep -q "downloads: FAILED $REF" "$LOG" && bad "stopping it counted as a failure" || ok "stopping it is no failure"
check "still running in the database, no attempt used" "$(/opt/local/bin/sqlite3 "$DEVDB" "select state || '/' || tries from downloads where id='$REF'")" "1/0"
# the source's spacing says "not for an hour" - an interrupted run goes on anyway (2026-11-06)
/opt/local/bin/sqlite3 "$DEVDB" "insert or replace into settings (k,v) values ('downloads.nextStart.example', strftime('%s','now') + 3600);"
start
running && ok "download resumed on the next start (despite the source's spacing)" || bad "download not resumed"
quit; sleep 1
[ -z "$(ffpids)" ] && ok "no ffmpeg left after quit" || bad "ffmpeg survived the quit: $(ffpids)"

echo "==> 4. a failed repair keeps the file and is retried"
# nothing else in the dev queue may run first (dev database only)
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where state in (0,1);"
mkdir -p "$ROOT/dev/Dev"; cp "$T/good.mp4" "$ROOT/dev/Dev/repair.mp4"
/opt/local/bin/sqlite3 "$DEVDB" "insert or replace into items (id,json) values ('$BADREF','{\"id\":\"$BADREF\",\"kind\":0,\"title\":\"Repair\",\"ref\":\"$BADREF\",\"source\":\"dev\"}');
  insert or replace into downloads (id,source,channel,path,state,progress,added) values ('$BADREF','dev','Dev','$ROOT/dev/Dev/repair.mp4',0,0,strftime('%s','now'));"
start
for i in $(seq 1 60); do grep -q "repair of $BADREF failed" "$LOG" && break; sleep 0.5; done
grep -q "repair of $BADREF failed.*retry in 15 min" "$LOG" && ok "failed repair scheduled for a retry" || bad "no retry scheduled: $(grep "$BADREF" "$LOG" | tail -2)"
[ -s "$ROOT/dev/Dev/repair.mp4" ] && ok "existing file kept" || bad "existing file lost"
cmd dlretry
# the retry starts only after the per-source spacing of starts (SOFA_SOURCE_GAP since the first attempt)
for i in $(seq 1 60); do grep -q "repair of $BADREF failed.*retry in 30 min" "$LOG" && break; sleep 0.5; done
grep -q "retrying the repair of $BADREF (attempt 2)" "$LOG" && grep -q "retry in 30 min" "$LOG" && ok "retried with a longer backoff" || bad "not retried: $(grep "$BADREF" "$LOG" | tail -2)"
quit
st=$(/opt/local/bin/sqlite3 "$DEVDB" "select state||' '||tries||' '||(retryAt > strftime('%s','now')) from downloads where id='$BADREF';")
[ "$st" = "2 2 1" ] && ok "repair pending persisted (state done, 2 tries, next attempt in the future)" || bad "unexpected record: $st"

# without a manual trigger: the next retry is scheduled for exactly when it is due (it used to wait for
# the next app start or the 3-hourly subscription check). Base delay 3 s instead of 15 min.
/opt/local/bin/sqlite3 "$DEVDB" "update downloads set tries=1, retryAt=strftime('%s','now') + 3 where id='$BADREF';"
SOFA_RETRY_BASE=3 start
for i in $(seq 1 120); do grep -q "retrying the repair of $BADREF" "$LOG" && break; sleep 0.5; done
grep -q "retrying the repair of $BADREF (attempt 2)" "$LOG" && ok "retry ran on its own when due" || bad "no scheduled retry: $(grep "$BADREF" "$LOG" | tail -2)"
quit

fi   # part a

if want b; then
echo "==> 5. YouTube download during a bot-check pause"
start
cmd "ytblock 900"; sleep 0.5
m=$(log_mark "$LOG"); cmd "dlget $YTREF"
for i in $(seq 1 20); do log_since $m "$LOG" | grep -q "source paused" && break; sleep 0.5; done
# at least the simulated 15 min; longer when a real bot check of the same IP is active (the breaker
# file is shared on purpose: no dev instance may hammer YouTube while the real app is flagged)
w=$(log_since $m "$LOG" | sed -n 's/.*source paused - next attempt in \([0-9]*\) min.*/\1/p' | tail -1)
[ -n "$w" ] && [ "$w" -ge 14 ] && ok "download waits for the end of the pause ($w min)" || bad "no wait: $(log_since $m "$LOG" | grep downloads | tail -2)"
log_since $m "$LOG" | grep -q "yt: resolve\|yt: resolved\|downloads: loading" && bad "a YouTube request was made during the pause" || ok "no YouTube request during the pause"
quit
st=$(/opt/local/bin/sqlite3 "$DEVDB" "select state||' '||tries from downloads where id='$YTREF';")
[ "$st" = "0 0" ] && ok "still queued, no attempt used up" || bad "unexpected record: $st"
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where id='$YTREF';"

echo "==> 6. storage guard (full disk)"
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where state in (0,1);"
start
cmd "dlreserve 1000000"; sleep 0.5    # 1 PB reserve: the disk counts as full
m=$(log_mark "$LOG"); cmd "dlget $REF"
for i in $(seq 1 20); do log_since $m "$LOG" | grep -q "storage full" && break; sleep 0.5; done
log_since $m "$LOG" | grep -q "storage full" && ok "full disk detected" || bad "not detected: $(log_since $m "$LOG" | grep downloads | tail -2)"
sleep 2
log_since $m "$LOG" | grep -q "downloads: loading" && bad "a download started on a full disk" || ok "no download started"
for i in $(seq 1 10); do grep -q "asking the user to make room" "$LOG" && break; sleep 0.5; done
grep -q "asking the user to make room" "$LOG" && ok "user asked to make room" || bad "no prompt"
shot "$T/full.png"
cmd "key menu"; sleep 0.5
m=$(log_mark "$LOG"); cmd "dlreserve 10"   # room again
for i in $(seq 1 60); do log_since $m "$LOG" | grep -q "downloads: loading" && break; sleep 0.5; done
log_since $m "$LOG" | grep -q "storage free again" && log_since $m "$LOG" | grep -q "downloads: loading" \
  && ok "continues by itself once there is room" || bad "did not continue: $(log_since $m "$LOG" | grep downloads | tail -2)"
for i in $(seq 1 40); do [ -n "$(ffpids)" ] && break; sleep 0.25; done   # the download is running
m=$(log_mark "$LOG"); cmd "dlreserve 1000000"   # the disk fills up during the run
for i in $(seq 1 20); do log_since $m "$LOG" | grep -q "deferred" && break; sleep 0.5; done
log_since $m "$LOG" | grep -q "disk nearly full while loading" && ok "running download stopped" || bad "running download not stopped"
sleep 1
[ -z "$(ffpids)" ] && ok "ffmpeg ended" || bad "ffmpeg still running"
quit
st=$(/opt/local/bin/sqlite3 "$DEVDB" "select state||' '||tries from downloads where id='$REF';")
[ "$st" = "0 0" ] && ok "still queued, no attempt used up" || bad "unexpected record: $st"
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where id='$REF';"

echo "==> 7. Platz schaffen: only replaceable videos are deleted"
mkdir -p "$ROOT/dev/Room"
for v in online gone kept; do cp "$T/good.mp4" "$ROOT/dev/Room/$v.mp4"; done
now=$(date +%s)
for v in online:1:0 gone:0:0 kept:1:1; do
  IFS=: read name on keep <<< "$v"
  /opt/local/bin/sqlite3 "$DEVDB" "insert or replace into items (id,json) values ('room:$name','{\"id\":\"room:$name\",\"kind\":0,\"title\":\"Room $name\",\"ref\":\"room:$name\",\"source\":\"dev\",\"channel\":\"Room\"}');
    insert or replace into downloads (id,source,channel,path,state,progress,bytes,added,keep,online,onlineAt) values ('room:$name','dev','Room','$ROOT/dev/Room/$name.mp4',2,1,$(stat -f %z "$T/good.mp4"),$now,$keep,$on,$now);"
  /opt/local/bin/sqlite3 "$DEVDB" "insert or replace into progress (id,pos,dur,watched,updated,source) values ('room:$name',60,60,1,$now,'dev');"
done
start
cmd "open room"; sleep 2
shot "$T/room.png"
cmd "key select"; sleep 1        # first tile of "Aufräumen": "Gesehen"
shot "$T/room-confirm.png"
cmd "key down"; sleep 0.3; cmd "key select"; sleep 1.5   # "Ja, 1 Video löschen"
grep -q "Platz schaffen: 1 deleted" "$LOG" && ok "bulk deletion ran (1 video)" || bad "no bulk deletion: $(grep -i 'platz\|downloads' "$LOG" | tail -3)"
[ ! -e "$ROOT/dev/Room/online.mp4" ] && ok "the online video was deleted" || bad "online video still there"
[ -e "$ROOT/dev/Room/gone.mp4" ] && ok "the video that is no longer online stays" || bad "irreplaceable video deleted!"
[ -e "$ROOT/dev/Room/kept.mp4" ] && ok "the kept video stays" || bad "kept video deleted!"
quit

echo "==> 4b. a failed download: a subscription episode is retried later, a manual one gives up"
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where state in (0,1);
  insert or replace into items (id,json) values
    ('example:8','{\"id\":\"example:8\",\"kind\":0,\"title\":\"Abo-Folge\",\"source\":\"example\"}'),
    ('example:9','{\"id\":\"example:9\",\"kind\":0,\"title\":\"Manuell\",\"source\":\"example\"}');
  insert into downloads (id,source,channel,state,progress,added,sub) values
    ('example:8','example','Dev',0,0,strftime('%s','now'),'exampleshow:demo'),
    ('example:9','example','Dev',0,0,strftime('%s','now'),NULL);"
start
for i in $(seq 1 80); do [ "$(grep -c 'downloads: FAILED example:[89]' "$LOG")" -ge 2 ] && break; sleep 0.5; done
quit
st=$(/opt/local/bin/sqlite3 "$DEVDB" "select group_concat(id||'='||state||'/'||tries||'/'||(retryAt > strftime('%s','now')), ' ') from (select * from downloads where id in ('example:8','example:9') order by id);")
[ "$st" = "example:8=5/1/1 example:9=3/1/1" ] && ok "subscription episode: retried later (state 5, next attempt set); manual: failed" || bad "unexpected: $st"
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where id in ('example:8','example:9');"
# the spacing of starts survives a restart (2026-11-06: an update restart started the next YouTube
# download at once): the next allowed start of the source is stored
nx=$(/opt/local/bin/sqlite3 "$DEVDB" "select v > strftime('%s','now') - 60 from settings where k='downloads.nextStart.example'")
check "next start of the source stored" "$nx" "1"

fi   # part b

[ $fail = 0 ] && echo "==> all ok" || echo "==> FAILED"
exit $fail

#!/bin/bash
# test-downloads -- robustness regression tests for the download layer, in an invisible dev instance
# (a fresh data directory per run: database + download folder, removed at exit). No YouTube requests.
#
# Every download fills the media store (docs/media-store.md) - no files, no ffmpeg. Checks:
#   0. a hung child process (SFRunProcess, used by the updater) is killed at its timeout
#   5. during a YouTube bot-check pause a queued YouTube download waits without any request
#   6. storage guard: below the reserve no download starts and a running one stops - both stay
#      queued without using an attempt, the user is asked to make room, and the queue continues
#      by itself once there is room (user 2026-11-05: never fill the disk, never delete by itself)
#   7. "Platz schaffen": bulk deletion removes only what is still online and not "Behalten";
#      a video that is no longer online and a kept one stay
#   8. media store downloads (the Example app fills like YouTube, SOFA_EXAMPLE_FILL): a fill completes
#      as a download (pinned bytes); a quit mid-fill uses no attempt; a partly loaded video's tile says
#      "geladen" and "Herunterladen" says what is missing ("noch X MB"), the fill fetches only the rest;
#      tracks gone from outside are noticed at start and filled again; removal frees them
#   8c. a source's progressive file (mediatheks) through the media proxy: the download fills the store
#      by ranges (no ffmpeg); the timeline shows what is on disk (exact, the file's moov sample tables);
#      it plays from the store, "Online abspielen" (info panel) switches to the source, and it plays
#      from the store without its source
#   8d. an HLS source (ORF) through the media proxy: a master with two variants, AES-128 segments and
#      their key - the player gets one variant, the one a download takes (lavf probes every variant
#      before playing); playing shows what is on disk as a shade on the timeline (exact segments); the
#      download finds what playback kept, then plays from the store without its source, shaded end to end
#   8b. pre-buffering: a subscription episode filled into the store expires (14 days, or 3 days after
#      it was watched) - dismissed, its bytes stay as plain buffer; "Herunterladen" on a pre-buffered
#      episode keeps it without loading again
#   tools/test-downloads   the parts side by side, each with its own instance and media server
#                          (part a: 0, 5, 6; part b: 4b, 8, 8b; part c: 8c, 8d; part d: 7 - its own
#                          fresh data, and the parts take about as long); DLTEST_PART=a|b|c|d
#                          runs one part here
# Exit code 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
. "$SRC/tools/lib/dev-instance.sh"
BIN="$SRC/build/SofaDev.app/Contents/MacOS/Sofa"
PART=${DLTEST_PART:-}
if [ -z "$PART" ]; then   # all parts at once; output part by part
  make -C "$SRC" >/dev/null || exit 1
  O="$(mktemp -d "${TMPDIR:-/tmp}/sofa-dlparts.XXXXXX")"
  DLTEST_PART=a "$0" > "$O/a" 2>&1 & A=$!
  DLTEST_PART=b "$0" > "$O/b" 2>&1 & B=$!
  DLTEST_PART=c "$0" > "$O/c" 2>&1 & C=$!
  DLTEST_PART=d "$0" > "$O/d" 2>&1 & D=$!
  wait $A; ra=$?; wait $B; rb=$?; wait $C; rc=$?; wait $D; rd=$?
  grep -hv '^==> all ok$\|^==> FAILED$' "$O/a" "$O/b" "$O/c" "$O/d"
  rm -rf "$O"
  [ $ra = 0 ] && [ $rb = 0 ] && [ $rc = 0 ] && [ $rd = 0 ] && { echo "==> all ok"; exit 0; } || { echo "==> FAILED"; exit 1; }
fi
want() { [ "$PART" = "$1" ]; }
INST=dltest-$PART
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-dltest.XXXXXX")"
trap 'rm -rf "${T:?}"' EXIT   # until the full cleanup below takes over (a failed build exits before it)
export SOFA_DATA_DIR="$T/data"   # the dev instance's whole state (SFSetDevInstance)
# the instance keeps its log and dev FIFO in its data directory (SFDevPrivateDir): gone with $T
mkdir -p "$SOFA_DATA_DIR"; FIFO="$SOFA_DATA_DIR/dev.fifo" LOG="$SOFA_DATA_DIR/sofa.log"
export SOFA_SOURCE_GAP=3         # per-source spacing of download starts: 3 s instead of 30
ROOT="$SOFA_DATA_DIR/Downloads"
DEVDB="$SOFA_DATA_DIR/sofa.db"
FF=/opt/local/bin/ffmpeg   # test media only (Sofa itself has no ffmpeg)
# Offline: the Example app serves its items from a local, throttled HTTP server (SOFA_EXAMPLE_MEDIA);
# YouTube is registered for section 5 only (and stays paused there).
export SOFA_ONLY_APPS=example,youtube
REF=example:1      # downloadable (the Example app fills it piece by piece, SOFA_EXAMPLE_FILL)
YTREF=yt:jNQXAC9IVRw   # never actually requested (section 5 keeps YouTube paused)
# a failure keeps the instance's log as it is now (DLTEST_SHOTS, test-all): a flake under load is
# readable afterwards - the next start empties the log
fail=0; nfail=0; ok() { echo "  ok    $*"; }
bad() { echo "  FAIL  $*"; fail=1; nfail=$((nfail + 1))
        [ -n "${DLTEST_SHOTS:-}" ] && [ -s "$LOG" ] && cp "$LOG" "$DLTEST_SHOTS/part-$PART-fail$nfail.log" 2>/dev/null; return 0; }
check() { [ "$2" = "$3" ] && ok "$1" || bad "$1: got '$2', want '$3'"; }   # check NAME GOT WANT

make -C "$SRC" >/dev/null || exit 1
APP=
start() {
  : > "$LOG"
  "$BIN" --dev --instance $INST >/dev/null 2>&1 & APP=$!
  dev_wait_ready $APP "$LOG"
}
quit() { echo quit 1<>"$FIFO" 2>/dev/null; dev_wait_exit $APP; APP=; }
cmd() { echo "$*" 1<>"$FIFO"; }
# shot FILE: screenshot, waits until it is written; kept in DLTEST_SHOTS
shot() { cmd "shot $1"; for i in $(seq 1 40); do grep -qF "dev: shot written $1" "$LOG" && break; sleep 0.25; done
         [ -s "$1" ] || { bad "no screenshot $(basename "$1")"; return 1; }
         [ -n "${DLTEST_SHOTS:-}" ] && cp "$1" "$DLTEST_SHOTS/" 2>/dev/null; return 0; }
SQ() { /opt/local/bin/sqlite3 "$DEVDB" "$@"; }
# the subscription the episodes below belong to, as the app keeps it: a follow and its auto-download
# (schema 18 checks the reference; since = now: it adds no older episodes of its own)
DEMOSUB="insert or ignore into follows (id,source,title,added) values ('exampleshow:demo','example','Demo',strftime('%s','now'));
  insert or ignore into subscriptions (id,keepDays,since,added) values ('exampleshow:demo',90,strftime('%s','now'),strftime('%s','now'));"
SS() { /opt/local/bin/sqlite3 "$ROOT/.store/store.db" "$@"; }
SRV=
cleanup() {
  [ -n "$APP" ] && { kill $APP 2>/dev/null; wait $APP 2>/dev/null; }
  { defaults delete de.sofa.dev.$INST; rm -f "$HOME/Library/Preferences/de.sofa.dev.$INST.plist"; } >/dev/null 2>&1   # this instance's settings (after the app is gone)
  [ -n "$SRV" ] && { kill $SRV 2>/dev/null; wait $SRV 2>/dev/null; }
  rm -rf "$T"
}
trap cleanup EXIT
mkdir -p "$ROOT"

# test media: a 60 s file
"$FF" -hide_banner -loglevel error -y -f lavfi -i testsrc=size=640x360:rate=10 -f lavfi -i sine -t 60 \
      -c:v libx264 -preset ultrafast -c:a aac -movflags +faststart "$T/good.mp4"
# the Example app's media for the download sections: served at ~256 KB/s (a download takes a while)
cat > "$T/slow.py" <<'PY'
import http.server, sys, time, os
F = sys.argv[1]
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        size = os.path.getsize(F); start, end = 0, size   # a single "bytes=a-[b]" range: 206 (the media proxy reads by ranges)
        r = self.headers.get("Range", "")
        if r.startswith("bytes=") and "," not in r:
            a, _, z = r[6:].partition("-"); start = int(a or 0); end = min(size, int(z) + 1) if z else size
            self.send_response(206); self.send_header("Content-Range", "bytes %d-%d/%d" % (start, end - 1, size))
        else: self.send_response(200)
        self.send_header("Content-Length", str(end - start))
        self.send_header("Content-Type", "video/mp4"); self.end_headers()
        with open(F, "rb") as f:
            f.seek(start); left = end - start
            while left > 0:
                b = f.read(min(65536, left)); left -= len(b)
                if not b: break
                try: self.wfile.write(b); self.wfile.flush()
                except Exception: return
                time.sleep(0.25)
s = http.server.ThreadingHTTPServer(("127.0.0.1", 0), H)   # a free port, written once listening
with open(sys.argv[2] + ".tmp", "w") as f: f.write(str(s.server_address[1]))
os.rename(sys.argv[2] + ".tmp", sys.argv[2])
s.serve_forever()
PY
# a free port (fixed ones collided with test-playback's servers under test-all), awaited before use
/opt/local/bin/python3.14 -I "$T/slow.py" "$T/good.mp4" "$T/media.port" & SRV=$!
for i in $(seq 1 150); do [ -s "$T/media.port" ] && break; sleep 0.1; done
MEDIA_PORT=$(cat "$T/media.port" 2>/dev/null)
export SOFA_EXAMPLE_MEDIA=http://127.0.0.1:$MEDIA_PORT/good.mp4

if want a; then
echo "==> 0. process timeout"
start
cmd proctest
for i in $(seq 1 20); do grep -q 'proctest status' "$LOG" && break; sleep 0.5; done
grep -q 'proctest status -2 after [12]\.' "$LOG" && ok "hung child process is killed at its timeout" \
  || bad "process timeout did not work: $(grep 'proctest' "$LOG")"
quit

echo "==> 5. YouTube download during a bot-check pause"
start
cmd "ytblock 900"; sleep 0.5
m=$(log_mark "$LOG"); cmd "dlget $YTREF"
for i in $(seq 1 20); do log_since $m "$LOG" | grep -q "source paused" && break; sleep 0.5; done
# at least the simulated 15 min; longer when a real bot check of the same IP is active (the breaker
# file is shared on purpose: no dev instance may hammer YouTube while the real app is flagged)
w=$(log_since $m "$LOG" | sed -n 's/.*source paused - next attempt in \([0-9]*\) min.*/\1/p' | tail -1)
[ -n "$w" ] && [ "$w" -ge 14 ] && ok "download waits for the end of the pause ($w min)" || bad "no wait: $(log_since $m "$LOG" | grep downloads | tail -2)"
log_since $m "$LOG" | grep -q "yt: resolve\|yt: resolved\|downloads: loading" && bad "a YouTube request was made during the pause" || ok "no YouTube request during the pause"
quit
st=$(/opt/local/bin/sqlite3 "$DEVDB" "select state||' '||tries from downloads where id='$YTREF';")
[ "$st" = "0 0" ] && ok "still queued, no attempt used up" || bad "unexpected record: $st"
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where id='$YTREF';"

echo "==> 6. storage guard (full disk)"
SQ "delete from downloads where state in (0,1);"
SOFA_EXAMPLE_FILL=1 start   # a fill of 8 s: long enough to stop it on the way
cmd "dlreserve 1000000"; sleep 0.5    # 1 PB reserve: the disk counts as full
m=$(log_mark "$LOG"); cmd "dlget $REF"
for i in $(seq 1 20); do log_since $m "$LOG" | grep -q "storage full" && break; sleep 0.5; done
log_since $m "$LOG" | grep -q "storage full" && ok "full disk detected" || bad "not detected: $(log_since $m "$LOG" | grep downloads | tail -2)"
sleep 2
log_since $m "$LOG" | grep -q "downloads: loading" && bad "a download started on a full disk" || ok "no download started"
for i in $(seq 1 10); do grep -q "asking the user to make room" "$LOG" && break; sleep 0.5; done
grep -q "asking the user to make room" "$LOG" && ok "user asked to make room" || bad "no prompt"
shot "$T/full.png"
cmd "key menu"; sleep 0.5
m=$(log_mark "$LOG"); cmd "dlreserve 10"   # room again
for i in $(seq 1 60); do log_since $m "$LOG" | grep -q "example: filled $REF piece" && break; sleep 0.25; done
log_since $m "$LOG" | grep -q "storage free again" && log_since $m "$LOG" | grep -q "downloads: loading" \
  && ok "continues by itself once there is room" || bad "did not continue: $(log_since $m "$LOG" | grep downloads | tail -2)"
m=$(log_mark "$LOG"); cmd "dlreserve 1000000"   # the disk fills up during the fill
for i in $(seq 1 20); do log_since $m "$LOG" | grep -q "deferred" && break; sleep 0.5; done
log_since $m "$LOG" | grep -q "disk nearly full while loading" && ok "running download stopped" || bad "running download not stopped"
m=$(log_mark "$LOG"); sleep 2.5
log_since $m "$LOG" | grep -q "example: filled" && bad "the fill went on" || ok "the fill ended"
quit
check "still queued, no attempt used up" "$(SQ "select state||' '||tries from downloads where id='$REF';")" "0 0"
SQ "delete from downloads where id='$REF';"

fi   # part a

if want b; then
echo "==> 4b. a failed download: a subscription episode is retried later, a manual one gives up"
start; quit   # the database (the part's first section: nothing before it made one)
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where state in (0,1); $DEMOSUB
  insert or replace into items (id,json) values
    ('example:8','{\"id\":\"example:8\",\"kind\":0,\"title\":\"Abo-Folge\",\"source\":\"example\"}'),
    ('example:9','{\"id\":\"example:9\",\"kind\":0,\"title\":\"Manuell\",\"source\":\"example\"}');
  insert into downloads (id,source,channel,state,progress,added,sub) values
    ('example:8','example','Dev',0,0,strftime('%s','now'),'exampleshow:demo'),
    ('example:9','example','Dev',0,0,strftime('%s','now'),NULL);"
start
for i in $(seq 1 80); do [ "$(grep -c 'downloads: FAILED example:[89]' "$LOG")" -ge 2 ] && break; sleep 0.5; done
quit
st=$(/opt/local/bin/sqlite3 "$DEVDB" "select group_concat(id||'='||state||'/'||tries||'/'||(retryAt > strftime('%s','now')), ' ') from (select * from downloads where id in ('example:8','example:9') order by id);")
[ "$st" = "example:8=5/1/1 example:9=3/1/1" ] && ok "subscription episode: retried later (state 5, next attempt set); manual: failed" || bad "unexpected: $st"
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where id in ('example:8','example:9');"
# the spacing of starts survives a restart (2026-11-06: an update restart started the next YouTube
# download at once): the next allowed start of the source is stored
nx=$(/opt/local/bin/sqlite3 "$DEVDB" "select v > strftime('%s','now') - 60 from settings where k='downloads.nextStart.example'")
check "next start of the source stored" "$nx" "1"

echo "==> 8. downloads into the media store"
export SOFA_EXAMPLE_FILL=0.4   # the Example app fills (8 pieces, 0.4 s apart)
start
cmd "dlget $REF"
for i in $(seq 1 40); do grep -q "example: filled $REF piece 2" "$LOG" && break; sleep 0.25; done
cmd updatequit; dev_wait_exit $APP; APP=
check "quit mid-fill: still running, no attempt used" "$(SQ "select state || '/' || tries from downloads where id='$REF'")" "1/0"
# the download given up meanwhile: its pieces stay as buffer (a tile says "geladen"), and
# "Herunterladen" again says what is still missing
SQ "delete from downloads where id='$REF'"
start
chip() { m=$(wc -l < "$LOG"); cmd "chip $1"; for i in $(seq 1 20); do tail -n +$((m + 1)) "$LOG" | grep -q "dev: chip $1 = " && break; sleep 0.1; done
         tail -n +$((m + 1)) "$LOG" | sed -n "s/.*dev: chip $1 = //p" | tail -1; }
check "a partly loaded video: its tile says geladen" "$(chip $REF)" "geladen"
cmd "dlget $REF"
for i in $(seq 1 40); do grep -q "dev: download $REF - " "$LOG" && break; sleep 0.25; done
grep -q "dev: download $REF - Wird heruntergeladen – noch [1-7] MB, der Rest ist schon geladen" "$LOG" && ok "Herunterladen on a partly loaded video says what is missing" \
  || bad "no missing size: $(grep "dev: download $REF" "$LOG")"
for i in $(seq 1 60); do grep -q "downloads: done $REF" "$LOG" && break; sleep 0.25; done
grep -q "downloads: done $REF" "$LOG" && ok "fill resumed and finished" || bad "fill not finished: $(grep "$REF\|downloads" "$LOG" | tail -3)"
grep -q "example: filled $REF piece 0" "$LOG" && bad "the resume fetched stored pieces again" || ok "the resume fetched only the rest"
check "a download: its tile has the download mark" "$(chip $REF)" "↓ Offline"
check "done" "$(SQ "select state from downloads where id='$REF'")" "2"
check "its track in the store, complete" "$(SS "select count(*) || '/' || sum(e.end - e.start) from tracks t join extents e on e.track = t.id where t.item='$REF'")" "1/8388608"
quit
# the second block file (pieces 4-7) deleted from outside: noticed at start, queued again, only the
# missing part filled
rm -f "$ROOT/.store/"[0-9]*/1
start
for i in $(seq 1 60); do grep -q "downloads: done $REF" "$LOG" && break; sleep 0.25; done
grep -q "$REF is incomplete in the media store" "$LOG" && ok "an incomplete store download noticed at start" || bad "not noticed: $(grep "$REF" "$LOG" | tail -2)"
pieces=$(grep -o "example: filled $REF piece [0-9]" "$LOG" | awk '{print $NF}' | tr '\n' ' ')
check "only the lost block filled again (pieces 4-7)" "$pieces" "4 5 6 7 "
cmd "dlremove $REF"
for i in $(seq 1 20); do grep -q "dev: removed download $REF" "$LOG" && break; sleep 0.25; done
check "removal frees its tracks" "$(SS "select count(*) from tracks where item='$REF'")/$(SQ "select count(*) from downloads where id='$REF'")" "0/0"
quit

echo "==> 8b. pre-buffering"
SQ "$DEMOSUB insert or replace into items (id,json) values ('example:3','{\"id\":\"example:3\",\"kind\":0,\"title\":\"Folge\",\"source\":\"example\"}'),
    ('example:4','{\"id\":\"example:4\",\"kind\":0,\"title\":\"Gesehen\",\"source\":\"example\"}');
    insert into downloads (id,source,channel,state,progress,added,sub) values
    ('example:3','example','Dev',0,0,strftime('%s','now'),'exampleshow:demo'),
    ('example:4','example','Dev',0,0,strftime('%s','now') + 1,'exampleshow:demo');"
start
for i in $(seq 1 80); do [ "$(grep -c 'downloads: done example:[34]' "$LOG")" -ge 2 ] && break; sleep 0.25; done
check "subscription episodes pre-buffered: expiry in 14 days" \
  "$(SQ "select group_concat(id || '=' || (abs(expires - strftime('%s','now') - 14*86400) < 120), ' ') from (select * from downloads where id in ('example:3','example:4') order by id)")" \
  "example:3=1 example:4=1"
check "a pre-buffered episode: its tile says geladen, not downloaded" "$(chip example:3)" "geladen"
quit
# example:3 past its expiry; example:4 watched four days ago (3 days after watching)
SQ "update downloads set expires = strftime('%s','now') - 1 where id='example:3';
    insert or replace into progress (id,pos,dur,watched,updated,source) values ('example:4',60,60,1,strftime('%s','now') - 4*86400,'example');"
start
for i in $(seq 1 40); do [ "$(grep -c 'pre-buffered example:[34] expired' "$LOG")" -ge 2 ] && break; sleep 0.25; done
grep -q "pre-buffered example:3 expired (not watched in time)" "$LOG" && grep -q "pre-buffered example:4 expired (watched)" "$LOG" \
  && ok "expired: past the 14 days, and 3 days after watching" || bad "not expired: $(grep 'pre-buffered\|example:[34]' "$LOG" | tail -3)"
check "expired: dismissed (not fetched again), bytes left as buffer" \
  "$(SQ "select group_concat(state, ' ') from downloads where id in ('example:3','example:4')")/$(SS "select count(*) from tracks where item in ('example:3','example:4')")" "4 4/2"
check "expired: its tile still says geladen (the bytes are there)" "$(chip example:3)" "geladen"
# unfollowing ends the auto-download in one transaction: its episodes - the deleted ones too - let
# go of the subscription, else the commit fails on the reference (review 2026-11-09) and leaves the
# connection in an open transaction that swallows every later write
m=$(wc -l < "$LOG"); cmd "unfollow exampleshow:demo"
for i in $(seq 1 40); do tail -n +$((m + 1)) "$LOG" | grep -q "dev: unfollowed" && break; sleep 0.25; done
check "unfollowed: subscription gone, its episodes (deleted ones too) let go of it" \
  "$(SQ "select count(*) from subscriptions where id='exampleshow:demo'")/$(SQ "select count(*) from downloads where sub='exampleshow:demo'")" "0/0"
tail -n +$((m + 1)) "$LOG" | grep -q "rolled back" && bad "the unfollow was rolled back" || ok "the unfollow committed"
m=$(wc -l < "$LOG"); cmd "unfollow example:never-followed"; cmd "follows"
for i in $(seq 1 40); do tail -n +$((m + 1)) "$LOG" | grep -q "dev: follows end" && break; sleep 0.25; done
check "a write after it commits (no transaction left open)" "$(SQ "select count(*) from follows where id='exampleshow:demo'")" "0"
# "Herunterladen" on a pre-buffered episode: kept, nothing loaded again
SQ "$DEMOSUB insert or replace into items (id,json) values ('example:1','{\"id\":\"example:1\",\"kind\":0,\"title\":\"Testbild\",\"source\":\"example\"}');
    insert or replace into downloads (id,source,channel,state,progress,added,sub) values ('example:1','example','Dev',0,0,strftime('%s','now'),'exampleshow:demo');"
quit; start
for i in $(seq 1 60); do grep -q "downloads: done example:1" "$LOG" && break; sleep 0.25; done
m=$(wc -l < "$LOG")
cmd "dlget example:1"
for i in $(seq 1 20); do grep -q "example:1 pre-buffered -> downloaded" "$LOG" && break; sleep 0.25; done
check "Herunterladen on a pre-buffered episode: kept, no expiry" "$(SQ "select state || '/' || coalesce(sub, '-') || '/' || coalesce(expires, '-') from downloads where id='example:1'")" "2/-/-"
sleep 1; tail -n +$((m + 1)) "$LOG" | grep -q "example: filled example:1" && bad "it was loaded again" || ok "nothing loaded again"
quit

fi   # part b

if want c; then
echo "==> 8c. a progressive file through the media proxy"
export SOFA_PROXY_LOOPBACK=1   # the Example app's file (local server) counts as a source's
start
cmd "dlget example:2"
for i in $(seq 1 120); do grep -q "downloads: done example:2\|downloads: FAILED example:2" "$LOG" && break; sleep 0.25; done
grep -q "media-proxy: filling example:2" "$LOG" && grep -q "downloads: done example:2" "$LOG" && ok "filled through the proxy" \
  || bad "not filled: $(grep 'example:2\|media-proxy' "$LOG" | tail -3)"
pgrep -f "ffmpeg.*example" >/dev/null && bad "an ffmpeg ran" || ok "no ffmpeg"
SIZE=$(stat -f %z "$T/good.mp4")
check "a download of the whole file" "$(SQ "select state from downloads where id='example:2'")/$(SS "select sum(e.end - e.start) from tracks t join extents e on e.track = t.id where t.item='example:2'")" "2/$SIZE"
check "its manifest: a file item" "$(SS "select json_extract(json, '$.kind') || '/' || json_extract(json, '$.total') from manifests where item='example:2'")" "file/$SIZE"
# playing (online) buffers through the proxy: what the player read is on disk afterwards
m=$(wc -l < "$LOG")
cmd "play example:3"
for i in $(seq 1 60); do tail -n +$((m + 1)) "$LOG" | grep -q "mpv: first frame" && break; sleep 0.25; done
sleep 1
n=$(SS "select coalesce(sum(e.end - e.start), 0) from tracks t join extents e on e.track = t.id where t.item='example:3' and t.kind='file'")
[ "${n:-0}" -gt 0 ] && ok "playback buffered through the proxy ($n bytes on disk)" || bad "nothing buffered while playing: $(SS "select group_concat(key || ' ' || kind) from tracks") / $(tail -n +$((m + 1)) "$LOG" | grep 'player\|media-proxy\|media-store\|mpv' | head -12)"
cmd "key select"   # the bar: the timeline shows what is on disk (the file's moov sample tables)
for i in $(seq 1 40); do tail -n +$((m + 1)) "$LOG" | grep -q "player: stored [1-9]" && break; sleep 0.25; done
tail -n +$((m + 1)) "$LOG" | grep -q "player: stored [1-9][0-9]* range(s), [1-9][0-9]* of 60 s" && ok "the timeline shows what playback put on disk ($(tail -n +$((m + 1)) "$LOG" | grep -o 'stored [0-9].*' | tail -1))" \
  || bad "no stored shade for the file: $(tail -n +$((m + 1)) "$LOG" | grep 'player: stored' | tail -1)"
cmd "key menu"; sleep 0.5
# a download plays from the store; "Online abspielen" (info panel) switches to the source at the same position
m=$(wc -l < "$LOG")
cmd "play example:2"
for i in $(seq 1 60); do tail -n +$((m + 1)) "$LOG" | grep -q "mpv: first frame" && break; sleep 0.25; done
tail -n +$((m + 1)) "$LOG" | grep -q "player: play .* from the store" && ok "a download plays from the store" || bad "not from the store: $(tail -n +$((m + 1)) "$LOG" | grep 'player:' | tail -2)"
cmd "key select"
for i in $(seq 1 40); do tail -n +$((m + 1)) "$LOG" | grep -q "player: stored 1 range" && break; sleep 0.25; done
tail -n +$((m + 1)) "$LOG" | grep -q "player: stored 1 range(s), 60 of 60 s" && ok "a download: the timeline shaded end to end" \
  || bad "stored shade of the download: $(tail -n +$((m + 1)) "$LOG" | grep 'player: stored' | tail -1)"
m=$(wc -l < "$LOG"); cmd "key selecthold"
for i in $(seq 1 40); do tail -n +$((m + 1)) "$LOG" | grep -q "info: panel for" && break; sleep 0.25; done
cmd "key select"   # first action of a downloaded video: "Online abspielen"
for i in $(seq 1 60); do tail -n +$((m + 1)) "$LOG" | grep -q "mpv: first frame" && break; sleep 0.25; done
tail -n +$((m + 1)) "$LOG" | grep -q "Download -> online" && tail -n +$((m + 1)) "$LOG" | grep "player: play " | grep -qv "from the store" \
  && ok "Online abspielen: the source plays" || bad "no switch to the source: $(tail -n +$((m + 1)) "$LOG" | grep 'player:\|info:' | tail -3)"
cmd "key menu"; sleep 0.5
# it plays from the store without its source
kill $SRV; wait $SRV 2>/dev/null; SRV=
m=$(wc -l < "$LOG")
cmd "play example:2"
for i in $(seq 1 60); do tail -n +$((m + 1)) "$LOG" | grep -q "mpv: first frame" && break; sleep 0.25; done
tail -n +$((m + 1)) "$LOG" | grep -q "mpv: first frame" && ok "plays from the store with its source gone" \
  || bad "no playback from the store: $(tail -n +$((m + 1)) "$LOG" | grep 'player\|mpv' | tail -3)"
quit

echo "==> 8d. an HLS source through the media proxy"
H="$T/hls"; mkdir -p "$H"; head -c 16 /dev/urandom > "$H/enc.key"
printf '../enc.key\n%s\n' "$H/enc.key" > "$T/keyinfo"
( cd "$H" && "$FF" -hide_banner -loglevel error -y -f lavfi -i testsrc=size=640x360:rate=10 -f lavfi -i sine -t 12 \
    -map 0:v -map 1:a -map 0:v -map 1:a -c:v libx264 -preset ultrafast -g 20 -c:a aac -s:v:0 640x360 -b:v:0 600k -s:v:1 320x180 -b:v:1 200k \
    -var_stream_map "v:0,a:0 v:1,a:1" -master_pl_name master.m3u8 -hls_time 4 -hls_playlist_type vod \
    -hls_key_info_file "$T/keyinfo" -hls_segment_filename "v%v/seg%d.ts" "v%v/index.m3u8" )
/opt/local/bin/python3.14 -I -c "
import http.server, functools, os, sys
h = functools.partial(http.server.SimpleHTTPRequestHandler, directory=sys.argv[1])
http.server.SimpleHTTPRequestHandler.log_message = lambda *a: None
s = http.server.ThreadingHTTPServer(('127.0.0.1', 0), h)
open(sys.argv[2] + '.tmp', 'w').write(str(s.server_address[1])); os.rename(sys.argv[2] + '.tmp', sys.argv[2])
s.serve_forever()" "$H" "$T/hls.port" & HSRV=$!
for i in $(seq 1 100); do [ -s "$T/hls.port" ] && break; sleep 0.1; done
export SOFA_EXAMPLE_MEDIA=http://127.0.0.1:$(cat "$T/hls.port")/master.m3u8
start
# playing online: what mpv fetched of its variant is on disk, the timeline shows it (exact segments)
m=$(wc -l < "$LOG")
cmd "play example:4"
for i in $(seq 1 60); do tail -n +$((m + 1)) "$LOG" | grep -q "mpv: first frame" && break; sleep 0.25; done
sleep 1; cmd "key select"   # the bar
for i in $(seq 1 40); do tail -n +$((m + 1)) "$LOG" | grep -q "player: stored [1-9]" && break; sleep 0.25; done
tail -n +$((m + 1)) "$LOG" | grep -q "player: stored [1-9] range(s), [1-9][0-9]* of 1[12] s" && ok "the timeline shows what playback put on disk ($(tail -n +$((m + 1)) "$LOG" | grep -o 'stored [0-9].*' | tail -1))" \
  || bad "no stored shade while playing: $(tail -n +$((m + 1)) "$LOG" | grep 'player: stored\|player: play' | tail -2)"
cmd "key menu"; sleep 0.5
# the player gets one variant (the one a download takes, ChooseVariant): lavf probed every variant's
# first segments before playing - an ORF start took 13-21 s (2026-11-08)
v0=$(( $(grep -c EXTINF "$H/v0/index.m3u8") + 1 ))
check "playback read one variant (its segments and key, nothing of the other)" "$(SS "select count(*) <= $v0 from tracks where item='example:4'")" "1"
cmd "dlget example:4"
for i in $(seq 1 160); do grep -q "downloads: done example:4\|downloads: FAILED example:4" "$LOG" && break; sleep 0.25; done
grep -q "media-proxy: filling example:4 (HLS, $v0 resources, $v0 on disk already)" "$LOG" && ok "the download found everything playback kept (the same variant)" \
  || bad "the download did not reuse playback's segments: $(grep 'media-proxy: filling example:4' "$LOG")"
grep -q "media-proxy: filling example:4 (HLS" "$LOG" && grep -q "downloads: done example:4" "$LOG" && ok "HLS filled through the proxy" \
  || bad "HLS not filled: $(grep 'example:4\|media-proxy' "$LOG" | tail -3)"
check "the better variant, its segments and key are the manifest's required tracks" \
  "$(SS "select json_extract(json, '$.kind') || '/' || json_array_length(json, '$.required') || '/' || json_extract(json, '$.bandwidth') from manifests where item='example:4'")" \
  "hls/$(( $(grep -c EXTINF "$H/v0/index.m3u8") + 1 ))/$(grep -o 'BANDWIDTH=[0-9]*' "$H/master.m3u8" | cut -d= -f2 | sort -n | tail -1)"
check "a download" "$(SQ "select state from downloads where id='example:4'")" "2"
kill $HSRV; wait $HSRV 2>/dev/null
m=$(wc -l < "$LOG")
cmd "play example:4"
for i in $(seq 1 60); do tail -n +$((m + 1)) "$LOG" | grep -q "mpv: first frame" && break; sleep 0.25; done
tail -n +$((m + 1)) "$LOG" | grep -q "mpv: first frame" && ok "the HLS item plays from the store with its source gone (decrypted with the stored key)" \
  || bad "no HLS playback from the store: $(tail -n +$((m + 1)) "$LOG" | grep 'player\|mpv' | tail -4)"
cmd "key select"
for i in $(seq 1 40); do tail -n +$((m + 1)) "$LOG" | grep -q "player: stored 1 range" && break; sleep 0.25; done
tail -n +$((m + 1)) "$LOG" | grep -q "player: stored 1 range(s), 1[12] of 1[12] s" && ok "a download: the timeline shaded end to end" \
  || bad "stored shade of a download: $(tail -n +$((m + 1)) "$LOG" | grep 'player: stored' | tail -1)"
quit
fi   # part c

if want d; then
echo "==> 7. Platz schaffen: only replaceable videos are deleted"
# three downloads in the store (example:1-3, the ids the Example app knows), all watched: online, no longer online, kept
start; quit   # the database
now=$(date +%s)
for v in 1:online 2:gone 3:kept; do
  IFS=: read n name <<< "$v"
  SQ "insert or replace into items (id,json) values ('example:$n','{\"id\":\"example:$n\",\"kind\":0,\"title\":\"Room $name\",\"source\":\"example\",\"channel\":\"Room\"}');
    insert or replace into downloads (id,source,channel,state,progress,added) values ('example:$n','example','Room',0,0,$now);"
done
SOFA_EXAMPLE_FILL=0.02 start
for i in $(seq 1 120); do [ "$(grep -c 'downloads: done example:[123]' "$LOG")" -ge 3 ] && break; sleep 0.25; done
quit
SQ "update downloads set online = (id <> 'example:2'), onlineAt = $now, keep = (id = 'example:3') where id in ('example:1','example:2','example:3');
    insert or replace into progress (id,pos,dur,watched,updated,source) select id,60,60,1,$now,'example' from downloads where id in ('example:1','example:2','example:3');"
tracks() { SS "select count(*) from tracks where item='$1'"; }
check "three downloads in the store" "$(tracks example:1)$(tracks example:2)$(tracks example:3)" "111"
start
cmd "open room"; sleep 2
shot "$T/room.png"
cmd "key select"; sleep 1        # first tile of "Aufräumen": "Gesehen"
shot "$T/room-confirm.png"
cmd "key down"; sleep 0.3; cmd "key select"; sleep 1.5   # "Ja, 1 Video löschen"
grep -q "Platz schaffen: 1 deleted" "$LOG" && ok "bulk deletion ran (1 video)" || bad "no bulk deletion: $(grep -i 'platz\|downloads' "$LOG" | tail -3)"
check "the online video was deleted (its tracks too)" "$(tracks example:1)/$(SQ "select count(*) from downloads where id='example:1'")" "0/0"
check "the video that is no longer online stays" "$(tracks example:2)" "1"
check "the kept video stays" "$(tracks example:3)" "1"
cmd "dlremove example:2"; cmd "dlremove example:3"
for i in $(seq 1 20); do [ "$(grep -c 'dev: removed download example:[23]' "$LOG")" -ge 2 ] && break; sleep 0.25; done
quit
fi   # part d

[ $fail = 0 ] && echo "==> all ok" || echo "==> FAILED"
exit $fail

#!/bin/bash
# test-downloads -- robustness regression tests for the download layer, in an invisible dev instance
# (own database, own folder ~/Movies/Sofa-dev). No YouTube requests.
#
# Incident 2026-11-04: an update restart (_exit) left ffmpeg running as an orphan; it kept writing the
# same .part file as the restarted download -> corrupt 1.2 GB file. Checks:
#   1. an orphaned ffmpeg writing into the download folder is killed at start, its part file swept
#   2. the verifier accepts a healthy file and rejects a corrupted one
#   3. quitting during a download leaves no ffmpeg behind, and the download resumes on the next start
#   4. a failed repair keeps the old file and is retried later (YouTube's bot check blocks for hours)
#   5. during a YouTube bot-check pause a queued YouTube download waits without any request
# Exit code 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$SRC/build/SofaDev.app/Contents/MacOS/Sofa"
INST=dltest PORT=47995
FIFO="$HOME/Library/Caches/Sofa/dev-$INST.fifo" LOG="$HOME/Library/Logs/Sofa-dev-$INST.log"
ROOT="$HOME/Movies/Sofa-dev"
DEVDB="$HOME/Library/Application Support/Sofa/sofa-dev.db"
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-dltest.XXXXXX")"
FF=/opt/local/bin/ffmpeg; [ -x "$FF" ] || FF=/Applications/Sofa.app/Contents/Runtime/bin/ffmpeg
REF=orf:14345720   # any ORF ON episode (replace when it expires)
BADREF=orf:1       # an episode id that does not exist: its download always fails
YTREF=yt:jNQXAC9IVRw   # never actually requested (section 5 keeps YouTube paused)
fail=0; ok() { echo "  ok    $*"; }; bad() { echo "  FAIL  $*"; fail=1; }

make -C "$SRC" >/dev/null || exit 1
APP=
start() {
  : > "$LOG"
  "$BIN" --dev --instance $INST --port $PORT >/dev/null 2>&1 & APP=$!
  for i in $(seq 1 100); do grep -q 'fifo ready' "$LOG" 2>/dev/null && return; sleep 0.1; done
  echo "dev instance did not start"; exit 1
}
quit() { echo quit > "$FIFO" 2>/dev/null; for i in $(seq 1 50); do kill -0 $APP 2>/dev/null || break; sleep 0.1; done; APP=; }
cmd() { echo "$*" > "$FIFO"; }
ffpids() { pgrep -f "ffmpeg.*$ROOT" ; }   # ffmpeg processes writing into the dev download folder
cleanup() {
  [ -n "$APP" ] && kill $APP 2>/dev/null
  for p in $(ffpids); do kill $p 2>/dev/null; done
  /opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where id in ('$REF','$BADREF','$YTREF');" 2>/dev/null
  for p in $(pgrep -f "orphan-test.part"); do kill -9 $p 2>/dev/null; done
  rm -rf "$T" "$ROOT/dev/Dev" "$ROOT/orphan-test."*
}
trap cleanup EXIT
mkdir -p "$ROOT"

echo "==> 1. orphaned ffmpeg from an earlier run"
( "$FF" -nostdin -v error -re -f lavfi -i testsrc=size=320x240:rate=10 -t 300 -c:v mpeg4 -y "$ROOT/orphan-test.part999.mp4" & )
# a second orphan that ignores SIGTERM like ffmpeg stuck in a dead network read (copy of perl named ffmpeg)
PERL=$(ls /usr/bin/perl5.* 2>/dev/null | head -1); cp "$PERL" "$T/ffmpeg"
( "$T/ffmpeg" -e '$SIG{TERM}="IGNORE"; sleep 300' "$ROOT/orphan-test.part998.mp4" & )
sleep 1
S=$(pgrep -f "part998")
O=$(pgrep -f "orphan-test.part999")
[ -n "$O" ] && [ "$(ps -o ppid= -p $O | tr -d ' ')" = 1 ] && ok "orphan running (pid $O, parent launchd)" || bad "could not create the orphan"
start; sleep 2
kill -0 $O 2>/dev/null && bad "orphan still alive" || ok "orphan killed at start"
grep -q "killing orphaned ffmpeg $O" "$LOG" && ok "logged" || bad "not logged"
[ -n "$S" ] && ! kill -0 $S 2>/dev/null && grep -q "ffmpeg $S ignored SIGTERM - SIGKILL" "$LOG" && ok "SIGTERM-ignoring orphan escalated to SIGKILL" \
  || bad "SIGTERM-ignoring orphan survived (pid ${S:-none})"
[ -e "$ROOT/orphan-test.part999.mp4" ] && bad "stale part file left" || ok "stale part file swept"

echo "==> 2. verifier"
"$FF" -hide_banner -loglevel error -y -f lavfi -i testsrc=size=1280x720:rate=25 -f lavfi -i sine -t 60 \
      -c:v libx264 -preset ultrafast -c:a aac "$T/good.mp4"
cp "$T/good.mp4" "$T/bad.mp4"
S=$(stat -f %z "$T/bad.mp4")
for f in 0.2 0.5; do   # overwrite chunks of payload with garbage (container stays readable)
  dd if=/dev/urandom of="$T/bad.mp4" bs=1 count=200000 seek=$(python3 -c "print(int($S*$f))") conv=notrunc 2>/dev/null
done
# metadata cut inside a UTF-8 sequence (ffmpeg does that with long YouTube descriptions): healthy
# files were reported "unreadable" and downloaded again (2026-11-04)
"$FF" -hide_banner -loglevel error -y -i "$T/good.mp4" -c copy -metadata comment="$(printf 'ab\xc3')" "$T/latin.mp4"
# VP9 + Opus in MP4 muxed from WebM tracks like the SABR downloads: the null muxer warns about
# timestamps after -ss (ms timebase), which used to count as decode errors
"$FF" -hide_banner -loglevel error -y -f lavfi -i testsrc=size=426x240:rate=15 -t 19 -c:v libvpx-vp9 -deadline realtime -b:v 300k "$T/v.webm"
"$FF" -hide_banner -loglevel error -y -f lavfi -i sine -t 19 -c:a libopus "$T/a.webm"
"$FF" -hide_banner -loglevel error -y -i "$T/v.webm" -i "$T/a.webm" -map 0:v:0 -map 1:a:0 -shortest -c copy -movflags +faststart "$T/vp9.mp4"
cmd "dlverify $T/good.mp4"; cmd "dlverify $T/bad.mp4"; cmd "dlverify $T/latin.mp4"; cmd "dlverify $T/vp9.mp4"; sleep 10
grep -q "dlverify vp9.mp4 -> ok" "$LOG" && ok "healthy VP9/Opus MP4 accepted" || bad "vp9.mp4 rejected: $(grep 'dlverify vp9' "$LOG")"
grep -q "dlverify latin.mp4 -> ok" "$LOG" && ok "invalid UTF-8 in metadata is no reason to reject" || bad "latin.mp4 rejected: $(grep 'dlverify latin' "$LOG")"
grep -q "dlverify good.mp4 -> ok" "$LOG" && ok "healthy file accepted" || bad "healthy file rejected: $(grep 'dlverify good' "$LOG")"
grep -q "dlverify bad.mp4 -> .*\(decode errors\|duration\|unreadable\|bitrate\)" "$LOG" && ok "corrupted file rejected ($(grep -o 'dlverify bad.mp4 -> .*' "$LOG" | cut -c20-))" \
  || bad "corrupted file accepted"

# many verifications back to back: NSTask -waitUntilExit used to hang forever on a GCD thread
for i in $(seq 1 15); do cmd "dlverify $T/good.mp4"; done
for i in $(seq 1 120); do [ "$(grep -c 'dlverify good.mp4 -> ok' "$LOG")" -ge 16 ] && break; sleep 0.5; done
[ "$(grep -c 'dlverify good.mp4 -> ok' "$LOG")" -ge 16 ] && ok "15 verifications in a row finished (no hang)" \
  || bad "verifier hung ($(grep -c 'dlverify good.mp4 -> ok' "$LOG")/16 finished)"

cmd proctest
for i in $(seq 1 20); do grep -q 'proctest status' "$LOG" && break; sleep 0.5; done
grep -q 'proctest status -2 after [12]\.' "$LOG" && ok "hung child process is killed at its timeout" \
  || bad "process timeout did not work: $(grep 'proctest' "$LOG")"

echo "==> 3. quit during a download"
cmd "dlget $REF"
for i in $(seq 1 60); do grep -q "downloads: loading" "$LOG" && break; sleep 0.5; done
sleep 3
[ -n "$(ffpids)" ] && ok "download ffmpeg running" || bad "download did not start: $(grep 'downloads' "$LOG" | tail -2)"
quit; sleep 1
[ -z "$(ffpids)" ] && ok "no ffmpeg left after quit" || bad "ffmpeg survived the quit: $(ffpids)"
start
for i in $(seq 1 60); do grep -q "downloads: loading" "$LOG" && break; sleep 0.5; done
grep -q "downloads: loading" "$LOG" && ok "download resumed on the next start" || bad "download not resumed"
quit

echo "==> 4. a failed repair keeps the file and is retried"
# nothing else in the dev queue may run first (dev database only)
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where state in (0,1);"
mkdir -p "$ROOT/dev/Dev"; cp "$T/good.mp4" "$ROOT/dev/Dev/repair.mp4"
/opt/local/bin/sqlite3 "$DEVDB" "insert or replace into downloads (id,source,channel,item,path,state,progress,added) values ('$BADREF','dev','Dev','{\"id\":\"$BADREF\",\"kind\":0,\"title\":\"Repair\",\"ref\":\"$BADREF\",\"source\":\"dev\"}','$ROOT/dev/Dev/repair.mp4',0,0,strftime('%s','now'));"
start
for i in $(seq 1 60); do grep -q "repair of $BADREF failed" "$LOG" && break; sleep 0.5; done
grep -q "repair of $BADREF failed.*retry in 15 min" "$LOG" && ok "failed repair scheduled for a retry" || bad "no retry scheduled: $(grep "$BADREF" "$LOG" | tail -2)"
[ -s "$ROOT/dev/Dev/repair.mp4" ] && ok "existing file kept" || bad "existing file lost"
cmd dlretry
# the retry starts only after the per-source spacing of starts (30 s since the first attempt)
for i in $(seq 1 100); do grep -q "repair of $BADREF failed.*retry in 30 min" "$LOG" && break; sleep 0.5; done
grep -q "retrying the repair of $BADREF (attempt 2)" "$LOG" && grep -q "retry in 30 min" "$LOG" && ok "retried with a longer backoff" || bad "not retried: $(grep "$BADREF" "$LOG" | tail -2)"
quit
st=$(/opt/local/bin/sqlite3 "$DEVDB" "select state||' '||tries||' '||substr(error,1,7) from downloads where id='$BADREF';")
[ "$st" = "2 2 repair:" ] && ok "marker persisted (state done, 2 tries)" || bad "unexpected record: $st"

# without a manual trigger: the next retry is scheduled for exactly when it is due (it used to wait for
# the next app start or the 3-hourly subscription check). Base delay 3 s instead of 15 min.
/opt/local/bin/sqlite3 "$DEVDB" "update downloads set tries=1, failedAt=strftime('%s','now') where id='$BADREF';"
SOFA_RETRY_BASE=3 start
for i in $(seq 1 120); do grep -q "retrying the repair of $BADREF" "$LOG" && break; sleep 0.5; done
grep -q "retrying the repair of $BADREF (attempt 2)" "$LOG" && ok "retry ran on its own when due" || bad "no scheduled retry: $(grep "$BADREF" "$LOG" | tail -2)"
quit

echo "==> 5. YouTube download during a bot-check pause"
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where id='$YTREF';"   # leftovers of manual tests
start
cmd "ytblock 900"; sleep 0.5
m=$(wc -l < "$LOG"); cmd "dlget $YTREF"
for i in $(seq 1 20); do sed -n "$m,\$p" "$LOG" | grep -q "source paused" && break; sleep 0.5; done
sed -n "$m,\$p" "$LOG" | grep -q "source paused - next attempt in 1[45] min" && ok "download waits for the end of the pause" || bad "no wait: $(sed -n "$m,\$p" "$LOG" | grep downloads | tail -2)"
sed -n "$m,\$p" "$LOG" | grep -q "yt: resolve\|yt: resolved\|downloads: loading" && bad "a YouTube request was made during the pause" || ok "no YouTube request during the pause"
quit
st=$(/opt/local/bin/sqlite3 "$DEVDB" "select state||' '||tries from downloads where id='$YTREF';")
[ "$st" = "0 0" ] && ok "still queued, no attempt used up" || bad "unexpected record: $st"
/opt/local/bin/sqlite3 "$DEVDB" "delete from downloads where id='$YTREF';"

[ $fail = 0 ] && echo "==> all ok" || echo "==> FAILED"
exit $fail

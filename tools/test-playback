#!/bin/bash
# test-playback -- robustness regression tests for the player, driven through an invisible dev
# instance (own database, muted). Offline: generated local files and the Example app's test pattern
# (SOFA_ONLY_APPS: no Mediathek, no network request at all).
#
# Checks (each one is a bug that happened in production):
#   1. playback right after launch has a configured video output (render-context race, 2026-11-04:
#      after an update restart the file resumed before the GL layer existed -> audio only)
#   2. a dead video output heals itself (watchdog re-selects the video track)
#   3. the info panel (OK hold) opens over the running video, which keeps playing under it and
#      after MENU (the panel must never stop or restart playback)
#   4. a broken stream walks the fallback chain and ends in a readable German message
#   5. a downloaded item switches to the online stream at the same position, chosen in the info
#      panel ("Online abspielen" used to restart the local file because the download lookup found it again)
#   6. a remembered subtitle preference is applied automatically
#   7. a stream that stops delivering mid-playback is detected (stall watchdog) and handled
#      (2026-11-05: a dead SABR sidecar left mpv hanging in a seek forever, no error event)
#   8. YouTube end screen (fake /open data via the dev command, offline, no YouTube request):
#      tiles follow the timeline (also while paused), DOWN enters, arrows move, follow toggles,
#      MENU leaves without touching playback, OK on a video plays it (a "downloaded" test video),
#      the end of the video waits while the tiles have focus
#   9. (opt-in, SOFA_YT_LIVE=1: YouTube media) SABR playback and self-healing when the sidecar dies
#  10. (opt-in, SOFA_YT_LIVE_STREAM=<video id of a running live>: one player request, ~15 s of live
#      media) a YouTube live plays through the sidecar's HLS playlist, not yt-dlp
#
#   tools/test-playback            all checks
#   PLAYTEST_INSTANCE=x PLAYTEST_PORT=n   own dev instance (parallel runs)
#   PLAYTEST_SHOTS=dir             keep the screenshots there
# Exit code 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$SRC/build/SofaDev.app/Contents/MacOS/Sofa"
INST=${PLAYTEST_INSTANCE:-playtest} PORT=${PLAYTEST_PORT:-47994}
FIFO="$HOME/Library/Caches/Sofa/dev-$INST.fifo" LOG="$HOME/Library/Logs/Sofa-dev-$INST.log"
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-playtest.XXXXXX")"
export SOFA_DATA_DIR="$T/data"   # the dev instance's whole state, fresh per run (SFSetDevInstance)
DEVDB="$SOFA_DATA_DIR/sofa.db"
FF=/opt/local/bin/ffmpeg; [ -x "$FF" ] || FF=/Applications/Sofa.app/Contents/Runtime/bin/ffmpeg
export SOFA_ONLY_APPS=example,youtube   # YouTube only for the offline end screen (section 8)
ORF=example:1   # an online item (the Example app's test pattern)
fail=0; ok() { echo "  ok    $*"; }; bad() { echo "  FAIL  $*"; fail=1; }

make -C "$SRC" >/dev/null || exit 1
"$FF" -hide_banner -loglevel error -y -f lavfi -i testsrc=size=1280x720:rate=25 -f lavfi -i sine=frequency=440 \
      -t 90 -c:v libx264 -preset ultrafast -c:a aac "$T/local.mp4" || { echo "ffmpeg failed"; exit 1; }

APP=
start() {
  : > "$LOG"
  SOFA_STALL_LIMIT=6 "$BIN" --dev --instance $INST --port $PORT >/dev/null 2>&1 & APP=$!; dead=
  for i in $(seq 1 100); do grep -q 'fifo ready' "$LOG" 2>/dev/null && return; sleep 0.1; done
  echo "dev instance did not start"; exit 1
}
# FIFO opened read-write: never blocks (a crashed app used to hang the test forever on open)
stop() {   # quit, then wait for the process (up to 5 s) instead of a fixed pause
  echo quit 1<>"$FIFO" 2>/dev/null
  for i in $(seq 1 50); do kill -0 $APP 2>/dev/null || break; sleep 0.1; done
  kill $APP 2>/dev/null; APP=
}
cmd() {
  if ! kill -0 "$APP" 2>/dev/null; then [ -z "${dead:-}" ] && bad "app not running (crashed?)"; dead=1; return; fi
  echo "$*" 1<>"$FIFO"
}
since() { sed -n "$1,\$p" "$LOG"; }   # log lines from line $1 on
mark() { wc -l < "$LOG" | tr -d ' '; }
# waitlog MARK PATTERN [TRIES]: until PATTERN appears after MARK (TRIES x 0.25 s, default 10 s)
waitlog() { for i in $(seq 1 ${3:-40}); do since $1 | grep -q "$2" && return 0; sleep 0.25; done; return 1; }
# shot FILE: screenshot, waits until it is written (a fixed sleep was flaky under load)
shot() { local m; m=$(mark); cmd "shot $1"; waitlog $m "dev: shot written $1" 40; }
keep() { [ -n "${PLAYTEST_SHOTS:-}" ] && [ -s "$1" ] && cp "$1" "$PLAYTEST_SHOTS/"; return 0; }
mpvtime() { sed -n "$1,\$p" "$LOG" | grep 'mpv time-pos = ' | tail -1 | sed 's/.*= //'; }   # last reported position
ESCH=UCsofaEndscreenTest0000001   # fake channel of the end screen check (follow/unfollow)
cleanup() {
  [ -n "$APP" ] && kill $APP 2>/dev/null
  defaults delete de.sofa.dev.$INST >/dev/null 2>&1   # this instance's settings (section 6)
  rm -rf "$T"
}
trap cleanup EXIT
SQL=/opt/local/bin/sqlite3; sqlite3() { "$SQL" "$@"; }

echo "==> 1. playback right after launch"
start
m=$(mark); cmd "play $T/local.mp4|$ORF"; waitlog $m 'player: play local.mp4'
vo() {   # vo MARK: ask mpv until it reports a configured video output (10 s)
  for i in $(seq 1 20); do local n; n=$(mark); cmd "mpvprop vo-configured"; waitlog $n 'mpv vo-configured' 4; since $1 | grep -q 'mpv vo-configured = yes' && return 0; sleep 0.25; done; return 1
}
vo $m
grep -q 'mpv vo-configured = yes' "$LOG" && ok "video output configured" || bad "no video output (audio only?)"
grep -q 'No render context set' "$LOG" && bad "mpv started before the render context" || ok "no render-context race"

echo "==> 2. self-healing of a dead video output"
m=$(mark); cmd "mpvset vid no"; waitlog $m 'video output missing' 40; vo $m
since $m | grep -q 'video output missing' && ok "watchdog noticed the missing video" || bad "watchdog did not react"
since $m | grep -q 'mpv vo-configured = yes' && ok "video output restored" || bad "video output not restored"

echo "==> 3. info panel over the running video"
m=$(mark); cmd "key selecthold"; waitlog $m 'info: panel for'
since $m | grep -q 'info: panel for' && ok "panel opened" || bad "panel did not open"
shot "$T/info.png"; [ -s "$T/info.png" ] && { ok "panel rendered"; keep "$T/info.png"; } || bad "no panel screenshot"
cmd "mpvprop time-pos"; sleep 0.5; t1=$(mpvtime $m); sleep 2
m2=$(mark); cmd "mpvprop time-pos"; sleep 0.5; t2=$(mpvtime $m2)
awk "BEGIN{exit !($t2 > $t1 + 1)}" 2>/dev/null && ok "video keeps playing under the panel ($t1 -> $t2 s)" || bad "video not playing under the panel ($t1 -> $t2)"
m3=$(mark); cmd "key menu"; sleep 2; cmd "mpvprop time-pos"; sleep 0.5; t3=$(mpvtime $m3)
since $m3 | grep -q 'info: panel closed' && ok "MENU closed the panel" || bad "MENU did not close the panel"
awk "BEGIN{exit !($t3 > $t2 + 1)}" 2>/dev/null && ok "playback continues after MENU ($t3 s)" || bad "playback stopped after MENU ($t3)"
since $m | grep -q 'player: resolve\|player: play ' && bad "the panel restarted playback" || ok "no restart by the panel"

echo "==> 4. broken stream -> fallback chain -> readable message"
m=$(mark); cmd "play http://127.0.0.1:1/broken.mp4"; sleep 8
since $m | grep -q 'mpv fails -> AVFoundation' && ok "fallback chain ran" || bad "no fallback"
since $m | grep -q 'player: failed' && ok "ended in a failure state" || bad "no final failure"
shot "$T/fail.png"; [ -s "$T/fail.png" ] && ok "error screen rendered ($T/fail.png kept until exit)" || bad "no screenshot"
stop

echo "==> 5. download -> online stream at the same position (via the info panel)"
sqlite3 "$DEVDB" "insert or replace into downloads (id,source,channel,item,path,state,progress,added) values ('$ORF','orf','ORF','{\"id\":\"$ORF\",\"kind\":0,\"title\":\"Playtest\",\"ref\":\"$ORF\",\"source\":\"orf\"}','$T/local.mp4',2,1,strftime('%s','now'));"
start
m=$(mark); cmd "play $ORF"; waitlog $m 'player: play local.mp4'
grep -q 'player: play local.mp4' "$LOG" && ok "download preferred when present" || bad "download not used"
m=$(mark); cmd "key selecthold"; waitlog $m 'info: panel for'; shot "$T/info-download.png"; keep "$T/info-download.png"
cmd "key select"   # first action of a downloaded video with one audio track: "Online abspielen"
waitlog $m 'player: play apasfiis\|player: play .*via mpv' 60
since $m | grep -q 'Download -> online' && ok "switched to online" || bad "no switch"
since $m | grep -q 'player: play apasfiis\|player: play .*via mpv' && ! since $m | grep -q 'player: play local.mp4' \
  && ok "online stream playing (not the file again)" || bad "the local file was played again"

stop

echo "==> 6. remembered subtitle preference"
# local file: German audio + German subtitles; preference "subtitles in the audio language" set
printf '1\n00:00:00,000 --> 00:01:30,000\nUntertitel\n' > "$T/de.srt"
"$FF" -hide_banner -loglevel error -y -i "$T/local.mp4" -i "$T/de.srt" -map 0 -map 1 -c copy -c:s mov_text \
      -metadata:s:a:0 language=deu -metadata:s:s:0 language=deu "$T/subs.mp4"
defaults write de.sofa.dev.$INST subtitlesSameLanguage -bool YES
start
m=$(mark); cmd "playlist $T/subs.mp4"
waitlog $m 'subtitles .*remembered language' && ok "subtitles applied automatically" \
  || bad "remembered subtitle preference not applied: $(since $m | grep -i 'subtitle\|player:' | tail -2)"
defaults delete de.sofa.dev.$INST >/dev/null 2>&1
stop

echo "==> 7. stream stops delivering -> stall watchdog"
# HTTP server: serves the first 600 KB of the file, then keeps the connection open without data
cat > "$T/stall.py" <<'PY'
import http.server, sys, time, os
F = sys.argv[1]
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        size = os.path.getsize(F)
        self.send_response(200); self.send_header("Content-Length", str(size)); self.send_header("Content-Type", "video/mp4"); self.end_headers()
        with open(F, "rb") as f: self.wfile.write(f.read(600000))
        self.wfile.flush(); time.sleep(600)
http.server.ThreadingHTTPServer(("127.0.0.1", int(sys.argv[2])), H).serve_forever()
PY
/opt/local/bin/python3.14 -I "$T/stall.py" "$T/local.mp4" 47981 & SRV=$!
for i in $(seq 1 40); do nc -z 127.0.0.1 47981 2>/dev/null && break; sleep 0.1; done   # listening before the app asks
start
m=$(mark); cmd "play http://127.0.0.1:47981/stall.mp4"
for i in $(seq 1 60); do since $m | grep -q 'no progress for\|player: failed' && break; sleep 0.5; done
since $m | grep -q 'mpv: no progress for 6 s' && ok "stall detected" || bad "stall not detected: $(since $m | grep 'player:\|mpv:' | tail -3)"
for i in $(seq 1 40); do since $m | grep -q 'player: failed' && break; sleep 0.5; done
since $m | grep -q 'player: failed' && ok "fallback chain ended in a readable failure" || bad "no final failure after the stall"
kill $SRV 2>/dev/null; wait $SRV 2>/dev/null
stop

echo "==> 8. YouTube end screen (fake data, offline)"
# thumbnails + a "downloaded" copy of the first tile's video: OK on it plays a local file, no network
"$FF" -hide_banner -loglevel error -y -f lavfi -i mandelbrot=size=640x360 -frames:v 1 "$T/es1.png"
"$FF" -hide_banner -loglevel error -y -f lavfi -i smptehdbars=size=640x360 -frames:v 1 "$T/es2.png"
"$FF" -hide_banner -loglevel error -y -f lavfi -i "cellauto=size=300x300:rule=110" -frames:v 1 "$T/esav.png"
cp "$T/local.mp4" "$T/endvid.mp4"
sqlite3 "$DEVDB" "insert or replace into downloads (id,source,channel,item,path,state,progress,added) values ('yt:esTestVid01','youtube','Testkanal','{\"id\":\"yt:esTestVid01\",\"kind\":0,\"title\":\"Endscreen-Testvideo\",\"ref\":\"yt:esTestVid01\",\"source\":\"youtube\"}','$T/endvid.mp4',2,1,strftime('%s','now'));"
ES='[{"kind":"video","ref":"yt:esTestVid01","title":"Erstes Video","left":0.05,"top":0.2,"width":0.4,"aspectRatio":1.7778,"startMs":6000,"endMs":0,"image":"'$T'/es1.png"},'\
'{"kind":"video","ref":"yt:esTestVid02","title":"Zweites Video","left":0.55,"top":0.2,"width":0.4,"aspectRatio":1.7778,"startMs":6000,"endMs":0,"image":"'$T'/es2.png"},'\
'{"kind":"follow","ref":"ytchannel:'$ESCH'","title":"Endscreen-Testkanal","left":0.05,"top":0.7,"width":0.1,"aspectRatio":1,"startMs":7000,"endMs":0,"image":"'$T'/esav.png"}]'
export SOFA_OFFLINE=1
start
m=$(mark); cmd "playlist $T/local.mp4"; sleep 2; cmd "endscreen $ES"
waitlog $m 'endscreen: 3 tiles from 6.0 s' && ok "end screen data taken over" || bad "no end screen tiles: $(since $m | grep 'endscreen' | tail -2)"
waitlog $m 'endscreen: shown at' 60
at=$(since $m | grep 'endscreen: shown at' | head -1 | sed 's/.*shown at \([0-9.]*\) s/\1/')
awk "BEGIN{exit !($at >= 6.0 && $at < 8)}" 2>/dev/null && ok "tiles appear at the first startMs ($at s)" || bad "tiles appeared at '$at' (want 6 s)"
since $m | grep -q 'endscreen: video rect {{0, 0}, {1920, 1080}}' && ok "tiles placed over the video rect" || bad "video rect: $(since $m | grep 'video rect' | tail -1)"
sleep 1.5; shot "$T/endscreen.png"; [ -s "$T/endscreen.png" ] && { ok "end screen rendered"; keep "$T/endscreen.png"; } || bad "no end screen screenshot"
m=$(mark); cmd "key down"; sleep 0.4; cmd "key right"; sleep 0.4; cmd "key left"; sleep 0.4; cmd "key down"; sleep 0.6
since $m | grep 'endscreen: focus' | sed 's/.*focus //' | tr '\n' ' ' | grep -q '0 (video) 1 (video) 0 (video) 2 (follow)' \
  && ok "DOWN enters, arrows move spatially" || bad "focus path: $(since $m | grep 'endscreen: focus' | sed 's/.*focus //' | tr '\n' ' ')"
shot "$T/endscreen-focus.png"; keep "$T/endscreen-focus.png"
m=$(mark); cmd "key select"; sleep 0.6; cmd "key select"; sleep 0.6
since $m | grep -q 'follows: + Endscreen-Testkanal' && since $m | grep -q "follows: - ytchannel:$ESCH" && ok "follow tile follows and unfollows" || bad "follow toggle: $(since $m | grep 'follows' | tail -2)"
m=$(mark); cmd "key menu"; sleep 0.6; cmd "mpvprop time-pos"; sleep 0.5; t1=$(mpvtime $m); sleep 1.5; m2=$(mark); cmd "mpvprop time-pos"; sleep 0.5; t2=$(mpvtime $m2)
since $m | grep -q 'endscreen: left the tiles' && ok "MENU leaves the tiles" || bad "MENU did not leave the tiles"
awk "BEGIN{exit !($t2 > $t1 + 0.5)}" 2>/dev/null && ok "playback goes on after leaving ($t1 -> $t2 s)" || bad "playback stopped after MENU ($t1 -> $t2)"
m=$(mark); cmd "key play"; sleep 0.8; cmd "key prev"; waitlog $m 'endscreen: hidden' && ok "seeking back before the end screen hides it (paused)" || bad "tiles stayed after seeking back"
cmd "key play"
m=$(mark); waitlog $m 'endscreen: shown at' 60; cmd "key down"; sleep 0.4; cmd "key select"
waitlog $m 'player: play endvid.mp4' && ok "OK on a video tile plays it" || bad "video tile did not play: $(since $m | grep 'endscreen\|player:' | tail -2)"
m=$(mark); cmd "playlist $T/local.mp4"; sleep 2; cmd "endscreen $ES"; sleep 0.5
for k in right right right left; do cmd "key $k"; sleep 0.3; done   # one jump of +80 s -> ~8 s before the end
waitlog $m 'endscreen: shown at' 20; cmd "key down"
waitlog $m 'ended while in the end screen' 80 && ok "the end waits while the tiles have focus" || bad "end did not wait: $(since $m | grep 'player:\|endscreen' | tail -2)"
sleep 1.5; since $m | grep -q 'player: end ->' && bad "end flow ran while the tiles had focus" || ok "no up-next/leave under the tiles"
m2=$(mark); cmd "key menu"; waitlog $m2 'player: end -> leaving' 12 && ok "leaving the tiles finishes the end" || bad "end flow did not run after MENU"
stop
unset SOFA_OFFLINE

if [ -n "${SOFA_YT_LIVE:-}" ]; then
  echo "==> 9. SABR playback + sidecar crash (YouTube media)"
  start
  m=$(mark); cmd "play yt:OzCYsIrrRyw"; sleep 10
  since $m | grep -q 'sabr: opened OzCYsIrrRyw' && ok "opened via SABR" || bad "not via SABR: $(since $m | grep 'sabr\|yt:' | tail -2)"
  cmd "mpvprop vo-configured"; sleep 1
  since $m | grep -q 'mpv vo-configured = yes' && ok "video output configured" || bad "no video"
  pkill -f "sofa-yt/main.ts.*$SOFA_DATA_DIR/sofa-yt"; sleep 8
  since $m | grep -q 'SABR stream failed (sidecar exited) -> reopening via SABR' && ok "sidecar crash noticed" || bad "crash not noticed"
  m2=$(mark); cmd "mpvprop time-pos"; sleep 1; a=$(mpvtime $m2); sleep 3; m3=$(mark); cmd "mpvprop time-pos"; sleep 1; b=$(mpvtime $m3)
  awk "BEGIN{exit !($b > $a + 1)}" 2>/dev/null && ok "playing again after the restart ($a -> $b s)" || bad "not playing after the restart ($a -> $b)"
  stop
fi

if [ -n "${SOFA_YT_LIVE_STREAM:-}" ]; then
  L=$SOFA_YT_LIVE_STREAM
  echo "==> 10. YouTube live via the sidecar (HLS)"
  start
  m=$(mark); cmd "play ytlive:$L"
  for i in $(seq 1 60); do since $m | grep -q "sabr: opened $L\|SABR live unavailable\|resolve failed" && break; sleep 0.5; done
  since $m | grep -q "sabr: opened $L -> live HLS" && ok "opened via the sidecar: $(since $m | grep "sabr: opened $L" | tail -1 | sed 's/.*-> //')" \
    || bad "not via the sidecar: $(since $m | grep 'sabr\|yt:\|player:' | tail -3)"
  since $m | grep -q "yt: resolved $L\|yt: resolve $L failed" && bad "yt-dlp was asked" || ok "no yt-dlp request"
  sleep 6
  cmd "mpvprop vo-configured"; sleep 1
  since $m | grep -q 'mpv vo-configured = yes' && ok "video output configured" || bad "no video"
  m2=$(mark); cmd "mpvprop time-pos"; sleep 1; a=$(mpvtime $m2); sleep 4; m3=$(mark); cmd "mpvprop time-pos"; sleep 1; b=$(mpvtime $m3)
  awk "BEGIN{exit !($b > $a + 1)}" 2>/dev/null && ok "live is playing ($a -> $b s)" || bad "live not playing ($a -> $b)"
  stop
fi

[ $fail = 0 ] && echo "==> all ok" || echo "==> FAILED"
exit $fail

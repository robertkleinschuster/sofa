#!/bin/bash
# test-playback -- robustness regression tests for the player, driven through an invisible dev
# instance (own database, muted). Offline: generated local files and the Example app's test pattern
# (SOFA_ONLY_APPS: no Mediathek, no network request at all).
#
# Checks (each one is a bug that happened in production):
#   1. playback right after launch has a configured video output (render-context race, 2026-11-04:
#      after an update restart the file resumed before the GL layer existed -> audio only)
#   2. a dead video output heals itself (watchdog re-selects the video track)
#   3. the info panel (OK hold) opens over the running video, which keeps playing under it and
#      after MENU (the panel must never stop or restart playback); an OK right after MENU belongs to
#      the closing panel (a double press used to open/play what was below)
#   4. a broken stream ends in a readable German message
#   4b. a failed entry of a queue/playlist shows the message, then the next entry plays (one dead
#      entry used to stop a phone playlist)
#   4c. the end waits (up to 4 s) for an up-next recommendation still on its way, then leaves without
#      it (the end used to leave at once when the answer came a moment late)
#   5. a downloaded item switches to the online stream at the same position, chosen in the info
#      panel ("Online abspielen" used to restart the local file because the download lookup found it again)
#   6. a remembered subtitle preference is applied automatically
#   6b. audio/subtitle tracks chosen by hand stay chosen when the stream is reopened (dev breakstream)
#   7. a stream that stops delivering is detected (stall watchdog) and handled (2026-11-05: a dead
#      SABR sidecar left mpv hanging in a seek forever, no error event) - also when Play/Pause during
#      the load made it a paused open (the watchdog used to skip paused opens: a spinner forever)
#   7b. a stream that breaks off after its playback began is reopened once at the position, then a
#      message (until 2026-11-08 a plain stream broken midway showed a dead "Verbindung unterbrochen")
#   8. YouTube end screen (fake /open data via the dev command, offline, no YouTube request):
#      tiles follow the timeline (also while paused), DOWN enters, arrows move, follow toggles,
#      MENU leaves without touching playback, OK on a video plays it (a "downloaded" test video),
#      the end of the video waits while the tiles have focus
#   8c. a phone queue (Lounge setPlaylist, offline) fetches watch pages only for the playing and the
#      next video, never the whole list (2026-11-06: 100 pages in a minute -> bot checks)
#   8b. a session stream (app service, e.g. YouTube's engine) that breaks again right after being
#      reopened ends in a message - one reopen, no loop (2026-11-06: without the yt-dlp fallback the
#      second failure would otherwise reopen forever)
#   8d. a resumed DASH start (separate WebM tracks, like YouTube's engine) does not wait for the
#      media at 0 (2026-11-08: mpv's reference probes peeked 8 KiB, past the Opus header -> ~7 s)
#   9. (opt-in, SOFA_YT_LIVE=1: YouTube media) SABR playback through the engine's Firefox and
#      self-healing when that browser dies
#  10. (opt-in, SOFA_YT_LIVE_STREAM=<video id of a running live>: one player request, ~15 s of live
#      media) a YouTube live plays through the engine's HLS playlist
#
#   tools/test-playback            all checks: two parts side by side, each in its own dev instance
#                                  (part a: 1-7b, 8c, 8b, 8d; part b: 8 and the opt-in ones - they wait
#                                  for playback, not for the CPU)
#   PLAYTEST_PART=a|b              one part only (in this process)
#   PLAYTEST_INSTANCE=x            own dev instance (parallel runs)
#   PLAYTEST_SHOTS=dir             keep the screenshots there (and the logs of a failed run)
# Exit code 0 = all ok.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
. "$SRC/tools/lib/dev-instance.sh"
BIN="$SRC/build/SofaDev.app/Contents/MacOS/Sofa"
PART=${PLAYTEST_PART:-}
if [ -z "$PART" ]; then   # both parts at once, each with its own instance; output part by part
  make -C "$SRC" >/dev/null || exit 1
  O="$(mktemp -d "${TMPDIR:-/tmp}/sofa-playparts.XXXXXX")"
  PLAYTEST_PART=a PLAYTEST_INSTANCE=playtest-a "$0" > "$O/a" 2>&1 & A=$!
  PLAYTEST_PART=b PLAYTEST_INSTANCE=playtest-b "$0" > "$O/b" 2>&1 & B=$!
  wait $A; ra=$?; wait $B; rb=$?
  grep -v '^==> all ok$\|^==> FAILED$' "$O/a" "$O/b" -h
  rm -rf "$O"
  [ $ra = 0 ] && [ $rb = 0 ] && { echo "==> all ok"; exit 0; } || { echo "==> FAILED"; exit 1; }
fi
want() { [ "$PART" = "$1" ]; }
INST=${PLAYTEST_INSTANCE:-playtest-$PART}
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-playtest.XXXXXX")"
trap 'rm -rf "${T:?}"' EXIT   # until the full cleanup below takes over (a failed build exits before it)
export SOFA_DATA_DIR="$T/data"   # the dev instance's whole state, fresh per run (SFSetDevInstance)
# the instance keeps its log and dev FIFO in its data directory (SFDevPrivateDir): gone with $T
mkdir -p "$SOFA_DATA_DIR"; FIFO="$SOFA_DATA_DIR/dev.fifo" LOG="$SOFA_DATA_DIR/sofa.log"
DEVDB="$SOFA_DATA_DIR/sofa.db"
FF=/opt/local/bin/ffmpeg; [ -x "$FF" ] || FF=/Applications/Sofa.app/Contents/Runtime/bin/ffmpeg
export SOFA_ONLY_APPS=example,youtube   # YouTube only for the offline end screen (section 8)
ORF=example:1   # an online item (the Example app's test pattern)
fail=0; ok() { echo "  ok    $*"; }
# a failure keeps the instance's log as it is now: the next start empties it
nfail=0; bad() { echo "  FAIL  $*"; fail=1; nfail=$((nfail + 1)); [ -n "${PLAYTEST_SHOTS:-}" ] && [ -s "$LOG" ] && cp "$LOG" "$PLAYTEST_SHOTS/$INST-fail$nfail.log"; return 0; }

make -C "$SRC" >/dev/null || exit 1
"$FF" -hide_banner -loglevel error -y -f lavfi -i testsrc=size=640x360:rate=10 -f lavfi -i sine=frequency=440 \
      -t 90 -c:v libx264 -preset ultrafast -c:a aac "$T/local.mp4" || { echo "ffmpeg failed"; exit 1; }

APP=
start() {
  : > "$LOG"
  SOFA_STALL_LIMIT=6 "$BIN" --dev --instance $INST >/dev/null 2>&1 & APP=$!; dead=
  dev_wait_ready $APP "$LOG"
}
# FIFO opened read-write: never blocks (a crashed app used to hang the test forever on open)
# closing a player waited ~300 ms on the main thread for mpv's threads (hitch monitor 2026-11-07,
# -[SFMPVEngine shutdown] / freeRenderContext): teardown runs on its own queue - no stall of this
# instance may be spent in it. (Property reads are not checked here: the tests' mpvprop reads on purpose.)
mpvstalls() {
  local s; s=$(grep 'hitch: main thread blocked' "$LOG" | grep -E 'SFMPVEngine shutdown|SFMPVLayer retire' | head -3)
  [ -z "$s" ] && ok "closing players never stalled the main thread" || bad "main thread stalled in mpv teardown: $s"
}
stop() {   # quit, then wait for the process (dev_wait_exit) instead of a fixed pause
  mpvstalls
  echo quit 1<>"$FIFO" 2>/dev/null
  dev_wait_exit $APP
  kill $APP 2>/dev/null; APP=
}
cmd() {
  if ! kill -0 "$APP" 2>/dev/null; then [ -z "${dead:-}" ] && bad "app not running (crashed?)"; dead=1; return; fi
  echo "$*" 1<>"$FIFO"
}
since() { log_since "$1" "$LOG"; }   # log lines written after mark $1
mark() { log_mark "$LOG"; }
# waitlog MARK PATTERN [TRIES]: until PATTERN appears after MARK (TRIES x 0.25 s, default 10 s)
waitlog() { for i in $(seq 1 ${3:-40}); do since $1 | grep -q "$2" && return 0; sleep 0.25; done; return 1; }
# shot FILE: screenshot, waits until it is written (a fixed sleep was flaky under load)
shot() { local m; m=$(mark); cmd "shot $1"; waitlog $m "dev: shot written $1" 40; }
keep() { [ -n "${PLAYTEST_SHOTS:-}" ] && [ -s "$1" ] && cp "$1" "$PLAYTEST_SHOTS/$INST-$(basename "$1")"; return 0; }   # per part: both keep a sofa.log
mpvtime() { since "$1" | grep 'mpv time-pos = ' | tail -1 | sed 's/.*= //'; }   # last reported position
pos() { local n; n=$(mark); cmd "mpvprop time-pos"; waitlog $n 'mpv time-pos = ' 12; mpvtime $n; }   # asks mpv, waits for the answer
ESCH=UCsofaEndscreenTest0000001   # fake channel of the end screen check (follow/unfollow)
cleanup() {
  [ -n "$APP" ] && { kill $APP 2>/dev/null; wait $APP 2>/dev/null; }
  # a failed run keeps its logs next to the screenshots (the app's, the engine browser's)
  [ "${fail:-0}" != 0 ] && { keep "$LOG"; keep "$SOFA_DATA_DIR/youtube-engine/profile-firefox.log"; }
  # this instance's settings (section 6) - after the app is gone, or its last write brings them back
  { defaults delete de.sofa.dev.$INST; rm -f "$HOME/Library/Preferences/de.sofa.dev.$INST.plist"; } >/dev/null 2>&1
  rm -rf "$T"
}
trap cleanup EXIT
SQL=/opt/local/bin/sqlite3; sqlite3() { "$SQL" "$@"; }

if want a; then
echo "==> 1. playback right after launch"
start
m=$(mark); cmd "play $T/local.mp4|$ORF"; waitlog $m 'player: play local.mp4'
vo() {   # vo MARK: ask mpv until it reports a configured video output (10 s)
  for i in $(seq 1 20); do local n; n=$(mark); cmd "mpvprop vo-configured"; waitlog $n 'mpv vo-configured' 4; since $1 | grep -q 'mpv vo-configured = yes' && return 0; sleep 0.25; done; return 1
}
vo $m
grep -q 'mpv vo-configured = yes' "$LOG" && ok "video output configured" || bad "no video output (audio only?)"
grep -q 'No render context set' "$LOG" && bad "mpv started before the render context" || ok "no render-context race"
# the spinner stays until the first frame (user 2026-11-07: seconds of black screen after it vanished
# at "file loaded"): its "off" comes after mpv's first frame, never before
# (playback-restart may follow vo-configured by a moment: wait for the spinner to go, then compare)
waitlog $m 'player: spinner off' 40
ff=$(since $m | grep -n 'mpv: first frame' | head -1 | cut -d: -f1); so=$(since $m | grep -n 'player: spinner off' | head -1 | cut -d: -f1)
[ -n "$ff" ] && [ -n "$so" ] && [ "$so" -gt "$ff" ] && ok "spinner until the first frame" || bad "spinner gone before the first frame (frame line ${ff:-none}, off line ${so:-none})"

echo "==> 2. self-healing of a dead video output"
m=$(mark); cmd "mpvset vid no"; waitlog $m 'video output missing' 40; vo $m
since $m | grep -q 'video output missing' && ok "watchdog noticed the missing video" || bad "watchdog did not react"
since $m | grep -q 'mpv vo-configured = yes' && ok "video output restored" || bad "video output not restored"

echo "==> 3. info panel over the running video"
m=$(mark); cmd "key selecthold"; waitlog $m 'info: panel for'
since $m | grep -q 'info: panel for' && ok "panel opened" || bad "panel did not open"
shot "$T/info.png"; [ -s "$T/info.png" ] && { ok "panel rendered"; keep "$T/info.png"; } || bad "no panel screenshot"
t1=$(pos); sleep 2
t2=$(pos)
awk "BEGIN{exit !($t2 > $t1 + 1)}" 2>/dev/null && ok "video keeps playing under the panel ($t1 -> $t2 s)" || bad "video not playing under the panel ($t1 -> $t2)"
m3=$(mark); cmd "key menu"; cmd "key select"; sleep 2; t3=$(pos)   # a quick OK right after: the closing panel's, not the player's
since $m3 | grep -q 'info: panel closed' && ok "MENU closed the panel" || bad "MENU did not close the panel"
since $m3 | grep -q 'keys: select dropped while a screen closes' && ok "an OK during the close reaches nothing below" || bad "OK during the close went through"
awk "BEGIN{exit !($t3 > $t2 + 1)}" 2>/dev/null && ok "playback continues after MENU ($t3 s)" || bad "playback stopped after MENU ($t3)"
since $m | grep -q 'player: resolve\|player: play ' && bad "the panel restarted playback" || ok "no restart by the panel"

echo "==> 4. broken stream -> readable message"
m=$(mark); cmd "play http://127.0.0.1:1/broken.mp4"; waitlog $m 'player: failed' 60
since $m | grep -q 'player: failed' && ok "ended in a failure state" || bad "no final failure"
shot "$T/fail.png"; [ -s "$T/fail.png" ] && ok "error screen rendered ($T/fail.png kept until exit)" || bad "no screenshot"
stop

echo "==> 4b. a failed playlist entry: the message, then the next entry"
start
m=$(mark); cmd "playlist $T/local.mp4,$T/missing.mp4,$T/local.mp4"   # starts at the 2nd: a file that is not there
waitlog $m 'player: failed' 60 && ok "the missing entry failed" || bad "no failure: $(since $m | grep 'player:' | tail -2)"
waitlog $m 'player: failed - moving on to the next entry' 40 && ok "moved on after the message" || bad "stayed on the error"
waitlog $m 'player: play local.mp4' 40 && ok "the next entry plays" || bad "next entry not started"
stop

echo "==> 4c. the end waits for a recommendation still on its way - within a limit"
export SOFA_EXAMPLE_MEDIA="file://$T/local.mp4" SOFA_EXAMPLE_UPNEXT=2.5   # the answer takes 2.5 s
start
m=$(mark); cmd "play example:2"; waitlog $m 'mpv: first frame' 40; cmd "mpvset time-pos 88"   # ~2 s before the end
waitlog $m 'player: end ' 60
since $m | grep -q 'player: end waits for the recommendation' && ok "the end waits for it" || bad "did not wait: $(since $m | grep 'player:\|example:' | tail -3 | tr '\n' '|')"
waitlog $m 'player: end -> up next: Mandelbrot' 40 && ok "then shows it" || bad "no up-next card: $(since $m | grep 'player: end' | tail -2 | tr '\n' '|')"
# a jump collected on the card (RIGHT = +30 s, committed after 0.7 s) must not carry into the video
# OK starts right away: it begins at its start, not 30 s in
m=$(mark); cmd "key right"; cmd "key select"; waitlog $m 'mpv: first frame' 40; sleep 1.5; p=$(pos)
awk "BEGIN{exit !($p < 10)}" 2>/dev/null && ok "a jump pending on the card stays with the old video ($p s)" || bad "the next video jumped to $p s"
stop
export SOFA_EXAMPLE_UPNEXT=30   # an answer that does not come in time
start
m=$(mark); cmd "play example:2"; waitlog $m 'mpv: first frame' 40; cmd "mpvset time-pos 88"
waitlog $m 'player: end -> leaving' 80 && ok "leaves after the limit" || bad "did not leave: $(since $m | grep 'player:' | tail -2 | tr '\n' '|')"
since $m | grep -q 'player: no recommendation after 4 s' && ok "the limit ended the wait" || bad "no limit line"
stop
unset SOFA_EXAMPLE_MEDIA SOFA_EXAMPLE_UPNEXT

echo "==> 5. download -> online stream at the same position (via the info panel)"
sqlite3 "$DEVDB" "insert or replace into items (id,json) values ('$ORF','{\"id\":\"$ORF\",\"kind\":0,\"title\":\"Playtest\",\"ref\":\"$ORF\",\"source\":\"orf\"}');
  insert or replace into downloads (id,source,channel,path,state,progress,added) values ('$ORF','orf','ORF','$T/local.mp4',2,1,strftime('%s','now'));"
start
m=$(mark); cmd "play $ORF"; waitlog $m 'player: play local.mp4'
grep -q 'player: play local.mp4' "$LOG" && ok "download preferred when present" || bad "download not used"
m=$(mark); cmd "key selecthold"; waitlog $m 'info: panel for'; shot "$T/info-download.png"; keep "$T/info-download.png"
cmd "key select"   # first action of a downloaded video with one audio track: "Online abspielen"
waitlog $m 'player: play apasfiis\|player: play .*via mpv' 60
since $m | grep -q 'Download -> online' && ok "switched to online" || bad "no switch"
since $m | grep -q 'player: play apasfiis\|player: play .*via mpv' && ! since $m | grep -q 'player: play local.mp4' \
  && ok "online stream playing (not the file again)" || bad "the local file was played again"

stop

echo "==> 6. remembered subtitle preference"
# local file: German audio + German subtitles; preference "subtitles in the audio language" set
printf '1\n00:00:00,000 --> 00:01:30,000\nUntertitel\n' > "$T/de.srt"
"$FF" -hide_banner -loglevel error -y -i "$T/local.mp4" -i "$T/de.srt" -map 0 -map 1 -c copy -c:s mov_text \
      -metadata:s:a:0 language=deu -metadata:s:s:0 language=deu "$T/subs.mp4"
defaults write de.sofa.dev.$INST subtitlesSameLanguage -bool YES
start
m=$(mark); cmd "playlist $T/subs.mp4"
waitlog $m 'subtitles .*remembered language' && ok "subtitles applied automatically" \
  || bad "remembered subtitle preference not applied: $(since $m | grep -i 'subtitle\|player:' | tail -2)"
{ defaults delete de.sofa.dev.$INST; rm -f "$HOME/Library/Preferences/de.sofa.dev.$INST.plist"; } >/dev/null 2>&1
stop

echo "==> 6b. a subtitle choice stays across a reopen"
# Sofa opens with subtitles off (sid=no) and no preference is set: switched on by hand, they must
# stay on when the stream breaks and reopens
start
m=$(mark); cmd "playlist $T/subs.mp4"; waitlog $m 'mpv: first frame' 40; cmd "mpvset sid 1"; sleep 1
m=$(mark); cmd "breakstream"; waitlog $m 'mpv: first frame' 40; sleep 1; cmd "mpvprop sid"; sleep 0.5
since $m | grep -q 'player: stream failed (dev: broken on request) - reopening at' && ok "reopened" || bad "no reopen: $(since $m | grep 'player:' | tail -2 | tr '\n' '|')"
since $m | grep -q 'player: sub track .* kept across the reopen' && since $m | grep -q 'dev: mpv sid = 1' && ok "subtitles still on after the reopen" || bad "subtitles lost: $(since $m | grep 'mpv sid\|track' | tail -2 | tr '\n' '|')"
stop

echo "==> 7. stream stops delivering -> stall watchdog"
# HTTP server: serves the first 600 KB of the file, then keeps the connection open without data
cat > "$T/stall.py" <<'PY'
import http.server, sys, time, os
F = sys.argv[1]
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        size = os.path.getsize(F)
        self.send_response(200); self.send_header("Content-Length", str(size)); self.send_header("Content-Type", "video/mp4"); self.end_headers()
        with open(F, "rb") as f: self.wfile.write(f.read(600000))
        self.wfile.flush(); time.sleep(600)
http.server.ThreadingHTTPServer(("127.0.0.1", int(sys.argv[2])), H).serve_forever()
PY
# start it and wait (bounded) until it listens before the app asks: under test-all's load python
# took longer than 4 s once and the play hit "connection refused"
serve() {
  /opt/local/bin/python3.14 -I "$T/stall.py" "$1" "$2" & SRV=$!
  for i in $(seq 1 150); do nc -z 127.0.0.1 "$2" >/dev/null 2>&1 && return 0; sleep 0.1; done
  bad "stall server on port $2 not listening after 15 s"
}
serve "$T/local.mp4" 47981
start
m=$(mark); cmd "play http://127.0.0.1:47981/stall.mp4"; sleep 0.3; cmd "key play"   # Play/Pause while it loads
waitlog $m 'player: pause while loading' 20 && ok "Play/Pause while loading: starts paused" || bad "Play/Pause while loading lost: $(since $m | grep 'player:' | tail -2)"
for i in $(seq 1 60); do since $m | grep -q 'no progress for\|player: failed' && break; sleep 0.5; done
since $m | grep -q 'mpv: no progress for 6 s' && ok "stall detected (although the open is paused)" || bad "stall not detected: $(since $m | grep 'player:\|mpv:' | tail -3)"
for i in $(seq 1 80); do since $m | grep -q 'player: failed' && break; sleep 0.5; done   # incl. the reopen's own stall
since $m | grep -q 'player: failed' && ok "fallback chain ended in a readable failure" || bad "no final failure after the stall"
kill $SRV 2>/dev/null; wait $SRV 2>/dev/null
stop

echo "==> 7b. stream breaks off after playback began -> one reopen, then a message"
# the same server with a file whose index comes first: it plays a few seconds, then stops delivering
"$FF" -hide_banner -loglevel error -y -i "$T/local.mp4" -c copy -movflags +faststart "$T/fast.mp4"
serve "$T/fast.mp4" 47982
start
m=$(mark); cmd "play http://127.0.0.1:47982/fast.mp4"
for i in $(seq 1 120); do since $m | grep -q 'player: failed' && break; sleep 0.5; done   # play, stall, reopen, play, stall
since $m | grep -q 'mpv: first frame' && ok "played before breaking off" || bad "never played: $(since $m | grep 'player:\|mpv:' | tail -3 | tr '\n' '|')"
[ "$(since $m | grep -c 'player: stream failed (.*) - reopening at')" = 1 ] && ok "reopened once" || bad "reopens: $(since $m | grep -c 'reopening at') - $(since $m | grep 'player:\|mpv: no progress\|mpv: first' | tail -4 | tr '\n' '|')"
since $m | grep -q 'player: failed - the stream broke again right after reopening' && ok "then a message instead of a loop" || bad "no final message"
kill $SRV 2>/dev/null; wait $SRV 2>/dev/null
stop

fi   # part a
if want b; then
start; stop   # the instance creates its database (section 8 writes a download into it before its start)
echo "==> 8. YouTube end screen (fake data, offline)"
# thumbnails + a "downloaded" copy of the first tile's video: OK on it plays a local file, no network
"$FF" -hide_banner -loglevel error -y -f lavfi -i mandelbrot=size=640x360 -frames:v 1 "$T/es1.png"
"$FF" -hide_banner -loglevel error -y -f lavfi -i smptehdbars=size=640x360 -frames:v 1 "$T/es2.png"
"$FF" -hide_banner -loglevel error -y -f lavfi -i "cellauto=size=300x300:rule=110" -frames:v 1 "$T/esav.png"
cp "$T/local.mp4" "$T/endvid.mp4"
sqlite3 "$DEVDB" "insert or replace into items (id,json) values ('yt:esTestVid01','{\"id\":\"yt:esTestVid01\",\"kind\":0,\"title\":\"Endscreen-Testvideo\",\"ref\":\"yt:esTestVid01\",\"source\":\"youtube\"}');
  insert or replace into downloads (id,source,channel,path,state,progress,added) values ('yt:esTestVid01','youtube','Testkanal','$T/endvid.mp4',2,1,strftime('%s','now'));"
ES='[{"kind":"video","ref":"yt:esTestVid01","title":"Erstes Video","left":0.05,"top":0.2,"width":0.4,"aspectRatio":1.7778,"startMs":2000,"endMs":0,"image":"'$T'/es1.png"},'\
'{"kind":"video","ref":"yt:esTestVid02","title":"Zweites Video","left":0.55,"top":0.2,"width":0.4,"aspectRatio":1.7778,"startMs":2000,"endMs":0,"image":"'$T'/es2.png"},'\
'{"kind":"follow","ref":"ytchannel:'$ESCH'","title":"Endscreen-Testkanal","left":0.05,"top":0.7,"width":0.1,"aspectRatio":1,"startMs":2500,"endMs":0,"image":"'$T'/esav.png"}]'
export SOFA_OFFLINE=1
start
m=$(mark); cmd "playlist $T/local.mp4"; waitlog $m 'player: play local.mp4'; cmd "endscreen $ES"
waitlog $m 'endscreen: 3 tiles from 2.0 s' && ok "end screen data taken over" || bad "no end screen tiles: $(since $m | grep 'endscreen' | tail -2)"
waitlog $m 'endscreen: shown at' 60
at=$(since $m | grep 'endscreen: shown at' | head -1 | sed 's/.*shown at \([0-9.]*\) s/\1/')
awk "BEGIN{exit !($at >= 2.0 && $at < 4)}" 2>/dev/null && ok "tiles appear at the first startMs ($at s)" || bad "tiles appeared at '$at' (want 2 s)"
since $m | grep -q 'endscreen: video rect {{0, 0}, {1920, 1080}}' && ok "tiles placed over the video rect" || bad "video rect: $(since $m | grep 'video rect' | tail -1)"
sleep 1.5; shot "$T/endscreen.png"; [ -s "$T/endscreen.png" ] && { ok "end screen rendered"; keep "$T/endscreen.png"; } || bad "no end screen screenshot"
# each key waits for its focus line (under test-all's load a fixed pause was too short once)
m=$(mark); n=0
for k in down right left down; do n=$((n + 1)); cmd "key $k"; for i in $(seq 1 40); do [ "$(since $m | grep -c 'endscreen: focus')" -ge $n ] && break; sleep 0.1; done; done
since $m | grep 'endscreen: focus' | sed 's/.*focus //' | tr '\n' ' ' | grep -q '0 (video) 1 (video) 0 (video) 2 (follow)' \
  && ok "DOWN enters, arrows move spatially" || bad "focus path: $(since $m | grep 'endscreen: focus' | sed 's/.*focus //' | tr '\n' ' ')"
shot "$T/endscreen-focus.png"; keep "$T/endscreen-focus.png"
m=$(mark); cmd "key select"; sleep 0.6; cmd "key select"; sleep 0.6
since $m | grep -q 'follows: + Endscreen-Testkanal' && since $m | grep -q "follows: - ytchannel:$ESCH" && ok "follow tile follows and unfollows" || bad "follow toggle: $(since $m | grep 'follows' | tail -2)"
m=$(mark); cmd "key menu"; sleep 0.6; t1=$(pos); sleep 1.5; t2=$(pos)
since $m | grep -q 'endscreen: left the tiles' && ok "MENU leaves the tiles" || bad "MENU did not leave the tiles"
awk "BEGIN{exit !($t2 > $t1 + 0.5)}" 2>/dev/null && ok "playback goes on after leaving ($t1 -> $t2 s)" || bad "playback stopped after MENU ($t1 -> $t2)"
m=$(mark); cmd "key play"; sleep 0.8; cmd "key prev"; waitlog $m 'endscreen: hidden' && ok "seeking back before the end screen hides it (paused)" || bad "tiles stayed after seeking back"
cmd "key play"
m=$(mark); waitlog $m 'endscreen: shown at' 60; cmd "key down"; sleep 0.4; cmd "key select"
waitlog $m 'player: play endvid.mp4' && ok "OK on a video tile plays it" || bad "video tile did not play: $(since $m | grep 'endscreen\|player:' | tail -2)"
m=$(mark); cmd "playlist $T/local.mp4"; waitlog $m 'player: play local.mp4'; cmd "endscreen $ES"; waitlog $m 'endscreen: 3 tiles' 
cmd "mpvset time-pos 85"   # ~5 s before the end
# DOWN only once the jump has landed: the tiles stay up from 2 s to the end, so under load (the
# video past 2 s before the jump) no new "shown at" line comes - DOWN went in at 2 s and the end
# came 85 s later
# DOWN only once the tiles are on screen: a DOWN before them is a volume step, and DOWN right after
# one keeps stepping the volume (by design) - the tiles never got focus. Either they come up near
# the end ("shown at 8x"), or they are still up since 2 s (shown, not hidden since)
for i in $(seq 1 60); do
  since $m | grep -q 'endscreen: shown at 8[0-9]' && break
  [ "$(since $m | grep -E 'endscreen: (shown at|hidden)' | tail -1 | grep -c 'shown at')" = 1 ] && p=$(pos) && awk "BEGIN{exit !(${p:-0} >= 84)}" 2>/dev/null && break
  sleep 0.25
done
cmd "key down"
waitlog $m 'ended while in the end screen' 80 && ok "the end waits while the tiles have focus" || bad "end did not wait: $(since $m | grep 'player:\|endscreen' | tail -2)"
sleep 1.5; since $m | grep -q 'player: end ->' && bad "end flow ran while the tiles had focus" || ok "no up-next/leave under the tiles"
m2=$(mark); cmd "key menu"; waitlog $m2 'player: end -> leaving' 12 && ok "leaving the tiles finishes the end" || bad "end flow did not run after MENU"
stop
unset SOFA_OFFLINE

fi   # part b
if want a; then   # (balances the parts: 8c and 8b run after 7)
echo "==> 8c. a phone queue: watch pages only for the playing and the next video"
# 2026-11-06: a 100-video playlist from the phone fetched 100 watch pages within a minute (three
# bursts, bot checks 50 min later). Offline: the requests fail, the log line counts the attempts.
export SOFA_OFFLINE=1
start
Q=""; for i in $(seq 10 29); do Q="$Q${Q:+,}queueVid0$i"; done   # 20 well-formed (11 char) video ids
m=$(mark); cmd "lounge setPlaylist {\"videoIds\":\"$Q\",\"currentIndex\":\"0\"}"
waitlog $m 'youtube: details of queueVid011' 20; sleep 2
asked=$(since $m | grep -o 'youtube: details of [A-Za-z0-9_-]*' | sed 's/.* //' | sort -u | tr '\n' ' ')
[ "$asked" = "queueVid010 queueVid011 " ] && ok "only the playing and the next video asked ($asked)" || bad "watch pages asked: $asked"
stop
unset SOFA_OFFLINE

echo "==> 8b. session stream that keeps breaking: one reopen, then a message"
export SOFA_EXAMPLE_SESSION=1 SOFA_EXAMPLE_MEDIA=http://127.0.0.1:1/gone.webm
start
m=$(mark); cmd "play example:3"; waitlog $m 'the stream broke again' 60   # not downloaded (section 5 has example:1)
n=$(since $m | grep -c 'example: session failed')
[ "$n" = 1 ] && ok "reopened once" || bad "reopens: $n"
since $m | grep -q 'the stream broke again right after reopening' && ok "then a message instead of a loop" || bad "no final message: $(since $m | grep 'player:\|example:' | tail -3)"
sleep 2; [ "$(since $m | grep -c 'example: session failed')" = 1 ] && ok "no further reopen" || bad "kept reopening"
stop
unset SOFA_EXAMPLE_SESSION SOFA_EXAMPLE_MEDIA

echo "==> 8d. resumed DASH start reads nothing at the start of the tracks"
# Like YouTube's engine: separate WebM tracks with their index (Cues) up front, served by range; the
# media at 0 of the audio track arrives only after 8 s (the engine has to fetch it first - a resumed
# start never needs it). mpv's reference probes peeked 8 KiB, past the Opus header, and waited
# (mpv CLI against this server: 8.5 s with access-references, 0.5 s without).
"$FF" -hide_banner -loglevel error -y -f lavfi -i testsrc=size=320x180:rate=10 -t 60 -c:v libvpx-vp9 -deadline realtime -cpu-used 8 \
      -an -f webm -dash 1 -cues_to_front 1 "$T/dash-v.webm" &&
"$FF" -hide_banner -loglevel error -y -f lavfi -i sine=frequency=440 -t 60 -c:a libopus -vn -f webm -dash 1 -cues_to_front 1 "$T/dash-a.webm" ||
  bad "could not make the DASH tracks"
cat > "$T/dash.py" <<'PY'
import http.server, sys, time, os, re
D, LATE = sys.argv[1], 8
class H(http.server.BaseHTTPRequestHandler):
    def log_message(self, *a): pass
    def do_GET(self):
        p = os.path.join(D, os.path.basename(self.path)); data = open(p, "rb").read()
        first = data.find(b"\x1f\x43\xb6\x75")   # first Cluster: the media at 0
        m = re.match(r"bytes=(\d+)-(\d*)", self.headers.get("Range", "")); a = int(m.group(1)) if m else 0
        b = min(int(m.group(2)) + 1 if m and m.group(2) else len(data), len(data))
        print(f"{os.path.basename(p)} {a}-{b} first-cluster {first}", flush=True)
        audio = os.path.basename(p).startswith("dash-a.")
        self.send_response(206 if m else 200); self.send_header("Content-Type", "audio/webm" if audio else "video/webm")
        self.send_header("Content-Length", str(b - a)); self.send_header("Content-Range", f"bytes {a}-{b - 1}/{len(data)}"); self.end_headers()
        try:
            if audio and a <= first + 4 < b:   # the media at 0 is not there yet - its Cluster ID is (the engine knows it)
                self.wfile.write(data[a:first + 4]); self.wfile.flush(); time.sleep(LATE); a = first + 4
            self.wfile.write(data[a:b])
        except (BrokenPipeError, ConnectionResetError): pass
http.server.ThreadingHTTPServer(("127.0.0.1", int(sys.argv[2])), H).serve_forever()
PY
/opt/local/bin/python3.14 -I "$T/dash.py" "$T" 47983 > "$T/dash.log" 2>&1 & SRV=$!
for i in $(seq 1 150); do nc -z 127.0.0.1 47983 >/dev/null 2>&1 && break; sleep 0.1; done
export SOFA_EXAMPLE_MEDIA=http://127.0.0.1:47983/dash-v.webm SOFA_EXAMPLE_AUDIO=http://127.0.0.1:47983/dash-a.webm
start
t0=$(date +%s); m=$(mark); cmd "play example:2 at 30"; waitlog $m 'mpv: first frame' 60; t1=$(date +%s)
since $m | grep -q 'mpv: first frame' && [ $((t1 - t0)) -lt 6 ] && ok "first frame after $((t1 - t0)) s (the late start of the audio was not waited for)" ||
  bad "first frame after $((t1 - t0)) s: $(grep 'dash-a' "$T/dash.log" | head -4 | tr '\n' '|')"
stop
kill $SRV 2>/dev/null; wait $SRV 2>/dev/null
unset SOFA_EXAMPLE_MEDIA SOFA_EXAMPLE_AUDIO

fi   # part a (8c, 8b, 8d)
if want b; then
if [ -n "${SOFA_YT_LIVE:-}" ]; then
  echo "==> 9. SABR playback through the engine (Firefox) + the browser dies"
  start
  m=$(mark); cmd "play yt:OzCYsIrrRyw"
  for i in $(seq 1 240); do since $m | grep -q 'yt-engine: opened OzCYsIrrRyw\|yt-engine: open OzCYsIrrRyw failed' && break; sleep 0.5; done
  since $m | grep -q 'yt-engine: opened OzCYsIrrRyw' && ok "opened via the engine" || bad "not via the engine: $(since $m | grep 'yt-engine\|yt-browser\|yt:' | tail -3)"
  sleep 6; cmd "mpvprop vo-configured"; sleep 1
  since $m | grep -q 'mpv vo-configured = yes' && ok "video output configured" || bad "no video"
  m=$(mark); pkill -f "firefox.*--profile $SOFA_DATA_DIR/"
  for i in $(seq 1 240); do since $m | grep -q 'yt-engine: opened OzCYsIrrRyw' && break; sleep 0.5; done
  since $m | grep -q 'SABR stream failed (.*) -> reopening via SABR' && ok "browser exit noticed" || bad "exit not noticed: $(since $m | grep 'yt-engine\|yt-browser\|player:' | tail -3)"
  since $m | grep -q 'yt-engine: opened OzCYsIrrRyw' && ok "reopened after the browser restart" || bad "not reopened"
  # the restarted browser keeps one engine: the extension is unchanged across starts (same channel
  # port and token) - a changed one was re-injected into the loaded page, "page reloaded" at every start
  ! since $m | grep -q 'yt-engine: page reloaded' && ok "one engine page after the restart" || bad "engine page replaced: $(since $m | grep 'page reloaded' | tail -1)"
  sleep 6
  a=$(pos); sleep 3; b=$(pos)
  awk "BEGIN{exit !($b > $a + 1)}" 2>/dev/null && ok "playing again after the restart ($a -> $b s)" || bad "not playing after the restart ($a -> $b)"
  # no browser outlives Sofa: quit ends it (SFApp stop), a crash too (SFYTBrowser's watcher: its
  # pipe from Sofa closes) - 2026-11-07: browsers outlived every test run
  browser() { pgrep -f "firefox --no-remote --profile $SOFA_DATA_DIR/" >/dev/null; }
  stop
  for i in $(seq 1 20); do browser || break; sleep 0.5; done
  browser && bad "browser still running after quit" || ok "quit ends the browser"
  start
  m=$(mark); cmd "play yt:OzCYsIrrRyw"
  for i in $(seq 1 240); do since $m | grep -q 'yt-engine: opened OzCYsIrrRyw\|yt-engine: open OzCYsIrrRyw failed' && break; sleep 0.5; done
  kill -9 $APP; wait $APP 2>/dev/null; APP=
  for i in $(seq 1 20); do browser || break; sleep 0.5; done
  browser && { bad "browser still running after Sofa crashed"; pkill -9 -f "firefox --no-remote --profile $SOFA_DATA_DIR/"; } || ok "a crash of Sofa ends the browser"
fi

if [ -n "${SOFA_YT_LIVE_STREAM:-}" ]; then
  L=$SOFA_YT_LIVE_STREAM
  echo "==> 10. YouTube live via the engine (HLS)"
  start
  m=$(mark); cmd "play ytlive:$L"
  for i in $(seq 1 60); do since $m | grep -q "yt-engine: opened $L\|yt-engine: open $L failed\|resolve failed" && break; sleep 0.5; done
  since $m | grep -q "yt-engine: opened $L -> live HLS" && ok "opened via the engine: $(since $m | grep "yt-engine: opened $L" | tail -1 | sed 's/.*-> //')" \
    || bad "not via the engine: $(since $m | grep 'yt-engine\|yt:\|player:' | tail -3)"
  sleep 6
  cmd "mpvprop vo-configured"; sleep 1
  since $m | grep -q 'mpv vo-configured = yes' && ok "video output configured" || bad "no video"
  a=$(pos); sleep 4; b=$(pos)
  awk "BEGIN{exit !($b > $a + 1)}" 2>/dev/null && ok "live is playing ($a -> $b s)" || bad "live not playing ($a -> $b)"
  stop
fi

fi   # part b
[ $fail = 0 ] && echo "==> all ok" || echo "==> FAILED"
exit $fail

#!/bin/bash
# test-release [Sofa.app] -- prüft ein Release-Bundle wie auf einem Mac OHNE MacPorts:
# alles läuft unter sandbox-exec mit verbotenem Lesezugriff auf /opt/local.
#   Bundle-Abhängigkeiten, ffmpeg/node/rsvg-convert, Python + TLS, venv + pip (yt-dlp),
#   PO-Token-Server (eigener Port), YouTube-Auflösung mit node für die JS-Challenge.
# Braucht Internet. Fasst nichts außerhalb eines Temp-Ordners an.
set -u
unset DYLD_INSERT_LIBRARIES
SRC="$(cd "$(dirname "$0")/.." && pwd)"
APP="${1:-$SRC/dist/Sofa.app}"
RT="$APP/Contents/Runtime"
T="$(mktemp -d "${TMPDIR:-/tmp}/sofa-test.XXXXXX")"
POT_PORT=4419
fail=0
ok()  { echo "  ok    $*"; }
bad() { echo "  FAIL  $*"; fail=1; }
cleanup() { [ -n "${POT:-}" ] && { kill "$POT" 2>/dev/null; wait "$POT" 2>/dev/null; }; rm -rf "$T"; }
trap cleanup EXIT

printf '(version 1)\n(allow default)\n(deny file-read* (subpath "/opt/local"))\n' > "$T/nomp.sb"
np() { sandbox-exec -f "$T/nomp.sb" "$@"; }
# dieselbe Umgebung, die SFRuntimeSetup() setzt
export PATH="$RT/bin:/usr/bin:/bin:/usr/sbin:/sbin" SOFA_NODE="$RT/bin/node" \
       SSL_CERT_FILE="$RT/etc/cert.pem" NODE_EXTRA_CA_CERTS="$RT/etc/cert.pem" \
       FONTCONFIG_FILE="$RT/etc/fonts/fonts.conf" FONTCONFIG_PATH="$RT/etc/fonts" \
       GIO_MODULE_DIR="$RT/lib/gio/modules" GDK_PIXBUF_MODULE_FILE="$RT/etc/gdk-pixbuf-loaders.cache" \
       OPENSSL_CONF="$RT/etc/openssl.cnf"

echo "==> $APP"
np /bin/ls /opt/local >/dev/null 2>&1 && { echo "Sandbox wirkt nicht"; exit 1; }
/opt/local/bin/python3.14 -I "$SRC/tools/relink.py" --check "$APP" >/dev/null && ok "Abhängigkeiten nur System + Bundle" || bad "relink --check"

np "$RT/bin/ffmpeg" -hide_banner -version >/dev/null 2>&1 && ok ffmpeg || bad ffmpeg
np "$RT/bin/node" -e 'process.exit(0)' && ok node || bad node
echo '<svg xmlns="http://www.w3.org/2000/svg" width="40" height="20"><text x="0" y="15">ARD</text></svg>' > "$T/t.svg"
np "$RT/bin/rsvg-convert" -o "$T/t.png" "$T/t.svg" 2>/dev/null && [ -s "$T/t.png" ] && ok rsvg-convert || bad rsvg-convert

PY="$RT/Python.framework/Versions/3.14/bin/python3.14"
np "$PY" -c 'import ssl, sqlite3, lzma, ctypes, urllib.request as u; u.urlopen("https://www.youtube.com", timeout=20)' \
  && ok "python + TLS" || bad "python + TLS"
if np "$PY" -m venv "$T/venv" && np "$T/venv/bin/python" -m pip install -q --disable-pip-version-check \
     yt-dlp yt-dlp-ejs bgutil-ytdlp-pot-provider >/dev/null 2>&1; then ok "venv + pip (yt-dlp)"; else bad "venv + pip"; fi

(cd "$RT/bgutil" && exec sandbox-exec -f "$T/nomp.sb" "$RT/bin/node" build/main.js --host 127.0.0.1 --port $POT_PORT >"$T/pot.log" 2>&1) &
POT=$!
for i in $(seq 1 30); do curl -sf "127.0.0.1:$POT_PORT/ping" >/dev/null && break; sleep 1; done
if curl -sf -X POST "127.0.0.1:$POT_PORT/get_pot" -H 'Content-Type: application/json' \
     -d '{"content_binding":"jNQXAC9IVRw"}' | /usr/bin/grep -q poToken; then ok "PO-Token-Server"; else bad "PO-Token-Server ($(tail -1 "$T/pot.log"))"; fi

F=$(np "$T/venv/bin/yt-dlp" --no-warnings --js-runtimes "node:$RT/bin/node" \
      --extractor-args "youtube:player_client=web_embedded;youtubepot-bgutilhttp:base_url=http://127.0.0.1:$POT_PORT" \
      -f 'best[vcodec^=avc1][acodec!=none]/18' --print format_id 'https://www.youtube.com/watch?v=jNQXAC9IVRw' 2>&1 | tail -1)
[[ "$F" =~ ^[0-9]+$ ]] && ok "YouTube-Auflösung (Format $F)" || bad "YouTube-Auflösung: $F"

[ $fail = 0 ] && echo "==> alles ok" || echo "==> FEHLER"
exit $fail

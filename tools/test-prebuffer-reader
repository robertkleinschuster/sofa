#!/bin/bash
# Local-only demux test; does not start Sofa or any provider/pipeline.
set -eu
cd "$(dirname "$0")/.."
TEST_DIR=$(mktemp -d /private/tmp/sofa-prebuffer-reader.XXXXXX)
trap 'rm -rf "$TEST_DIR"' EXIT
/opt/local/bin/ffmpeg -hide_banner -loglevel error -y -f lavfi -i testsrc=size=320x180:rate=10 -f lavfi -i sine=frequency=440 -t 180 -c:v libx264 -preset ultrafast -c:a aac -movflags +faststart "$TEST_DIR/fixture.mp4"
/opt/local/bin/clang-mp-22 -fobjc-arc -mmacosx-version-min=10.9 -I/opt/local/include -Isrc/Core -Isrc/Framework -Isrc/Library -c src/Library/SFPrebufferReader.m -o "$TEST_DIR/reader.o"
/opt/local/bin/clang-mp-22 -fobjc-arc -mmacosx-version-min=10.9 -Isrc/Library -c tests/prebuffer-reader.m -o "$TEST_DIR/test.o"
/opt/local/bin/clang-mp-22 -fobjc-arc -mmacosx-version-min=10.9 -Isrc/Core -c src/Core/SFHTTPBudget.m -o "$TEST_DIR/budget.o"
/opt/local/bin/clang-mp-22 -mmacosx-version-min=10.9 "$TEST_DIR/reader.o" "$TEST_DIR/budget.o" "$TEST_DIR/test.o" -L/opt/local/lib -lmpv -framework Foundation -o "$TEST_DIR/check"
"$TEST_DIR/check" "$TEST_DIR/fixture.mp4"

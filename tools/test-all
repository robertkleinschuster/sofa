#!/bin/bash
# test-all -- every offline/dev regression suite; make-release refuses to build when one fails.
# Each suite runs in its own invisible dev instance with its own fresh data directory
# (SOFA_DATA_DIR, docs/architecture.md "Dev instances") and never touches the real app or its
# data, and makes no network request - so the suites run side by side (~50 s). --serial: one after another.
#   tools/check-arch      layer rules of docs/architecture.md (static)
#   tools/test-units      pure core functions (tests/units, no app instance)
#   tools/test-parse   every app's parser against recorded real answers
#   tools/test-playback   render-context race, video self-heal, failure message, end screen, download -> online
#   tools/test-downloads  orphaned ffmpeg, verifier, quit during a download
#   tools/test-home       mixed Home rows: only what plays here (drm, region), stored rows
#   tools/test-schema     database migrations from a 0.3.8 database, integrity, nothing lost
#   tools/test-startup    one instance per data directory
#   tools/test-sofa-yt    YouTube engine: index/virtual files/pacing/eviction, mpv via fake SABR, bundle in Firefox (offline)
set -u
DIR="$(cd "$(dirname "$0")" && pwd)"
SUITES="check-arch test-units test-parse test-playback test-downloads test-home test-schema test-startup test-sofa-yt"
OUT="$(mktemp -d "${TMPDIR:-/tmp}/sofa-testall.XXXXXX")"
trap 'rm -rf "$OUT"' EXIT
# what a failed suite leaves for diagnosis (its instance's log, screenshots) survives the run here;
# a flake under parallel load is then readable afterwards instead of gone with its temp directory
KEPT="${TMPDIR:-/tmp}/sofa-testall-failed"
mkdir -p "$OUT/kept/test-playback"; export PLAYTEST_SHOTS="$OUT/kept/test-playback"
serial=0; [ "${1:-}" = "--serial" ] && serial=1

# build once: the suites' own make is then a no-op (parallel makes in one tree would race)
make -C "$DIR/.." >"$OUT/make.log" 2>&1 || { echo "  FAIL  make"; tail -n 25 "$OUT/make.log" | sed 's/^/        /'; exit 1; }

run() {   # run SUITE: output + exit code + seconds into $OUT
  local s=$(date +%s)
  "$DIR/$1" >"$OUT/$1.log" 2>&1; echo $? >"$OUT/$1.rc"
  echo $(( $(date +%s) - s )) >"$OUT/$1.sec"
}
t0=$(date +%s)
for t in $SUITES; do
  if [ $serial = 1 ]; then run $t; else run $t & fi
done
wait

fail=0
for t in $SUITES; do
  if [ "$(cat "$OUT/$t.rc")" = 0 ]; then printf "  ok    %-15s %4ss\n" $t "$(cat "$OUT/$t.sec")"
  else printf "  FAIL  %-15s %4ss\n" $t "$(cat "$OUT/$t.sec")"
    # the failing checks by name (shell suites: "FAIL ...", node: "not ok ..."), then the tail
    grep -E '^ *(FAIL|not ok) ' "$OUT/$t.log" | head -n 10 | sed 's/^ */        > /'
    tail -n 25 "$OUT/$t.log" | sed 's/^/        /'; fail=1; fi
done
if [ $fail = 0 ]; then rm -rf "${KEPT:?}"; echo "==> all suites ok ($(( $(date +%s) - t0 ))s)"   # an older failure's logs would mislead
else rm -rf "${KEPT:?}"; mv "$OUT/kept" "$KEPT"; echo "==> SOME SUITES FAILED (kept logs: $KEPT)"; fi
exit $fail

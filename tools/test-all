#!/bin/bash
# test-all -- every offline/dev regression suite; make-release refuses to build when one fails.
# Each suite runs in its own invisible dev instance and never touches the real app or its data.
#   tools/test-resolver   resolver selection logic (fixtures, no network)
#   tools/test-playback   render-context race, video self-heal, fallback chain, download -> online
#   tools/test-downloads  orphaned ffmpeg, verifier, quit during a download
set -u
DIR="$(cd "$(dirname "$0")" && pwd)"
OUT="$(mktemp "${TMPDIR:-/tmp}/sofa-testall.XXXXXX")"
trap 'rm -f "$OUT"' EXIT
fail=0
for t in test-resolver test-playback test-downloads; do
  if "$DIR/$t" > "$OUT" 2>&1; then echo "  ok    $t"
  else echo "  FAIL  $t"; tail -n 25 "$OUT" | sed 's/^/        /'; fail=1; fi
done
[ $fail = 0 ] && echo "==> all suites ok" || echo "==> SOME SUITES FAILED"
exit $fail
